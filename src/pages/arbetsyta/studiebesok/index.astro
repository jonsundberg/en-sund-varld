---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { STUDIEBESOK_SENAST_ANDRAD, formatDatumSvenska } from '../../../data/arbetsyta-metadata';

const metadata = {
  titel: 'Frågor att ta med vid studiebesök',
  datum: STUDIEBESOK_SENAST_ANDRAD,
  status: 'aktiv',
};

const sektioner = [
  {
    id: 'agande',
    titel: 'Ägande och trygghet',
    fragor: [
      'Vem äger marken och husen?',
      'Vad händer om någon vill sälja, flytta eller lämna gemenskapen?',
      'Hur skyddas både individen och helheten?',
      'Går rätten till ens hus att ärva eller överlåta? Hur har ni skrivit avtalen?',
    ],
  },
  {
    id: 'ekonomi',
    titel: 'Ekonomi',
    fragor: [
      'Vad kostade det att komma igång?',
      'Hur finansieras drift, underhåll och gemensamma investeringar?',
      'Vilka kostnader underskattade ni?',
      'Räknar ni arbetsinsats på något sätt, till exempel med en timbank?',
    ],
  },
  {
    id: 'organisation',
    titel: 'Organisation och beslut',
    fragor: [
      'Hur fattas beslut?',
      'Hur hanteras oenighet?',
      'Hur säkerställs att alla blir hörda utan att besluten tar orimligt lång tid?',
    ],
  },
  {
    id: 'medlemskap',
    titel: 'Medlemskap och ansvar',
    fragor: [
      'Hur välkomnar ni nya människor?',
      'Vilka krav ställs på kapital, arbetsinsats och deltagande?',
      'Vad händer när någon inte kan bidra som planerat?',
      'Tar ni emot volontärer, och hur fungerar det?',
    ],
  },
  {
    id: 'gemenskap',
    titel: 'Gemenskap och privatliv',
    fragor: [
      'Vad fungerar bra i vardagen?',
      'Vilka gränser har ni behövt sätta mellan det privata och det gemensamma?',
    ],
  },
  {
    id: 'utveckling',
    titel: 'Utveckling',
    fragor: [
      'Vad behövde finnas från början? Vad hade ni kunnat vänta med?',
      'Började ni i en befintlig byggnad, eller byggde ni nytt direkt?',
      'Hur har ni löst bygglov och kommunkontakter?',
      'Vilka misstag har lärt er mest?',
    ],
  },
  {
    id: 'lardomar',
    titel: 'Lärdomar',
    fragor: [
      'Om ni skulle börja om i dag, vad skulle ni göra annorlunda?',
    ],
  },
  {
    id: 'avslutning',
    titel: 'Avslutande fråga',
    fragor: [
      'Vilket råd skulle ni ge en grupp som vår innan vi köper vår första fastighet?',
    ],
  },
];

function fragorTillText(avsnitt: { titel: string; fragor: string[] }[]): string {
  return avsnitt
    .map((sektion) => {
      const numbered = sektion.fragor
        .map((fraga, index) => `${index + 1}. ${fraga}`)
        .join('\n');
      return `${sektion.titel}\n${numbered}`;
    })
    .join('\n\n');
}

const fragorText = fragorTillText(sektioner);
---

<BaseLayout
  title="Frågor vid studiebesök – Styrelsens arbetsyta"
  description="Frågor att ta med vid studiebesök hos befintliga gemenskaper."
>
  <article class="arbetsyta-doc container">
    <header class="doc-header">
      <p class="breadcrumb">
        <a href="/arbetsyta/">Arbetsyta</a> / Studiebesök
      </p>
      <div class="doc-meta">
        <span class="doc-status doc-status--aktiv">Aktiv</span>
        <span class="doc-date">Uppdaterad {formatDatumSvenska(metadata.datum)}</span>
      </div>
      <h1>{metadata.titel}</h1>
      <p class="doc-lead">
        Sammanställt av Anders, med några följdfrågor tillagda.
      </p>
    </header>

    <div class="fragor-export">
      <button type="button" class="btn btn-outline" data-copy-fragor>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
        </svg>
        <span data-copy-label>Kopiera frågorna som text</span>
      </button>
      <p class="visually-hidden" aria-live="polite" data-copy-status></p>

      <details class="fragor-text-fallback">
        <summary>Visa som text</summary>
        <label class="visually-hidden" for="fragor-text">Frågorna som vanlig text, redo att kopiera</label>
        <textarea id="fragor-text" readonly rows="18" spellcheck="false">{fragorText}</textarea>
      </details>
    </div>

    <nav class="toc" aria-label="Frågeområden">
      <p class="toc-heading" id="innehall">Områden</p>
      <ul>
        {sektioner.map((sektion) => (
          <li>
            <a href={`#${sektion.id}`}>{sektion.titel}</a>
          </li>
        ))}
      </ul>
    </nav>

    {sektioner.map((sektion) => (
      <section class="doc-section" aria-labelledby={sektion.id}>
        <h2 id={sektion.id}>{sektion.titel}</h2>
        <ul class="fragor-list">
          {sektion.fragor.map((fraga) => (
            <li>
              <span class="fraga-mark" aria-hidden="true"></span>
              <span>{fraga}</span>
            </li>
          ))}
        </ul>
      </section>
    ))}

    <nav class="doc-nav" aria-label="Navigering arbetsyta">
      <a href="/arbetsyta/" class="btn btn-outline">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M19 12H5M12 19l-7-7 7-7"/>
        </svg>
        Tillbaka till arbetsytan
      </a>
    </nav>
  </article>
</BaseLayout>

<style>
  .arbetsyta-doc {
    padding-block: var(--space-xl) var(--space-2xl);
    max-width: var(--max-width-prose);
  }

  .doc-header {
    margin-bottom: var(--space-lg);
    padding-bottom: var(--space-lg);
    border-bottom: 2px solid var(--border);
  }

  .breadcrumb {
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin-bottom: var(--space-sm);
  }

  .breadcrumb a {
    color: var(--text-muted);
  }

  .doc-meta {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-sm);
    flex-wrap: wrap;
  }

  .doc-status {
    display: inline-block;
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    text-transform: uppercase;
  }

  .doc-status--aktiv {
    background: var(--accent-light);
    color: var(--deep-forest);
    border: 1px solid var(--accent-mid);
  }

  .doc-date {
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  h1 {
    font-size: var(--text-4xl);
    margin-bottom: var(--space-sm);
  }

  .doc-lead {
    font-size: var(--text-lg);
    color: var(--text-muted);
    line-height: 1.6;
  }

  .fragor-export {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
    margin-bottom: var(--space-xl);
  }

  .fragor-export .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .fragor-text-fallback {
    width: 100%;
  }

  .fragor-text-fallback summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--deep-forest);
    padding: 0.45rem 0.15rem;
    min-height: 2.75rem;
    line-height: 1.4;
    border-radius: var(--radius-sm);
  }

  .fragor-text-fallback summary:hover {
    text-decoration: underline;
  }

  .fragor-text-fallback summary:focus-visible {
    outline: 2px solid var(--deep-forest);
    outline-offset: 2px;
  }

  .fragor-text-fallback textarea {
    display: block;
    width: 100%;
    margin-top: var(--space-sm);
    padding: var(--space-sm);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg-white);
    color: var(--text);
    font-family: var(--font-base);
    font-size: var(--text-base);
    line-height: 1.55;
    resize: vertical;
    min-height: 12rem;
  }

  .fragor-text-fallback textarea:focus-visible {
    outline: 2px solid var(--deep-forest);
    outline-offset: 2px;
  }

  .toc {
    background: var(--linen-cream);
    border-radius: var(--radius-lg);
    padding: var(--space-md);
    margin-bottom: var(--space-xl);
  }

  .toc-heading {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin: 0 0 var(--space-sm);
  }

  .toc ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .toc a {
    display: flex;
    align-items: center;
    padding: 0.45rem 0.15rem;
    color: var(--deep-forest);
    font-weight: 600;
    text-decoration: none;
    border-radius: var(--radius-sm);
    min-height: 2.75rem;
  }

  .toc a:hover {
    color: var(--accent-hover);
    text-decoration: underline;
  }

  .toc a:focus-visible {
    outline: 2px solid var(--deep-forest);
    outline-offset: 2px;
  }

  .doc-section {
    margin-bottom: var(--space-xl);
    scroll-margin-top: calc(var(--header-height) + var(--space-sm));
  }

  .doc-section h2 {
    font-size: var(--text-2xl);
    color: var(--accent);
    margin-bottom: var(--space-sm);
  }

  .fragor-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .fragor-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: var(--space-sm);
    background: var(--bg-white);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    color: var(--text);
    line-height: 1.55;
    font-size: var(--text-base);
  }

  .fraga-mark {
    flex-shrink: 0;
    width: 0.4rem;
    height: 0.4rem;
    margin-top: 0.55rem;
    border-radius: 50%;
    background: var(--coral);
  }

  .doc-nav {
    margin-top: var(--space-xl);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--border);
  }

  .doc-nav .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  @media (max-width: 600px) {
    h1 {
      font-size: var(--text-3xl);
    }

    .arbetsyta-doc {
      padding-block: var(--space-lg) var(--space-xl);
    }

    .fragor-list li {
      font-size: 1.0625rem;
    }
  }
</style>

<script>
  const copyButton = document.querySelector<HTMLButtonElement>('[data-copy-fragor]');
  const copyLabel = document.querySelector<HTMLElement>('[data-copy-label]');
  const status = document.querySelector<HTMLElement>('[data-copy-status]');
  const textarea = document.querySelector<HTMLTextAreaElement>('#fragor-text');
  const fallback = document.querySelector<HTMLDetailsElement>('.fragor-text-fallback');

  if (copyButton && copyLabel && textarea) {
    const originalLabel = copyLabel.textContent ?? 'Kopiera frågorna som text';
    let resetTimer: number | undefined;

    function visaBekraftelse() {
      copyLabel!.textContent = 'Kopierat!';
      if (status) status.textContent = 'Kopierat!';
      window.clearTimeout(resetTimer);
      resetTimer = window.setTimeout(() => {
        copyLabel!.textContent = originalLabel;
        if (status) status.textContent = '';
      }, 2000);
    }

    function visaFallback() {
      if (fallback) fallback.open = true;
      textarea!.focus();
      textarea!.select();
      textarea!.scrollIntoView({ block: 'nearest' });
      if (status) {
        status.textContent = 'Kopiera texten i rutan Visa som text.';
      }
    }

    async function kopieraTillUrklipp(text: string): Promise<boolean> {
      if (!navigator.clipboard?.writeText) return false;

      try {
        await Promise.race([
          navigator.clipboard.writeText(text),
          new Promise<never>((_, reject) => {
            window.setTimeout(() => reject(new Error('timeout')), 1500);
          }),
        ]);
        return true;
      } catch {
        return false;
      }
    }

    copyButton.addEventListener('click', async () => {
      const copied = await kopieraTillUrklipp(textarea.value);
      if (copied) {
        visaBekraftelse();
      } else {
        visaFallback();
      }
    });

    textarea.addEventListener('focus', () => {
      textarea.select();
    });
  }
</script>

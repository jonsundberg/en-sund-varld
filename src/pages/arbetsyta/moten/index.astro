---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { MOTEN_SENAST_ANDRAD, formatDatumSvenska } from '../../../data/arbetsyta-metadata';

interface Mote {
  datum: string;
  href: string;
  sammanfattning: string;
}

const moten: Mote[] = [
  {
    datum: '2026-09-20',
    href: '/arbetsyta/moten/2026-09-20',
    sammanfattning: 'Hjälpa Olle tillsammans, hemläxa stadgar, kolla föreningskrav, besöka Ängsgärdet, samla intressanta platser, live-träff 27 sep hos Jon.',
  },
];

const metadata = {
  titel: 'Mötesanteckningar',
  datum: MOTEN_SENAST_ANDRAD,
  status: 'aktiv',
};
---

<BaseLayout
  title="Mötesanteckningar – Styrelsens arbetsyta"
  description="Anteckningar från styrelsens veckomöten. Vad vi pratat om och vad vi ska göra."
>
  <article class="arbetsyta-doc container">
    <header class="doc-header">
      <p class="breadcrumb">
        <a href="/arbetsyta/">Arbetsyta</a> / Mötesanteckningar
      </p>
      <div class="doc-meta">
        <span class="doc-status doc-status--aktiv">Aktiv</span>
        <span class="doc-date">Uppdaterad {formatDatumSvenska(metadata.datum)}</span>
      </div>
      <h1>{metadata.titel}</h1>
      <p class="doc-lead">
        Här samlar vi punkter från styrelsens veckomöten – vad vi pratat om, 
        vad vi kommit fram till och vad som ska göras till nästa gång.
      </p>
    </header>

    <section class="doc-section" aria-labelledby="moten-lista">
      <h2 id="moten-lista">Möten</h2>
      <ul class="moten-list" role="list">
        {moten.map((mote) => (
          <li class="mote-card">
            <a href={mote.href} class="mote-link">
              <span class="mote-datum">{formatDatumSvenska(mote.datum)}</span>
              <p class="mote-sammanfattning">{mote.sammanfattning}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <nav class="doc-nav" aria-label="Navigering arbetsyta">
      <a href="/arbetsyta/" class="btn btn-outline">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M19 12H5M12 19l-7-7 7-7"/>
        </svg>
        Tillbaka till arbetsytan
      </a>
    </nav>
  </article>
</BaseLayout>

<style>
  .arbetsyta-doc {
    padding-block: var(--space-xl) var(--space-2xl);
    max-width: var(--max-width-prose);
  }

  .doc-header {
    margin-bottom: var(--space-xl);
    padding-bottom: var(--space-lg);
    border-bottom: 2px solid var(--border);
  }

  .breadcrumb {
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin-bottom: var(--space-sm);
  }

  .breadcrumb a {
    color: var(--text-muted);
  }

  .doc-meta {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-sm);
  }

  .doc-status {
    display: inline-block;
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    text-transform: uppercase;
  }

  .doc-status--aktiv {
    background: var(--accent-light);
    color: var(--deep-forest);
    border: 1px solid var(--accent-mid);
  }

  .doc-date {
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  h1 {
    font-size: var(--text-4xl);
    margin-bottom: var(--space-sm);
  }

  .doc-lead {
    font-size: var(--text-lg);
    color: var(--text-muted);
    line-height: 1.6;
  }

  .doc-section {
    margin-bottom: var(--space-xl);
  }

  .doc-section h2 {
    font-size: var(--text-2xl);
    color: var(--accent);
    margin-bottom: var(--space-md);
  }

  .moten-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .mote-card {
    background: var(--bg-white);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    transition: border-color var(--transition), box-shadow var(--transition);
  }

  .mote-card:hover {
    border-color: var(--accent);
    box-shadow: var(--shadow-md);
  }

  .mote-link {
    display: block;
    padding: var(--space-md);
    text-decoration: none;
    color: inherit;
  }

  .mote-link:hover {
    color: inherit;
  }

  .mote-datum {
    display: block;
    font-size: var(--text-lg);
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--deep-forest);
    margin-bottom: var(--space-xs);
  }

  .mote-sammanfattning {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--text-muted);
    line-height: 1.5;
  }

  .doc-nav {
    margin-top: var(--space-xl);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--border);
  }

  .doc-nav .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  @media (max-width: 600px) {
    h1 {
      font-size: var(--text-3xl);
    }
  }
</style>

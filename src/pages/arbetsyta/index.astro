---
import BaseLayout from '../../layouts/BaseLayout.astro';

const dokumentation = [
  {
    href: '/arbetsyta/mark/',
    titel: 'Markspaning',
    beskrivning: 'Prospekt och utvärderingar av markområden för ekobyprojektet.',
    status: 'aktiv',
    uppdaterad: '2026-09-14',
  },
  {
    href: '/arbetsyta/mark/offmarket/',
    titel: 'Off-market – Gods & stiftelser',
    beskrivning: 'Pitchutkast och kontaktlista för off-market markägarkontakt.',
    status: 'utkast',
    uppdaterad: '2026-09-14',
  },
  {
    href: '/arbetsyta/ekonomi/',
    titel: 'Ekonomi & kalkyler',
    beskrivning: 'Kapitalkalkyler, finansieringsmodeller och budget för ekobyns förvärv.',
    status: 'aktiv',
    uppdaterad: '2026-09-13',
  },
  {
    href: '/arbetsyta/ideer/',
    titel: 'Idébank',
    beskrivning: 'Intäktsidéer, verksamhetsplaner och resiliensstrategi för ekobymarken.',
    status: 'aktiv',
    uppdaterad: '2026-09-13',
  },
];

function statusLabel(status: string) {
  const labels: Record<string, string> = {
    utkast: 'Utkast',
    aktiv: 'Aktiv',
    arkiv: 'Arkiverad',
  };
  return labels[status] || status;
}
---

<BaseLayout
  title="Arbetsyta – En sund värld Styrelse"
  description="Intern arbetsyta för styrelsen i En sund värld. Markspaning, kalkyler, idébank och anteckningar."
>
  <article class="arbetsyta-page container">
    <header class="page-header">
      <p class="section-label">Intern arbetsyta</p>
      <h1>Styrelsens arbetsyta</h1>
      <p class="page-lead">
        Här samlar vi underlag, idéer och anteckningar för styrelsens arbete.
        Sidan är inte länkad från huvudmenyn men är publikt tillgänglig för
        den som har URL:en.
      </p>
    </header>

    <!-- Ekoby Focus Card -->
    <section class="focus-card" aria-labelledby="focus-heading">
      <div class="focus-badge">Aktivt fokus</div>
      <h2 id="focus-heading">Ekobyprojektet</h2>
      <p>
        Just nu är all energi inriktad på föreningens gemensamma ekoby – 
        att hitta mark, säkra finansiering och samla hushåll som vill vara med.
      </p>
      <ul class="focus-status">
        <li>
          <span class="status-dot status-dot--active"></span>
          <strong>Markspaning:</strong> Utvärderar prospekt i Mälardalen och Stockholms omnejd
        </li>
        <li>
          <span class="status-dot status-dot--active"></span>
          <strong>Kapitalstruktur:</strong> Kalkylerar för 10+ hushåll, 60 % belåning
        </li>
        <li>
          <span class="status-dot status-dot--pending"></span>
          <strong>Intressenter:</strong> Samlar intresseanmälningar
        </li>
      </ul>
      <a href="/arbetsyta/ekonomi/" class="btn btn-primary btn-sm">
        Se kapitalkalkylen →
      </a>
    </section>

    <section class="how-to-contribute" aria-labelledby="bidra-heading">
      <h2 id="bidra-heading">Hur du bidrar</h2>
      <p>
        Allt innehåll hanteras via Git. Du kan bidra genom att skapa en
        <strong>pull request</strong> på GitHub med dina ändringar.
      </p>
      <ol>
        <li>Klona repot eller använd GitHubs webbgränssnitt.</li>
        <li>
          Redigera eller skapa nya <code>.astro</code>-filer under
          <code>src/pages/arbetsyta/</code>.
        </li>
        <li>Skicka en pull request så granskar vi den tillsammans.</li>
      </ol>
      <p>
        Kontakta styrelsen om du behöver hjälp att komma igång med GitHub.
      </p>
    </section>

    <section class="dokumentation" aria-labelledby="dok-heading">
      <h2 id="dok-heading">Dokumentation</h2>
      <ul class="doc-list" role="list">
        {dokumentation.map((doc) => (
          <li class="doc-card">
            <a href={doc.href} class="doc-link">
              <span class="doc-meta">
                <span class={`doc-status doc-status--${doc.status}`}>
                  {statusLabel(doc.status)}
                </span>
                <span class="doc-date">Uppdaterad {doc.uppdaterad}</span>
              </span>
              <h3>{doc.titel}</h3>
              <p>{doc.beskrivning}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </article>
</BaseLayout>

<style>
  .arbetsyta-page {
    padding-block: var(--space-xl) var(--space-2xl);
  }

  .page-header {
    margin-bottom: var(--space-xl);
    padding-bottom: var(--space-lg);
    border-bottom: 2px solid var(--border);
  }

  h1 {
    font-size: var(--text-4xl);
    margin-bottom: var(--space-sm);
  }

  .page-lead {
    font-size: var(--text-lg);
    color: var(--text-muted);
    max-width: 48rem;
    line-height: 1.6;
  }

  /* Focus Card */
  .focus-card {
    background: linear-gradient(135deg, var(--deep-forest) 0%, #2a4a46 100%);
    color: var(--text-on-dark);
    border-radius: var(--radius-xl);
    padding: var(--space-lg);
    margin-bottom: var(--space-xl);
    position: relative;
  }

  .focus-badge {
    display: inline-block;
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background: var(--coral);
    color: #fff;
    padding: 0.3rem 0.8rem;
    border-radius: 999px;
    margin-bottom: var(--space-sm);
  }

  .focus-card h2 {
    color: var(--text-on-dark);
    font-size: var(--text-2xl);
    margin-bottom: var(--space-sm);
  }

  .focus-card > p {
    color: var(--accent-mid);
    font-size: var(--text-base);
    max-width: 40rem;
    margin-bottom: var(--space-md);
  }

  .focus-status {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .focus-status li {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-size: var(--text-sm);
    color: var(--accent-mid);
  }

  .focus-status strong {
    color: var(--text-on-dark);
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .status-dot--active {
    background: #4ade80;
  }

  .status-dot--pending {
    background: var(--coral);
  }

  .focus-card .btn-sm {
    padding: 0.6rem 1.2rem;
    font-size: var(--text-sm);
  }

  .how-to-contribute {
    background: var(--linen-cream);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
    margin-bottom: var(--space-xl);
    max-width: var(--max-width-prose);
  }

  .how-to-contribute h2 {
    font-size: var(--text-xl);
    margin-bottom: var(--space-sm);
    color: var(--deep-forest);
  }

  .how-to-contribute p {
    color: var(--text-muted);
    margin-bottom: var(--space-sm);
  }

  .how-to-contribute ol {
    padding-left: 1.5rem;
    color: var(--text-muted);
    margin-bottom: var(--space-sm);
  }

  .how-to-contribute li {
    margin-bottom: 0.5rem;
  }

  .how-to-contribute code {
    background: var(--bg-secondary);
    padding: 0.15rem 0.4rem;
    border-radius: var(--radius-sm);
    font-size: 0.9em;
  }

  .dokumentation h2 {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-md);
  }

  .doc-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-md);
  }

  .doc-card {
    background: var(--bg-white);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    transition: border-color var(--transition), box-shadow var(--transition);
  }

  .doc-card:hover {
    border-color: var(--accent);
    box-shadow: var(--shadow-md);
  }

  .doc-link {
    display: block;
    padding: var(--space-md);
    text-decoration: none;
    color: inherit;
  }

  .doc-link:hover {
    color: inherit;
  }

  .doc-meta {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-sm);
    flex-wrap: wrap;
  }

  .doc-status {
    display: inline-block;
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    text-transform: uppercase;
  }

  .doc-status--aktiv {
    background: var(--accent-light);
    color: var(--deep-forest);
    border: 1px solid var(--accent-mid);
  }

  .doc-status--utkast {
    background: var(--coral-light);
    color: #7a3d20;
    border: 1px solid var(--coral);
  }

  .doc-status--arkiv {
    background: var(--bg-secondary);
    color: var(--text-muted);
    border: 1px solid var(--border);
  }

  .doc-date {
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .doc-card h3 {
    font-size: var(--text-lg);
    font-family: var(--font-display);
    margin: 0 0 var(--space-xs);
    color: var(--deep-forest);
  }

  .doc-card p {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--text-muted);
    line-height: 1.5;
  }

  @media (max-width: 600px) {
    h1 {
      font-size: var(--text-3xl);
    }

    .focus-card {
      padding: var(--space-md);
    }
  }
</style>

  }

  .slider-input-group {
    margin-bottom: var(--space-md);
  }

  .slider-label {
    display: block;
    font-weight: 600;
    color: var(--deep-forest);
    margin-bottom: var(--space-sm);
  }

  .slider-output {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    color: var(--coral);
  }

  #kopes-slider {
    width: 100%;
    height: 8px;
    border-radius: 4px;
    background: var(--border);
    appearance: none;
    cursor: pointer;
  }

  #kopes-slider::-webkit-slider-thumb {
    appearance: none;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--coral);
    cursor: pointer;
    border: 3px solid var(--bg-white);
    box-shadow: var(--shadow-md);
  }

  #kopes-slider::-moz-range-thumb {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--coral);

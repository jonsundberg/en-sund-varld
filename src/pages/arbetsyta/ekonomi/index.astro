---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const metadata = {
  titel: 'Ekonomi & kalkyler',
  datum: '2026-09-14',
  status: 'utkast',
};

const kopfasAntaganden = {
  antalHh: 10,
  ltv: 0.60,
  lagfart: 0.0425,
  referenspris: { min: 3000, max: 3500 },
  insatsPerHh: { min: 197, max: 209 },
};

const scenarios = [
  { namn: 'Sparsamt', insats: '~197' },
  { namn: 'Bas', insats: '~203' },
  { namn: 'Högt', insats: '~209' },
];

const paverkansfaktorer = [
  {
    faktor: 'VA-system',
    spann: '168–993 tkr/hh',
    beskrivning: 'Från enkel kretslopp till gemensam sjöanläggning. Se detaljerad VA-kalkyl nedan.',
  },
  {
    faktor: 'Antal hushåll',
    spann: '8 ↔ 12 hh',
    beskrivning: 'Fler hushåll sprider kostnaden. Vid 12 hushåll sjunker insatsen ca 15–20 %.',
  },
  {
    faktor: 'Låneandel',
    spann: '60–75 %',
    beskrivning: 'Högre belåning sänker kontantbehov men ökar löpande räntekostnader.',
  },
];

const intaktsmojligheter = [
  { namn: 'Bete & arrende', ar: '1', risk: 'låg' },
  { namn: 'Kurser i naturbyggande', ar: '1', risk: 'medel' },
  { namn: 'CSA-andelar', ar: '1–2', risk: 'låg' },
  { namn: 'Ved & skogsbruk', ar: '1', risk: 'låg' },
];

const vaInfraKostnader = {
  individuell: {
    sparsamt: { 
      namn: 'Sparsamt regenerativt', 
      kostnad: 168, 
      beskrivning: 'Komposttoalett + BDT-rening',
      permitRisk: 'medel–hög',
    },
    bas: { 
      namn: 'Bas markbädd', 
      kostnad: 218, 
      beskrivning: 'Markbädd/sandfilter',
      permitRisk: 'låg',
    },
    hog: { 
      namn: 'Övre (sjönära MRV+P)', 
      kostnad: 293, 
      beskrivning: 'Minireningsverk + fosforfälla (strandskydd)',
      permitRisk: 'låg',
      note: 'Blackbo-lägen kräver övre pga strandskydd',
    },
  },
  medGemensamNod: {
    sparsamt: { kostnad: 318, beskrivning: 'Enkel gemensam nod + kretslopp' },
    bas: { kostnad: 618, beskrivning: 'Gemensam nod + markbädd' },
    hog: { kostnad: 993, beskrivning: 'Gemensam nod + MRV+P (sjönära)' },
  },
};

const lanekostnader = {
  bas: {
    ranta: 3.2,
    amortering: 2.0,
    ltv: 60,
    vid3Mkr: 780,
    vid3_5Mkr: 910,
  },
  stress: {
    ranta: 4.5,
    ltv: 75,
    vid3Mkr: 1220,
    vid3_5Mkr: 1420,
  },
  cashGap: {
    beloppTkr: 200,
    finansieratAndel: 0.50,
    manadskostnad: 430,
  },
};

const sparsamtPath = {
  byggande: {
    namn: 'Stegvis naturbygge',
    beskrivning: 'Lokala material (timmer, lera, halm), gemensam arbetsinsats, etappindelat.',
    kostnad: 'Varierar kraftigt',
  },
  energi: {
    namn: 'Enkel off-grid',
    beskrivning: 'Vedeldning, passiv sol, solceller i senare etapp.',
    kostnad: '20–80 tkr',
  },
};

const timbank = {
  schablonSats: 200,
  referensInsats: 200,
  nivaer: [
    { timmar: 250, andel: 25, avdragTkr: 50 },
    { timmar: 500, andel: 50, avdragTkr: 100 },
    { timmar: 1000, andel: 100, avdragTkr: 200 },
  ],
  rekommenderatTak: { min: 30, max: 50 },
};
---

<BaseLayout
  title="Ekonomi & kalkyler – Styrelsens arbetsyta"
  description="Finansieringsunderlag och kapitalkalkyler för ekobyprojektet."
>
  <article class="arbetsyta-doc container">
    <header class="doc-header">
      <p class="breadcrumb">
        <a href="/arbetsyta/">Arbetsyta</a> / Ekonomi
      </p>
      <div class="doc-meta">
        <span class="doc-status doc-status--utkast">Utkast</span>
        <span class="doc-date">14 sep 2026</span>
      </div>
      <h1>{metadata.titel}</h1>
      <p class="doc-lead">
        Kapitalkalkyler för föreningens ekobyprojekt. Siffrorna är preliminära 
        och ska verifieras mot bank, revisor och mäklare innan beslut.
      </p>
    </header>

    <!-- Planeringskort -->
    <section class="planning-card" aria-labelledby="planering">
      <h2 id="planering" class="visually-hidden">Planeringsöversikt</h2>
      <div class="planning-header">
        <span class="planning-label">Köpfas – kapitalscenario</span>
        <div class="planning-pills">
          <span class="pill pill--draft">Utkast 14 sep</span>
        </div>
      </div>
      
      <div class="planning-summary">
        <div class="summary-item">
          <span class="summary-value">3,0–3,5 Mkr</span>
          <span class="summary-label">Köpeskilling</span>
        </div>
        <div class="summary-item">
          <span class="summary-value">{kopfasAntaganden.antalHh} hh</span>
          <span class="summary-label">Hushåll</span>
        </div>
        <div class="summary-item">
          <span class="summary-value">{kopfasAntaganden.ltv * 100} %</span>
          <span class="summary-label">Belåning (LTV)</span>
        </div>
        <div class="summary-item summary-item--result">
          <span class="summary-value">~{kopfasAntaganden.insatsPerHh.min}–{kopfasAntaganden.insatsPerHh.max} tkr</span>
          <span class="summary-label">Kontant/hushåll</span>
        </div>
      </div>

      <p class="planning-note">
        Lagfart ({kopfasAntaganden.lagfart * 100} %) inräknat. Exkluderar VA/infra – se nedan.
      </p>

      <div class="scenario-chips">
        {scenarios.map((s) => (
          <span class={`chip ${s.namn === 'Bas' ? 'chip--active' : ''}`}>
            {s.namn} {s.insats} tkr
          </span>
        ))}
      </div>

      <a href="/arbetsyta/ekonomi/kapital-2026-09/" class="btn btn-outline btn-sm">
        Visa full kalkyl →
      </a>
    </section>

    <!-- Interaktiv slider -->
    <section class="doc-section slider-section" aria-labelledby="slider-heading">
      <h2 id="slider-heading">Utforska olika köpeskillingar</h2>
      <p>
        Dra i reglaget för att se hur köpfas och månadskostnad förändras vid olika 
        köpeskillingar. Beräkningen utgår från {kopfasAntaganden.antalHh} hushåll, 
        {kopfasAntaganden.ltv * 100} % belåning och {kopfasAntaganden.lagfart * 100} % lagfart.
      </p>
      
      <div class="slider-calculator" id="kapital-kalkylator">
        <div class="slider-input-group">
          <label for="kopes-slider" class="slider-label">
            Köpeskilling: <output id="kopes-output" class="slider-output">3 000 tkr</output>
          </label>
          <input 
            type="range" 
            id="kopes-slider" 
            min="2500" 
            max="4500" 
            step="100" 
            value="3000"
            aria-describedby="slider-help"
          />
          <div class="slider-range-labels">
            <span>2,5 Mkr</span>
            <span>4,5 Mkr</span>
          </div>
          <p id="slider-help" class="slider-help">
            Intervall 2,5–4,5 Mkr, steg om 100 tkr
          </p>
        </div>

        <div class="slider-results" aria-live="polite" aria-atomic="true">
          <div class="result-card">
            <span class="result-label">Köpfas per hh ({kopfasAntaganden.antalHh} hh)</span>
            <span class="result-value" id="result-per-hh">~197 tkr</span>
          </div>
          <div class="result-card">
            <span class="result-label">Månadsbetalning (bas)</span>
            <span class="result-value" id="result-monthly-bas">~780 kr</span>
          </div>
          <div class="result-card result-card--highlight">
            <span class="result-label">Månadsbetalning (stress)</span>
            <span class="result-value" id="result-monthly-stress">~1 220 kr</span>
          </div>
        </div>

        <div class="slider-assumptions">
          <h4>Synliga antaganden</h4>
          <div class="assumption-grid">
            <div class="assumption-col">
              <strong>Bas:</strong> {lanekostnader.bas.ranta} % ränta + {lanekostnader.bas.amortering} % am, {lanekostnader.bas.ltv} % LTV
            </div>
            <div class="assumption-col">
              <strong>Stress:</strong> {lanekostnader.stress.ranta} % ränta, {lanekostnader.stress.ltv} % LTV
            </div>
          </div>
        </div>
        
        <p class="slider-disclaimer">
          Månadsbetalning avser ränta + amortering på föreningens gemensamma lån, fördelat per hushåll.
          Exkluderar driftskostnader och VA-infra.
        </p>
      </div>
    </section>

    <!-- VA-kostnader -->
    <section class="doc-section va-section" aria-labelledby="va-heading">
      <h2 id="va-heading">VA + infrastruktur per hushåll</h2>
      <p>
        VA är ofta den största osäkerhetsfaktorn vid markköp utanför kommunalt 
        verksamhetsområde. Nedan visas kalkyler för tre scenarion – individuell 
        lösning och med gemensam nod.
      </p>

      <!-- Individuell lösning -->
      <div class="va-category">
        <h3>🏠 Individuell VA-lösning</h3>
        <div class="va-items">
          <div class="va-item va-item--ambitious">
            <div class="va-item-header">
              <span class="va-item-name">{vaInfraKostnader.individuell.sparsamt.namn}</span>
              <span class="va-item-cost">~{vaInfraKostnader.individuell.sparsamt.kostnad} tkr/hh</span>
            </div>
            <p class="va-item-desc">{vaInfraKostnader.individuell.sparsamt.beskrivning}</p>
            <span class="va-tag va-tag--warning">Tillståndsrisk: {vaInfraKostnader.individuell.sparsamt.permitRisk}</span>
          </div>
          <div class="va-item va-item--recommended">
            <div class="va-item-header">
              <span class="va-item-name">{vaInfraKostnader.individuell.bas.namn}</span>
              <span class="va-item-cost">~{vaInfraKostnader.individuell.bas.kostnad} tkr/hh</span>
            </div>
            <p class="va-item-desc">{vaInfraKostnader.individuell.bas.beskrivning}</p>
            <span class="va-tag va-tag--recommended">Basplanering</span>
          </div>
          <div class="va-item">
            <div class="va-item-header">
              <span class="va-item-name">{vaInfraKostnader.individuell.hog.namn}</span>
              <span class="va-item-cost">~{vaInfraKostnader.individuell.hog.kostnad} tkr/hh</span>
            </div>
            <p class="va-item-desc">{vaInfraKostnader.individuell.hog.beskrivning}</p>
            <p class="va-item-note">{vaInfraKostnader.individuell.hog.note}</p>
          </div>
        </div>
      </div>

      <!-- Med gemensam nod -->
      <div class="va-category">
        <h3>🏘️ Med enkel gemensam nod (~{kopfasAntaganden.antalHh} hh)</h3>
        <p class="va-category-desc">
          Gemensam brunn, ledningsnät och centralare VA-hantering ökar investeringen 
          men kan ge driftfördelar.
        </p>
        <div class="va-items">
          <div class="va-item va-item--ambitious">
            <div class="va-item-header">
              <span class="va-item-name">Sparsamt + gemensam nod</span>
              <span class="va-item-cost">~{vaInfraKostnader.medGemensamNod.sparsamt.kostnad} tkr/hh</span>
            </div>
            <p class="va-item-desc">{vaInfraKostnader.medGemensamNod.sparsamt.beskrivning}</p>
          </div>
          <div class="va-item va-item--recommended">
            <div class="va-item-header">
              <span class="va-item-name">Bas + gemensam nod</span>
              <span class="va-item-cost">~{vaInfraKostnader.medGemensamNod.bas.kostnad} tkr/hh</span>
            </div>
            <p class="va-item-desc">{vaInfraKostnader.medGemensamNod.bas.beskrivning}</p>
            <span class="va-tag va-tag--recommended">Rekommenderad</span>
          </div>
          <div class="va-item">
            <div class="va-item-header">
              <span class="va-item-name">Övre + gemensam nod (sjönära)</span>
              <span class="va-item-cost">~{vaInfraKostnader.medGemensamNod.hog.kostnad} tkr/hh</span>
            </div>
            <p class="va-item-desc">{vaInfraKostnader.medGemensamNod.hog.beskrivning}</p>
            <span class="va-tag va-tag--blackbo">Blackbo-scenariot</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Sparsamt regenerativt -->
    <section class="doc-section" aria-labelledby="sparsamt">
      <h2 id="sparsamt">Sparsamt regenerativt – ambitiös kretsloppslösning</h2>
      <p>
        För de som siktar på helt slutna kretslopp finns en lågkostnadsväg med 
        komposttoalett och lokal gråvattenhantering (~{vaInfraKostnader.individuell.sparsamt.kostnad} tkr/hh). 
        Detta kräver tillstånd som kan vara svåra att få.
      </p>
      
      <div class="regen-cards">
        <article class="regen-card regen-card--ambitious">
          <h3>🚽 Komposttoalett + BDT</h3>
          <p>{vaInfraKostnader.individuell.sparsamt.beskrivning}</p>
          <span class="regen-cost">~{vaInfraKostnader.individuell.sparsamt.kostnad} tkr/hh</span>
        </article>
        <article class="regen-card">
          <h3>🏠 {sparsamtPath.byggande.namn}</h3>
          <p>{sparsamtPath.byggande.beskrivning}</p>
          <span class="regen-cost">{sparsamtPath.byggande.kostnad}</span>
        </article>
        <article class="regen-card">
          <h3>⚡ {sparsamtPath.energi.namn}</h3>
          <p>{sparsamtPath.energi.beskrivning}</p>
          <span class="regen-cost">{sparsamtPath.energi.kostnad}</span>
        </article>
      </div>

      <aside class="regen-warning">
        <h4>⚠️ Plan B krävs – tillståndsrisk medel–hög</h4>
        <p>
          Kretsloppstoalett kräver dispens från kommunen. Tillståndsprocessen är 
          osäker – räkna med att behöva falla tillbaka på markbädd (~{vaInfraKostnader.individuell.bas.kostnad} tkr/hh) 
          om dispens inte beviljas. Budgetera för båda alternativen i tidigt skede.
        </p>
      </aside>

      <div class="scenario-summary">
        <h4>VA-kostnadsjämförelse per hushåll</h4>
        <div class="scenario-compare">
          <div class="scenario-box scenario-box--ambitious">
            <span class="scenario-label">Sparsamt regenerativt</span>
            <span class="scenario-value">~{vaInfraKostnader.individuell.sparsamt.kostnad} tkr</span>
            <span class="scenario-note">om tillstånd beviljas</span>
          </div>
          <div class="scenario-box scenario-box--base">
            <span class="scenario-label">Bas markbädd</span>
            <span class="scenario-value">~{vaInfraKostnader.individuell.bas.kostnad} tkr</span>
            <span class="scenario-note">plan B / standardval</span>
          </div>
          <div class="scenario-box scenario-box--high">
            <span class="scenario-label">Övre (sjönära)</span>
            <span class="scenario-value">~{vaInfraKostnader.individuell.hog.kostnad} tkr</span>
            <span class="scenario-note">Blackbo-scenariot</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Månadskostnad vid lån -->
    <section class="doc-section" aria-labelledby="manadskostnad">
      <h2 id="manadskostnad">Månadskostnad – ränta och amortering</h2>
      <p>
        Föreningens gemensamma lån fördelas på hushållen. Nedan visas månadskostnad 
        (ränta + amortering) vid olika köpeskillingar och räntescenarier.
      </p>

      <div class="loan-scenarios">
        <div class="loan-scenario">
          <h4>Basfall</h4>
          <div class="loan-params">
            <span>{lanekostnader.bas.ranta} % ränta</span>
            <span>{lanekostnader.bas.amortering} % amortering</span>
            <span>{lanekostnader.bas.ltv} % LTV</span>
          </div>
          <div class="loan-results">
            <div class="loan-result">
              <span class="loan-price">3,0 Mkr</span>
              <span class="loan-monthly">~{lanekostnader.bas.vid3Mkr} kr/hh/mån</span>
            </div>
            <div class="loan-result">
              <span class="loan-price">3,5 Mkr</span>
              <span class="loan-monthly">~{lanekostnader.bas.vid3_5Mkr} kr/hh/mån</span>
            </div>
          </div>
        </div>

        <div class="loan-scenario loan-scenario--stress">
          <h4>Stresstest</h4>
          <div class="loan-params">
            <span>{lanekostnader.stress.ranta} % ränta</span>
            <span>{lanekostnader.stress.ltv} % LTV</span>
          </div>
          <div class="loan-results">
            <div class="loan-result">
              <span class="loan-price">3,0 Mkr</span>
              <span class="loan-monthly">~{lanekostnader.stress.vid3Mkr} kr/hh/mån</span>
            </div>
            <div class="loan-result">
              <span class="loan-price">3,5 Mkr</span>
              <span class="loan-monthly">~{lanekostnader.stress.vid3_5Mkr} kr/hh/mån</span>
            </div>
          </div>
        </div>
      </div>

      <div class="cash-gap-box">
        <h4>Finansiera kontantgap?</h4>
        <p>
          Om ett hushåll behöver låna 50 % av sin kontantinsats (~{lanekostnader.cashGap.beloppTkr / 2} tkr) 
          privat för att klara köpfas:
        </p>
        <div class="cash-gap-result">
          <span class="cash-gap-value">~{lanekostnader.cashGap.manadskostnad} kr/mån</span>
          <span class="cash-gap-note">tillkommande personlig lånekostnad</span>
        </div>
      </div>

      <p class="loan-note">
        Månadsbetalning avser endast ränta + amortering. Driftskostnader (el, värme, 
        underhåll, GA-avgifter) tillkommer.
      </p>
    </section>

    <!-- Arbetstid som insats -->
    <section class="doc-section" aria-labelledby="timbank">
      <h2 id="timbank">Arbetstid som insats – timbanken</h2>
      <p>
        Hushåll som vill bidra med arbete istället för kontanter kan delta i
        föreningens <strong>timbank</strong>. Dokumenterade arbetstimmar räknas 
        av mot kontantinsatsen (~{timbank.referensInsats} tkr) enligt en schablonsats.
      </p>

      <div class="timbank-table-wrapper">
        <table class="timbank-table">
          <thead>
            <tr>
              <th scope="col">Arbetstimmar</th>
              <th scope="col">Avdrag</th>
              <th scope="col">Andel av {timbank.referensInsats} tkr</th>
            </tr>
          </thead>
          <tbody>
            {timbank.nivaer.map((n) => (
              <tr class={n.andel === 50 ? 'highlight-row' : ''}>
                <td>{n.timmar} tim</td>
                <td>{n.avdragTkr} tkr</td>
                <td>{n.andel} %</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="timbank-calc-box">
        <div class="timbank-formula">
          <span class="timbank-formula-label">Schablonsats (styrelseplats):</span>
          <span class="timbank-formula-value">{timbank.schablonSats} kr/tim</span>
        </div>
        <p class="timbank-formula-example">
          Exempel: {timbank.nivaer[1].timmar} tim × {timbank.schablonSats} kr = {timbank.nivaer[1].avdragTkr} tkr avdrag
        </p>
      </div>

      <aside class="timbank-recommendation">
        <h4>💡 Rekommenderat tak: {timbank.rekommenderatTak.min}–{timbank.rekommenderatTak.max} % arbetsinsats</h4>
        <p>
          För att balansera kontant och arbete rekommenderar vi att max 
          {timbank.rekommenderatTak.min}–{timbank.rekommenderatTak.max} % av ett hushålls insats täcks av 
          arbetstid. Detta motsvarar {Math.round(timbank.referensInsats * timbank.rekommenderatTak.min / 100)}–{Math.round(timbank.referensInsats * timbank.rekommenderatTak.max / 100)} tkr 
          eller {Math.round(timbank.referensInsats * timbank.rekommenderatTak.min / 100 / timbank.schablonSats * 1000)}–{Math.round(timbank.referensInsats * timbank.rekommenderatTak.max / 100 / timbank.schablonSats * 1000)} timmars arbete.
        </p>
      </aside>

      <aside class="timbank-disclaimer">
        <strong>Styrelsebeslut krävs:</strong> Schablonsatsen ({timbank.schablonSats} kr/tim) och 
        maxtak är preliminära förslag. Slutgiltiga nivåer och vilka arbetstyper 
        som godkänns fastställs genom styrelsebeslut innan systemet tas i bruk.
      </aside>
    </section>

    <!-- Påverkansfaktorer -->
    <section class="doc-section" aria-labelledby="paverkan">
      <h2 id="paverkan">Vad påverkar mest?</h2>
      <p>
        Tre faktorer har störst inverkan på hur mycket varje hushåll behöver 
        bidra med i kontantinsats.
      </p>
      <div class="factor-cards">
        {paverkansfaktorer.map((p) => (
          <article class="factor-card">
            <h3>{p.faktor}</h3>
            <span class="factor-range">{p.spann}</span>
            <p>{p.beskrivning}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- Fördelningsmodell -->
    <section class="doc-section" aria-labelledby="fordelning">
      <h2 id="fordelning">Fördelningsmodell</h2>
      <p>
        Vi utreder två modeller för hur kontantinsatsen fördelas mellan hushållen:
      </p>
      <div class="model-cards">
        <article class="model-card">
          <h3>Lika insats</h3>
          <p>

---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { EKONOMI_SENAST_ANDRAD, formatDatumSvenska } from '../../../data/arbetsyta-metadata';

const metadata = {
  titel: 'Ekonomi – vår modell',
  datum: EKONOMI_SENAST_ANDRAD,
  status: 'utkast',
};

const grundinsats = {
  mark: { min: 197, max: 209 },
  byggVa: { min: 45, mid: 142, max: 325 },
  total: { min: 242, mid: 350, max: 534 },
  illustrativ: 400,
};

const lanekostnader = {
  bas: {
    ranta: 3.2,
    amortering: 2.0,
    ltv: 60,
    vid3Mkr: 780,
    vid3_5Mkr: 910,
  },
  stress: {
    ranta: 4.5,
    ltv: 75,
    vid3Mkr: 1140,
    vid3_5Mkr: 1330,
  },
};

const offgrid = {
  vaOnly: { lag: 27, mid: 62, hog: 130 },
  total: { lag: 45, mid: 142, hog: 325 },
  arbeteTimmar: 800,
};

const tidslinje = [
  { 
    fas: 'År 0', 
    rubrik: 'Markköp', 
    beskrivning: 'Föreningen köper marken. Grundinsats betalas eller finansieras.' 
  },
  { 
    fas: 'År 0–1', 
    rubrik: 'Enkel etablering', 
    beskrivning: 'Brunn, startkojor, första odlingar. Låga materialkostnader.' 
  },
  { 
    fas: 'År 1–3', 
    rubrik: 'Byggfas', 
    beskrivning: 'Permanentbostäder växer fram via timbank och workshops. Material från platsen.' 
  },
  { 
    fas: 'År 2–5', 
    rubrik: 'Intjäning startar', 
    beskrivning: 'Bete, kurser, odling. Intäkter täcker drift och möjliggör extra amortering.' 
  },
  { 
    fas: 'År 5+', 
    rubrik: 'Stabilitet', 
    beskrivning: 'Lånet minskar, marken bär sig. Kostnaden sjunker om bidrag/intäkter tillkommer.' 
  },
];

const intaktsmojligheter = [
  { namn: 'Bete & arrende', ar: '1', risk: 'låg' },
  { namn: 'Kurser i naturbyggande', ar: '1', risk: 'medel' },
  { namn: 'CSA-andelar', ar: '1–2', risk: 'låg' },
  { namn: 'Ved & skogsbruk', ar: '1', risk: 'låg' },
];
---

<BaseLayout
  title="Ekonomi – Styrelsens arbetsyta"
  description="Vår finansieringsmodell för ekobyprojektet. Off-grid, material från marken, gemensamt lån."
>
  <article class="arbetsyta-doc container">
    <header class="doc-header">
      <p class="breadcrumb">
        <a href="/arbetsyta/">Arbetsyta</a> / Ekonomi
      </p>
      <div class="doc-meta">
        <span class="doc-status doc-status--utkast">Utkast</span>
        <span class="doc-date">Uppdaterad {formatDatumSvenska(metadata.datum)}</span>
      </div>
      <h1>{metadata.titel}</h1>
      <p class="doc-lead">
        Föreningens planeringsmodell för gemensamt markköp och off-grid-byggande. 
        Siffrorna är illustrativa och ska verifieras med bank och revisor innan beslut.
      </p>
    </header>

    <!-- MARKKÖP + GEMENSAMT LÅN -->
    <section class="model-section" aria-labelledby="markkop">
      <h2 id="markkop">Markköp via gemensamt föreningslån</h2>
      <p>
        Föreningen tar ett gemensamt lån för markköpet. Varje hushåll betalar sin 
        andel av ränta och amortering varje månad.
      </p>
      
      <div class="highlight-box">
        <div class="highlight-grid">
          <div class="highlight-item">
            <span class="highlight-label">Köpeskilling</span>
            <span class="highlight-value">3,0–3,5 Mkr</span>
          </div>
          <div class="highlight-item">
            <span class="highlight-label">Hushåll</span>
            <span class="highlight-value">10 st</span>
          </div>
          <div class="highlight-item">
            <span class="highlight-label">Belåning (LTV)</span>
            <span class="highlight-value">60–75 %</span>
          </div>
        </div>
        
        <div class="monthly-cost">
          <span class="monthly-label">Illustrativ månadskostnad per hushåll</span>
          <span class="monthly-value">~780–1 140 kr/mån</span>
          <span class="monthly-note">Ränta ({lanekostnader.bas.ranta} %) + amortering ({lanekostnader.bas.amortering} %). Exkluderar drift.</span>
        </div>
      </div>

      <div class="slider-section">
        <h3>Utforska olika köpeskillingar</h3>
        <div class="slider-calculator" id="kapital-kalkylator">
          <div class="slider-input-group">
            <label for="kopes-slider" class="slider-label">
              Köpeskilling: <output id="kopes-output" class="slider-output">3 000 tkr</output>
            </label>
            <input 
              type="range" 
              id="kopes-slider" 
              min="2500" 
              max="4500" 
              step="100" 
              value="3000"
              aria-describedby="slider-help"
            />
            <div class="slider-range-labels">
              <span>2,5 Mkr</span>
              <span>4,5 Mkr</span>
            </div>
          </div>

          <div class="slider-results" aria-live="polite" aria-atomic="true">
            <div class="result-card">
              <span class="result-label">Månadsbetalning/hh</span>
              <span class="result-value" id="result-monthly">~780 kr</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- GRUNDINSATS -->
    <section class="model-section" aria-labelledby="grundinsats">
      <h2 id="grundinsats">Grundinsats ~{grundinsats.illustrativ} tkr per hushåll</h2>
      <p>
        Varje hushåll bidrar med en grundinsats som täcker markköpets eget kapital 
        plus bygg/VA-material. Kan betalas kontant eller finansieras privat.
      </p>

      <div class="insats-breakdown">
        <div class="insats-row">
          <span class="insats-label">Markinsats (eget kapital)</span>
          <span class="insats-value">~{grundinsats.mark.min}–{grundinsats.mark.max} tkr</span>
        </div>
        <div class="insats-row">
          <span class="insats-label">Bygg/VA (off-grid)</span>
          <span class="insats-value">~{grundinsats.byggVa.mid} tkr</span>
        </div>
        <div class="insats-row insats-row--total">
          <span class="insats-label">Illustrativ total</span>
          <span class="insats-value">~{grundinsats.illustrativ} tkr</span>
        </div>
      </div>

      <aside class="financing-note">
        <strong>Finansiera kontantgapet?</strong> 
        Om ett hushåll behöver låna ~200 tkr privat för att klara insatsen 
        blir tillkommande månadskostnad cirka <strong>~1 700 kr/mån</strong> (illustrativt).
      </aside>
    </section>

    <!-- VÅR BYGGMODELL -->
    <section class="model-section model-section--highlight" aria-labelledby="offgrid">
      <h2 id="offgrid">Off-grid – material från marken</h2>
      <p>
        Föreningens planeringsgrund utgår från att <strong>timmer, lera och arbete kommer 
        från platsen och gemenskapen</strong> – inte från bygghandel och hantverksfakturor.
      </p>

      <div class="offgrid-principles">
        <ul>
          <li><strong>Timmer från egen skog</strong> – kostar tid, inte pengar</li>
          <li><strong>Lera från marken</strong> – jordhus-tekniker (cob, lerklining)</li>
          <li><strong>Arbete via timbank</strong> – gemensamt byggande, dokumenterade timmar</li>
          <li><strong>Kontantutlägg = köpta komponenter</strong> – fönster, fästen, verktyg</li>
        </ul>
      </div>

      <div class="offgrid-summary">
        <div class="summary-card summary-card--primary">
          <span class="summary-card-label">Kontant per hushåll</span>
          <span class="summary-card-value">~{offgrid.total.mid} tkr</span>
          <span class="summary-card-note">mittuppskattning, VA + stomme</span>
        </div>
        <div class="summary-card">
          <span class="summary-card-label">Spann</span>
          <span class="summary-card-value">{offgrid.total.lag}–{offgrid.total.hog} tkr</span>
          <span class="summary-card-note">beroende på ambitionsnivå</span>
        </div>
        <div class="summary-card">
          <span class="summary-card-label">Varav VA/vatten</span>
          <span class="summary-card-value">~{offgrid.vaOnly.mid} tkr</span>
          <span class="summary-card-note">torrtoalett, gråvatten, brunn</span>
        </div>
      </div>

      <div class="labor-note">
        <strong>Arbetsinsats:</strong> ~{offgrid.arbeteTimmar} timmar per hushåll via timbanken. 
        Arbete värderas vid ~200 kr/tim, men räknas inte som kontant.
      </div>
    </section>

    <!-- INTJÄNING -->
    <section class="model-section" aria-labelledby="intjaning">
      <h2 id="intjaning">Intjäning – marken bär sig själv</h2>
      <p>
        Redan från år 1 kan enklare verksamheter skapa intäkter som täcker drift 
        och möjliggör extra amortering. År 2–3 uppskattas bas till ca 450–750 tkr/år 
        för hela gemenskapen.
      </p>

      <div class="income-grid">
        {intaktsmojligheter.map((i) => (
          <div class="income-item">
            <span class="income-name">{i.namn}</span>
            <span class="income-year">År {i.ar}</span>
          </div>
        ))}
      </div>

      <p class="income-link">
        <a href="/arbetsyta/ideer/">Se alla idéer i idébanken →</a>
      </p>
    </section>

    <!-- TIDSLINJE -->
    <section class="model-section" aria-labelledby="tidslinje">
      <h2 id="tidslinje">Tidslinje – steg för steg</h2>
      <p>
        Kostnaden kan sjunka över tid om bidrag, intäkter eller fler hushåll tillkommer.
      </p>

      <div class="timeline">
        {tidslinje.map((t, index) => (
          <div class="timeline-item">
            <span class="timeline-marker" aria-hidden="true">{index + 1}</span>
            <div class="timeline-content">
              <span class="timeline-fas">{t.fas}</span>
              <strong class="timeline-rubrik">{t.rubrik}</strong>
              <p class="timeline-desc">{t.beskrivning}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- PLAN B -->
    <section class="model-section model-section--planb" aria-labelledby="planb">
      <h2 id="planb">Om konventionellt VA krävs</h2>
      <p>
        Om kommunen kräver WC med markbädd eller minireningsverk istället för 
        torrtoalett och gråvattenlösning blir bygg/VA-kostnaden högre – 
        uppskattningsvis 300–600 tkr per hushåll istället för ~140 tkr. 
        Det är en risk vi hanterar i tillståndsprocessen.
      </p>
    </section>

    <!-- DISCLAIMER -->
    <aside class="disclaimer" aria-labelledby="disclaimer-heading">
      <h2 id="disclaimer-heading">Illustrativt planeringsunderlag</h2>
      <p>
        Siffrorna är uppskattningar för planering och inte juridisk eller ekonomisk 
        rådgivning. Föreningen bekräftar alla uppgifter med bank och revisor innan beslut.
        Bidrag för markköp är sällsynt; bidrag för metod/infra kan förekomma.
      </p>
    </aside>

    <nav class="doc-nav" aria-label="Navigering arbetsyta">
      <a href="/arbetsyta/" class="btn btn-outline">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M19 12H5M12 19l-7-7 7-7"/>
        </svg>
        Tillbaka till arbetsytan
      </a>
    </nav>
  </article>

  <script>
    const slider = document.getElementById('kopes-slider') as HTMLInputElement;
    const kopesOutput = document.getElementById('kopes-output');
    const resultMonthly = document.getElementById('result-monthly');

    const ANTAL_HH = 10;
    const LTV = 0.60;
    const RANTA = 0.032;
    const AMORTERING = 0.02;

    function formatTkr(value: number): string {
      return Math.round(value).toLocaleString('sv-SE') + ' tkr';
    }

    function formatKr(value: number): string {
      return '~' + Math.round(value / 10) * 10 + ' kr';
    }

    function beraknaManadskostnad(kopeskillingTkr: number): number {
      const kopeskillingSek = kopeskillingTkr * 1000;
      const lanSek = kopeskillingSek * LTV;
      const arligKostnad = lanSek * (RANTA + AMORTERING);
      return arligKostnad / 12 / ANTAL_HH;
    }

    function uppdatera() {
      const kopeskillingTkr = parseInt(slider.value, 10);
      const manad = beraknaManadskostnad(kopeskillingTkr);

      if (kopesOutput) kopesOutput.textContent = formatTkr(kopeskillingTkr);
      if (resultMonthly) resultMonthly.textContent = formatKr(manad);
    }

    if (slider) {
      slider.addEventListener('input', uppdatera);
      uppdatera();
    }
  </script>
</BaseLayout>

<style>
  .arbetsyta-doc {
    padding-block: var(--space-xl) var(--space-2xl);
    max-width: var(--max-width-prose);
  }

  .doc-header {
    margin-bottom: var(--space-xl);
    padding-bottom: var(--space-lg);
    border-bottom: 2px solid var(--border);
  }

  .breadcrumb {
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin-bottom: var(--space-sm);
  }

  .breadcrumb a {
    color: var(--text-muted);
  }

  .doc-meta {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-sm);
  }

  .doc-status {
    display: inline-block;
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    text-transform: uppercase;
  }

  .doc-status--utkast {
    background: var(--coral-light);
    color: #7a3d20;
    border: 1px solid var(--coral);
  }

  .doc-date {
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  h1 {
    font-size: var(--text-4xl);
    margin-bottom: var(--space-sm);
  }

  .doc-lead {
    font-size: var(--text-lg);
    color: var(--text-muted);
    line-height: 1.6;
  }

  /* Model sections */
  .model-section {
    position: relative;
    margin-bottom: var(--space-xl);
    padding: var(--space-lg);
    background: var(--bg-white);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
  }

  .model-section h2 {
    font-size: var(--text-2xl);
    color: var(--deep-forest);
    margin-bottom: var(--space-sm);
  }

  .model-section > p {
    color: var(--text-muted);
    margin-bottom: var(--space-md);
    line-height: 1.6;
  }

  /* Highlighted section (off-grid) */
  .model-section--highlight {
    background: linear-gradient(135deg, var(--deep-forest) 0%, #2a4a46 100%);
    color: var(--text-on-dark);
    border: none;
  }

  .model-section--highlight h2 {
    color: var(--text-on-dark);
  }

  .model-section--highlight > p {
    color: var(--accent-mid);
  }

  .offgrid-principles {
    background: rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-lg);
    padding: var(--space-md);
    margin-bottom: var(--space-lg);
  }

  .offgrid-principles ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-xs);
  }

  .offgrid-principles li {
    color: var(--accent-mid);
    font-size: var(--text-sm);
    padding-left: 1.5rem;
    position: relative;
  }

  .offgrid-principles li::before {
    content: "→";
    position: absolute;
    left: 0;
    color: var(--coral);
  }

  .offgrid-principles li strong {
    color: var(--text-on-dark);
  }

  .offgrid-summary {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: var(--space-md);
    margin-bottom: var(--space-md);
  }

  .summary-card {
    background: rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-lg);
    padding: var(--space-md);
    text-align: center;
  }

  .summary-card--primary {
    background: var(--coral);
    border: 2px solid var(--coral-light);
  }

  .summary-card-label {
    display: block;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent-mid);
    margin-bottom: var(--space-xs);
  }

  .summary-card--primary .summary-card-label {
    color: rgba(255, 255, 255, 0.8);
  }

  .summary-card-value {
    display: block;
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--text-on-dark);
  }

  .summary-card-note {
    display: block;
    font-size: var(--text-sm);
    color: var(--accent-mid);
    margin-top: var(--space-xs);
  }

  .summary-card--primary .summary-card-note {
    color: rgba(255, 255, 255, 0.7);
  }

  .labor-note {
    font-size: var(--text-sm);
    color: var(--accent-mid);
    background: rgba(255, 255, 255, 0.1);
    padding: var(--space-sm);
    border-radius: var(--radius-md);
  }

  /* Plan B section */
  .model-section--planb {
    background: var(--linen-cream);
    border-color: var(--coral);
    border-style: dashed;
  }

  .model-section--planb h2 {
    color: var(--coral);
  }

  /* Highlight box */
  .highlight-box {
    background: var(--linen-cream);
    border-radius: var(--radius-lg);
    padding: var(--space-md);
    margin-bottom: var(--space-md);
  }

  .highlight-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
    margin-bottom: var(--space-md);
  }

  .highlight-item {
    text-align: center;
  }

  .highlight-label {
    display: block;
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin-bottom: var(--space-xs);
  }

  .highlight-value {
    display: block;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--deep-forest);
  }

  .monthly-cost {
    background: var(--deep-forest);
    color: var(--text-on-dark);
    border-radius: var(--radius-md);
    padding: var(--space-md);
    text-align: center;
  }

  .monthly-label {
    display: block;
    font-size: var(--text-sm);
    color: var(--accent-mid);
    margin-bottom: var(--space-xs);
  }

  .monthly-value {
    display: block;
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 700;
    margin-bottom: var(--space-xs);
  }

  .monthly-note {
    display: block;
    font-size: var(--text-sm);
    color: var(--accent-mid);
  }

  /* Slider */
  .slider-section {
    margin-top: var(--space-md);
  }

  .slider-section h3 {
    font-size: var(--text-lg);
    margin-bottom: var(--space-sm);
    color: var(--deep-forest);
  }

  .slider-calculator {
    background: var(--surface-low);
    border-radius: var(--radius-lg);
    padding: var(--space-md);
  }

  .slider-input-group {
    margin-bottom: var(--space-md);
  }

  .slider-label {
    display: block;
    font-weight: 600;
    color: var(--deep-forest);
    margin-bottom: var(--space-sm);
  }

  .slider-output {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    color: var(--coral);
  }

  #kopes-slider {
    width: 100%;
    height: 8px;
    border-radius: 4px;
    background: var(--border);
    appearance: none;
    cursor: pointer;
  }

  #kopes-slider::-webkit-slider-thumb {
    appearance: none;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--coral);
    cursor: pointer;
    border: 3px solid var(--bg-white);
    box-shadow: var(--shadow-md);
  }

  #kopes-slider::-moz-range-thumb {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--coral);
    cursor: pointer;
    border: 3px solid var(--bg-white);
    box-shadow: var(--shadow-md);
  }

  #kopes-slider:focus {
    outline: none;
  }

  #kopes-slider:focus-visible {
    outline: 3px solid var(--deep-forest);
    outline-offset: 2px;
  }

  .slider-range-labels {
    display: flex;
    justify-content: space-between;
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin-top: var(--space-xs);
  }

  .slider-results {
    display: flex;
    justify-content: center;
  }

  .result-card {
    background: var(--bg-white);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: var(--space-sm) var(--space-lg);
    text-align: center;
  }

  .result-label {
    display: block;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    margin-bottom: var(--space-xs);
  }

  .result-value {
    display: block;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--deep-forest);
  }

  /* Insats breakdown */
  .insats-breakdown {
    background: var(--surface-low);
    border-radius: var(--radius-lg);
    padding: var(--space-md);
    margin-bottom: var(--space-md);
  }

  .insats-row {
    display: flex;
    justify-content: space-between;
    padding: var(--space-xs) 0;
    border-bottom: 1px solid var(--border);
  }

  .insats-row:last-child {
    border-bottom: none;
  }

  .insats-row--total {
    margin-top: var(--space-sm);
    padding-top: var(--space-sm);
    border-top: 2px solid var(--deep-forest);
    border-bottom: none;
  }

  .insats-label {
    color: var(--text-muted);
  }

  .insats-row--total .insats-label {
    font-weight: 700;
    color: var(--deep-forest);
  }


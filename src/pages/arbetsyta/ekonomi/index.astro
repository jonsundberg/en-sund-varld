  <script>
    const slider = document.getElementById('kopes-slider') as HTMLInputElement;
    const kopesOutput = document.getElementById('kopes-output');
    const resultPerHh = document.getElementById('result-per-hh');
    const resultMonthlyBas = document.getElementById('result-monthly-bas');
    const resultMonthlyStress = document.getElementById('result-monthly-stress');

    const ANTAL_HH = 10;
    const LTV_BAS = 0.60;
    const LAGFART = 0.0425;
    
    const BAS_RANTA = 0.032;
    const BAS_AMORTERING = 0.02;
    const STRESS_RANTA = 0.045;
    const STRESS_LTV = 0.75;

    function formatTkr(value: number): string {
      return Math.round(value).toLocaleString('sv-SE') + ' tkr';
    }

    function formatKr(value: number): string {
      return '~' + Math.round(value / 10) * 10 + ' kr';
    }

    function beraknaKopfas(kopeskillingTkr: number): number {
      const kopeskillingSek = kopeskillingTkr * 1000;
      const lagfartSek = kopeskillingSek * LAGFART;
      const egetKapitalSek = kopeskillingSek * (1 - LTV_BAS);
      const totalMedlemskapitalSek = egetKapitalSek + lagfartSek;
      return totalMedlemskapitalSek / ANTAL_HH / 1000;
    }

    function beraknaManadskostnadBas(kopeskillingTkr: number): number {
      const kopeskillingSek = kopeskillingTkr * 1000;
      const lanSek = kopeskillingSek * LTV_BAS;
      const arligKostnad = lanSek * (BAS_RANTA + BAS_AMORTERING);
      return arligKostnad / 12 / ANTAL_HH;
    }

    function beraknaManadskostnadStress(kopeskillingTkr: number): number {
      const kopeskillingSek = kopeskillingTkr * 1000;
      const lanSek = kopeskillingSek * STRESS_LTV;
      const arligKostnad = lanSek * (STRESS_RANTA + BAS_AMORTERING);
      return arligKostnad / 12 / ANTAL_HH;
    }

    function uppdatera() {
      const kopeskillingTkr = parseInt(slider.value, 10);
      const kopfasPerHh = beraknaKopfas(kopeskillingTkr);
      const manadBas = beraknaManadskostnadBas(kopeskillingTkr);
      const manadStress = beraknaManadskostnadStress(kopeskillingTkr);

      if (kopesOutput) kopesOutput.textContent = formatTkr(kopeskillingTkr);
      if (resultPerHh) resultPerHh.textContent = '~' + formatTkr(kopfasPerHh);
      if (resultMonthlyBas) resultMonthlyBas.textContent = formatKr(manadBas);
      if (resultMonthlyStress) resultMonthlyStress.textContent = formatKr(manadStress);
    }

    if (slider) {
      slider.addEventListener('input', uppdatera);
      uppdatera();
    }
  </script>
</BaseLayout>


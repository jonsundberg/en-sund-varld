---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const metadata = {
  titel: 'Ekonomi & kalkyler',
  datum: '2026-09-14',
  status: 'utkast',
};

const kopfasAntaganden = {
  antalHh: 10,
  ltv: 0.60,
  lagfart: 0.0425,
  referenspris: { min: 3000, max: 3500 },
  insatsPerHh: { min: 197, max: 209 },
};

const scenarios = [
  { namn: 'Off-grid D', insats: '~142', highlight: true },
  { namn: 'Sparsamt A', insats: '~318' },
  { namn: 'Bas B', insats: '~618' },
];

const scenarioComparison = {
  d: { va: 62, total: 142 },
  a: { va: 168, total: 318 },
  b: { va: 218, total: 618 },
  c: { va: 293, total: 993 },
};

const paverkansfaktorer = [
  {
    faktor: 'VA-system',
    spann: '60–993 tkr/hh',
    beskrivning: 'Från DIY-kretslopp med material från platsen till köpt gemensam sjöanläggning. Se detaljerad kalkyl nedan.',
  },
  {
    faktor: 'Antal hushåll',
    spann: '8 ↔ 12 hh',
    beskrivning: 'Fler hushåll sprider kostnaden. Vid 12 hushåll sjunker insatsen ca 15–20 %.',
  },
  {
    faktor: 'Låneandel',
    spann: '60–75 %',
    beskrivning: 'Högre belåning sänker kontantbehov men ökar löpande räntekostnader.',
  },
];

const intaktsmojligheter = [
  { namn: 'Bete & arrende', ar: '1', risk: 'låg' },
  { namn: 'Kurser i naturbyggande', ar: '1', risk: 'medel' },
  { namn: 'CSA-andelar', ar: '1–2', risk: 'låg' },
  { namn: 'Ved & skogsbruk', ar: '1', risk: 'låg' },
];

const offgridScenario = {
  namn: 'Off-grid / material från marken (D)',
  beskrivning: 'Timmer och lera från egen mark, arbete via timbank/eget arbete. Endast köpta komponenter räknas som kontant.',
  poster: [
    { 
      namn: 'Torrtoalett', 
      beskrivning: 'Komposttoalett, enkelt system',
      lag: 5, mid: 12, hog: 25 
    },
    { 
      namn: 'Gråvatten jordhus', 
      beskrivning: 'BDT-rening via jordhus/växtbädd',
      lag: 10, mid: 25, hog: 50 
    },
    { 
      namn: 'Vattenandel (brunn m.m.)', 
      beskrivning: 'Andel gemensam brunn, pump, ledning',
      lag: 10, mid: 20, hog: 40 
    },
    { 
      namn: 'Swales & dagvatten', 
      beskrivning: 'Landskapsformning för vattenhantering',
      lag: 2, mid: 5, hog: 15 
    },
    { 
      namn: 'Stomme köpt', 
      beskrivning: 'Fönster, fästen, duk, kalk etc. (timmer+lera från marken = 0 kr)',
      lag: 15, mid: 70, hog: 175 
    },
    { 
      namn: 'Verktyg', 
      beskrivning: 'Slitage, hyra, inköp av specialverktyg',
      lag: 3, mid: 10, hog: 20 
    },
  ],
  total: { lag: 45, mid: 142, hog: 325 },
  vaOnly: { lag: 27, mid: 62, hog: 130 },
  arbete: {
    timmarPerHh: 800,
    vardeMitt: '120–200 tkr',
    timpris: '150–250 kr/h',
    note: 'Styrelsen fastställer schablonsats',
  },
};

const koptMaterialScenarios = {
  namn: 'Köpt material / entreprenad (A–C)',
  beskrivning: 'Traditionell kalyl med köpt material och hantverkare. Jämförelse för budgetplanering.',
  individuell: {
    sparsamt: { 
      namn: 'Sparsamt regenerativt (A)', 
      kostnad: 168, 
      beskrivning: 'Komposttoalett + BDT-rening (köpt)',
      permitRisk: 'medel–hög',
    },
    bas: { 
      namn: 'Bas markbädd (B)', 
      kostnad: 218, 
      beskrivning: 'Markbädd/sandfilter (köpt+installerat)',
      permitRisk: 'låg',
    },
    hog: { 
      namn: 'Övre sjönära MRV+P (C)', 
      kostnad: 293, 
      beskrivning: 'Minireningsverk + fosforfälla (strandskydd)',
      permitRisk: 'låg',
      note: 'Blackbo-lägen kräver övre pga strandskydd',
    },
  },
  medGemensamNod: {
    sparsamt: { kostnad: 318, beskrivning: 'Enkel gemensam nod + kretslopp' },
    bas: { kostnad: 618, beskrivning: 'Gemensam nod + markbädd' },
    hog: { kostnad: 993, beskrivning: 'Gemensam nod + MRV+P (sjönära)' },
  },
};

const lanekostnader = {
  bas: {
    ranta: 3.2,
    amortering: 2.0,
    ltv: 60,
    vid3Mkr: 780,
    vid3_5Mkr: 910,
  },
  stress: {
    ranta: 4.5,
    ltv: 75,
    vid3Mkr: 1220,
    vid3_5Mkr: 1420,
  },
  cashGap: {
    beloppTkr: 200,
    finansieratAndel: 0.50,
    manadskostnad: 430,
  },
};

const offgridPath = {
  byggande: {
    namn: 'Jordhus / timmer från marken',
    beskrivning: 'Lokala material (timmer, lera, halm), gemensam arbetsinsats via timbank, etappindelat.',
    kostnad: 'Arbete = tid, ej kontant',
  },
  energi: {
    namn: 'Enkel off-grid',
    beskrivning: 'Vedeldning, passiv sol, solceller i senare etapp.',
    kostnad: '20–80 tkr',
  },
  vatten: {
    namn: 'Gemensam brunn',
    beskrivning: 'Delad grävd/borrad brunn med handpump och enkel el-backup.',
    kostnad: '~20 tkr/hh',
  },
};

const timbank = {
  schablonSats: 200,
  referensInsats: 200,
  nivaer: [
    { timmar: 250, andel: 25, avdragTkr: 50 },
    { timmar: 500, andel: 50, avdragTkr: 100 },
    { timmar: 1000, andel: 100, avdragTkr: 200 },
  ],
  rekommenderatTak: { min: 30, max: 50 },
};
---

<BaseLayout
  title="Ekonomi & kalkyler – Styrelsens arbetsyta"
  description="Finansieringsunderlag och kapitalkalkyler för ekobyprojektet."
>
  <article class="arbetsyta-doc container">
    <header class="doc-header">
      <p class="breadcrumb">
        <a href="/arbetsyta/">Arbetsyta</a> / Ekonomi
      </p>
      <div class="doc-meta">
        <span class="doc-status doc-status--utkast">Utkast</span>
        <span class="doc-date">14 sep 2026</span>
      </div>
      <h1>{metadata.titel}</h1>
      <p class="doc-lead">
        Kapitalkalkyler för föreningens ekobyprojekt. Siffrorna är preliminära 
        och ska verifieras mot bank, revisor och mäklare innan beslut.
      </p>
    </header>

    <!-- Planeringskort -->
    <section class="planning-card" aria-labelledby="planering">
      <h2 id="planering" class="visually-hidden">Planeringsöversikt</h2>
      <div class="planning-header">
        <span class="planning-label">Köpfas – kapitalscenario</span>
        <div class="planning-pills">
          <span class="pill pill--draft">Utkast 14 sep</span>
        </div>
      </div>
      
      <div class="planning-summary">
        <div class="summary-item">
          <span class="summary-value">3,0–3,5 Mkr</span>
          <span class="summary-label">Köpeskilling mark</span>
        </div>
        <div class="summary-item">
          <span class="summary-value">{kopfasAntaganden.antalHh} hh</span>
          <span class="summary-label">Hushåll</span>
        </div>
        <div class="summary-item">
          <span class="summary-value">{kopfasAntaganden.ltv * 100} %</span>
          <span class="summary-label">Belåning (LTV)</span>
        </div>
        <div class="summary-item summary-item--result">
          <span class="summary-value">~{kopfasAntaganden.insatsPerHh.min}–{kopfasAntaganden.insatsPerHh.max} tkr</span>
          <span class="summary-label">Kontant/hh (mark)</span>
        </div>
      </div>

      <p class="planning-note">
        Lagfart ({kopfasAntaganden.lagfart * 100} %) inräknat. <strong>Markköpet är den stora investeringen</strong> – bygg/VA blir blygsamt när material och arbete kommer från platsen.
      </p>

      <div class="scenario-chips">
        {scenarios.map((s) => (
          <span class={`chip ${s.highlight ? 'chip--active' : ''}`}>
            {s.namn} {s.insats} tkr
          </span>
        ))}
      </div>

      <a href="/arbetsyta/ekonomi/kapital-2026-09/" class="btn btn-outline btn-sm">
        Visa full kalkyl →
      </a>
    </section>

    <!-- OFF-GRID HUVUDSPÅR -->
    <section class="offgrid-hero" aria-labelledby="offgrid-heading">
      <div class="offgrid-badge">Huvudspår</div>
      <h2 id="offgrid-heading">Off-grid / material från marken</h2>
      <p class="offgrid-intro">
        Föreningens planeringsgrund utgår från att <strong>timmer, lera och arbete kommer från platsen och gemenskapen</strong>, 
        inte från bygghandel och hantverksfakturor. Kontantbehovet för VA och bostad blir därmed blygsamt jämfört med 
        konventionellt byggande.
      </p>

      <div class="offgrid-principle">
        <h3>Grundprincip</h3>
        <ul>
          <li><strong>Timmer från egen skog</strong> – kostar tid, inte pengar</li>
          <li><strong>Lera från marken</strong> – jordhus-tekniker (cob, lerklining, jordslagning)</li>
          <li><strong>Arbete via timbank</strong> – gemensamt byggande, dokumenterade timmar</li>
          <li><strong>Kontantutlägg = köpta komponenter</strong> – fönster, fästen, duk, kalk, verktyg</li>
        </ul>
      </div>

      <div class="offgrid-table-wrapper">
        <h3>Planeringssiffror – scenario D (off-grid)</h3>
        <p class="offgrid-table-note">
          Osäkra uppskattningar för budgetplanering. 10 hushåll. Arbetsinsats räknas via timbanken, inte som kontant.
        </p>
        <table class="offgrid-table">
          <thead>
            <tr>
              <th scope="col">Post</th>
              <th scope="col">Lågt</th>
              <th scope="col">Mitt</th>
              <th scope="col">Högt</th>
            </tr>
          </thead>
          <tbody>
            {offgridScenario.poster.map((p) => (
              <tr>
                <td>
                  <strong>{p.namn}</strong>
                  <span class="post-desc">{p.beskrivning}</span>
                </td>
                <td>~{p.lag} tkr</td>
                <td class="highlight">~{p.mid} tkr</td>
                <td>~{p.hog} tkr</td>
              </tr>
            ))}
            <tr class="total-row">
              <td><strong>Totalt kontant VA+skal</strong></td>
              <td>~{offgridScenario.total.lag} tkr</td>
              <td class="highlight">~{offgridScenario.total.mid} tkr</td>
              <td>~{offgridScenario.total.hog} tkr</td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="offgrid-summary">
        <div class="summary-card summary-card--primary">
          <span class="summary-card-label">Off-grid D – kontant per hh</span>
          <span class="summary-card-value">~{offgridScenario.total.mid} tkr</span>
          <span class="summary-card-note">mittscenario VA+stomme</span>
        </div>
        <div class="summary-card">
          <span class="summary-card-label">Spann</span>
          <span class="summary-card-value">~{offgridScenario.total.lag}–{offgridScenario.total.hog} tkr</span>
          <span class="summary-card-note">beroende på ambitionsnivå</span>
        </div>
        <div class="summary-card">
          <span class="summary-card-label">Varav VA/vatten</span>
          <span class="summary-card-value">~{offgridScenario.vaOnly.mid} tkr</span>
          <span class="summary-card-note">jfr A-scenariot ~{scenarioComparison.a.va} tkr</span>
        </div>
      </div>

      <div class="labor-info">
        <h3>💪 Arbetsinsats via timbank</h3>
        <p>
          Tabellen ovan visar endast <strong>kontantutlägg</strong>. Arbete räknas separat via timbanken:
        </p>
        <div class="labor-stats">
          <div class="labor-stat">
            <span class="labor-stat-value">~{offgridScenario.arbete.timmarPerHh} h/hh</span>
            <span class="labor-stat-label">Uppskattad arbetsinsats</span>
          </div>
          <div class="labor-stat">
            <span class="labor-stat-value">{offgridScenario.arbete.vardeMitt}</span>
            <span class="labor-stat-label">Värde @ {offgridScenario.arbete.timpris}</span>
          </div>
        </div>
        <p class="labor-note">
          <em>Timmer, lera och grävning från egen mark = 0 kr kontant. {offgridScenario.arbete.note}.</em>
        </p>
      </div>

      <aside class="permit-warning">
        <h4>⚠️ Tillståndsrisk – låg kontant ≠ enkla tillstånd</h4>
        <p>
          <strong>Komposttoalett + gråvatten-jordhus:</strong> medel–hög tillståndsrisk. 
          <strong>Strandskydd:</strong> hög risk. Kommun kan kräva WC + markbädd eller minireningsverk.
        </p>
        <p>
          <strong>Plan B:</strong> Om tillstånd nekas, räkna med att falla tillbaka på scenario B eller C 
          (~{scenarioComparison.b.total}–{scenarioComparison.c.total} tkr/hh). Budgetera tid för tillståndsprocess.
        </p>
      </aside>
    </section>

    <!-- Interaktiv slider -->
    <section class="doc-section slider-section" aria-labelledby="slider-heading">
      <h2 id="slider-heading">Utforska olika köpeskillingar</h2>
      <p>
        Dra i reglaget för att se hur köpfas och månadskostnad förändras vid olika 
        köpeskillingar. Beräkningen utgår från {kopfasAntaganden.antalHh} hushåll, 
        {kopfasAntaganden.ltv * 100} % belåning och {kopfasAntaganden.lagfart * 100} % lagfart.
      </p>
      
      <div class="slider-calculator" id="kapital-kalkylator">
        <div class="slider-input-group">
          <label for="kopes-slider" class="slider-label">
            Köpeskilling: <output id="kopes-output" class="slider-output">3 000 tkr</output>
          </label>
          <input 
            type="range" 
            id="kopes-slider" 
            min="2500" 
            max="4500" 
            step="100" 
            value="3000"
            aria-describedby="slider-help"
          />
          <div class="slider-range-labels">
            <span>2,5 Mkr</span>
            <span>4,5 Mkr</span>
          </div>
          <p id="slider-help" class="slider-help">
            Intervall 2,5–4,5 Mkr, steg om 100 tkr
          </p>
        </div>

        <div class="slider-results" aria-live="polite" aria-atomic="true">
          <div class="result-card">
            <span class="result-label">Köpfas per hh ({kopfasAntaganden.antalHh} hh)</span>
            <span class="result-value" id="result-per-hh">~197 tkr</span>
          </div>
          <div class="result-card">
            <span class="result-label">Månadsbetalning (bas)</span>
            <span class="result-value" id="result-monthly-bas">~780 kr</span>
          </div>
          <div class="result-card result-card--highlight">
            <span class="result-label">Månadsbetalning (stress)</span>
            <span class="result-value" id="result-monthly-stress">~1 220 kr</span>
          </div>
        </div>

        <div class="slider-assumptions">
          <h4>Synliga antaganden</h4>
          <div class="assumption-grid">
            <div class="assumption-col">
              <strong>Bas:</strong> {lanekostnader.bas.ranta} % ränta + {lanekostnader.bas.amortering} % am, {lanekostnader.bas.ltv} % LTV
            </div>
            <div class="assumption-col">
              <strong>Stress:</strong> {lanekostnader.stress.ranta} % ränta, {lanekostnader.stress.ltv} % LTV
            </div>
          </div>
        </div>
        
        <p class="slider-disclaimer">
          Månadsbetalning avser ränta + amortering på föreningens gemensamma lån, fördelat per hushåll.
          Exkluderar driftskostnader och VA-infra.
        </p>
      </div>
    </section>

    <!-- JÄMFÖRELSE: Köpt material / entreprenad -->
    <section class="doc-section va-section comparison-section" aria-labelledby="va-heading">
      <h2 id="va-heading">Jämförelse: köpt material / entreprenad (A–C)</h2>
      <p>
        Om off-grid-vägen inte är möjlig (tillståndsproblem, tidsbrist, kompetensglapp) behövs budget 
        för köpt material och hantverkare. Scenarierna nedan visar <strong>kontantutlägg vid konventionellt VA</strong> – 
        att jämföra med off-grid D ovan.
      </p>

      <div class="comparison-header">
        <span class="comparison-label">Observera:</span>
        <p>
          Dessa siffror avser köpt material + arbetskostnad. Vid off-grid (scenario D) är kontantbehovet 
          betydligt lägre eftersom material och arbete kommer från platsen.
        </p>
      </div>

      <!-- Individuell lösning -->
      <div class="va-category">
        <h3>🏠 Individuell VA-lösning (köpt)</h3>
        <div class="va-items">
          <div class="va-item">
            <div class="va-item-header">
              <span class="va-item-name">{koptMaterialScenarios.individuell.sparsamt.namn}</span>
              <span class="va-item-cost">~{koptMaterialScenarios.individuell.sparsamt.kostnad} tkr/hh</span>
            </div>
            <p class="va-item-desc">{koptMaterialScenarios.individuell.sparsamt.beskrivning}</p>
            <span class="va-tag va-tag--warning">Tillståndsrisk: {koptMaterialScenarios.individuell.sparsamt.permitRisk}</span>
          </div>
          <div class="va-item">
            <div class="va-item-header">
              <span class="va-item-name">{koptMaterialScenarios.individuell.bas.namn}</span>
              <span class="va-item-cost">~{koptMaterialScenarios.individuell.bas.kostnad} tkr/hh</span>
            </div>
            <p class="va-item-desc">{koptMaterialScenarios.individuell.bas.beskrivning}</p>
            <span class="va-tag va-tag--fallback">Plan B om dispens nekas</span>
          </div>
          <div class="va-item">
            <div class="va-item-header">
              <span class="va-item-name">{koptMaterialScenarios.individuell.hog.namn}</span>
              <span class="va-item-cost">~{koptMaterialScenarios.individuell.hog.kostnad} tkr/hh</span>
            </div>
            <p class="va-item-desc">{koptMaterialScenarios.individuell.hog.beskrivning}</p>
            <p class="va-item-note">{koptMaterialScenarios.individuell.hog.note}</p>
          </div>
        </div>
      </div>

      <!-- Med gemensam nod -->
      <div class="va-category">
        <h3>🏘️ Med gemensam nod (~{kopfasAntaganden.antalHh} hh, köpt)</h3>
        <p class="va-category-desc">
          Gemensam brunn, ledningsnät och centralare VA-hantering. Högre investering men kan ge driftfördelar. 
          Dessa siffror gäller om ni köper material och anlitar hantverkare.
        </p>
        <div class="va-items">
          <div class="va-item">
            <div class="va-item-header">
              <span class="va-item-name">Sparsamt A + gemensam nod</span>
              <span class="va-item-cost">~{koptMaterialScenarios.medGemensamNod.sparsamt.kostnad} tkr/hh</span>
            </div>
            <p class="va-item-desc">{koptMaterialScenarios.medGemensamNod.sparsamt.beskrivning}</p>
          </div>
          <div class="va-item">
            <div class="va-item-header">
              <span class="va-item-name">Bas B + gemensam nod</span>
              <span class="va-item-cost">~{koptMaterialScenarios.medGemensamNod.bas.kostnad} tkr/hh</span>
            </div>
            <p class="va-item-desc">{koptMaterialScenarios.medGemensamNod.bas.beskrivning}</p>
            <span class="va-tag va-tag--fallback">Plan B konventionell</span>
          </div>
          <div class="va-item">
            <div class="va-item-header">
              <span class="va-item-name">Övre C + gemensam nod (sjönära)</span>
              <span class="va-item-cost">~{koptMaterialScenarios.medGemensamNod.hog.kostnad} tkr/hh</span>
            </div>
            <p class="va-item-desc">{koptMaterialScenarios.medGemensamNod.hog.beskrivning}</p>
            <span class="va-tag va-tag--blackbo">Blackbo-scenariot</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Scenariojämförelse -->
    <section class="doc-section" aria-labelledby="scenario-compare">
      <h2 id="scenario-compare">Scenariojämförelse – D vs A/B/C</h2>
      <p>
        Nedan jämförs off-grid-huvudspåret (D) med de konventionella scenarierna (A–C). 
        <strong>Markköpet är den stora investeringen</strong> – bygg och VA varierar kraftigt beroende 
        på om ni använder platsens resurser eller köper material utifrån.
      </p>
      
      <div class="regen-cards">
        <article class="regen-card regen-card--offgrid">
          <h3>🌲 {offgridPath.byggande.namn}</h3>
          <p>{offgridPath.byggande.beskrivning}</p>
          <span class="regen-cost">{offgridPath.byggande.kostnad}</span>
        </article>
        <article class="regen-card regen-card--offgrid">
          <h3>💧 {offgridPath.vatten.namn}</h3>
          <p>{offgridPath.vatten.beskrivning}</p>
          <span class="regen-cost">{offgridPath.vatten.kostnad}</span>
        </article>
        <article class="regen-card">
          <h3>⚡ {offgridPath.energi.namn}</h3>
          <p>{offgridPath.energi.beskrivning}</p>
          <span class="regen-cost">{offgridPath.energi.kostnad}</span>
        </article>
      </div>

      <div class="scenario-summary">
        <h4>Jämförelse mittscenario per hushåll</h4>
        <div class="comparison-table-wrapper">
          <table class="comparison-table">
            <thead>
              <tr>
                <th scope="col">Scenario</th>
                <th scope="col">VA/vatten</th>
                <th scope="col">VA+stomme</th>
                <th scope="col">Kommentar</th>
              </tr>
            </thead>
            <tbody>
              <tr class="highlight-row">
                <td><strong>D Off-grid</strong></td>
                <td>~{scenarioComparison.d.va} tkr</td>
                <td><strong>~{scenarioComparison.d.total} tkr</strong></td>
                <td>Huvudspår – material från platsen</td>
              </tr>
              <tr>

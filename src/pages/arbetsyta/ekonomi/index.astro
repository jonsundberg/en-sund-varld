---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const metadata = {
  titel: 'Ekonomi & kalkyler',
  datum: '2026-09-14',
  status: 'utkast',
};

const scenarios = [
  { namn: 'Sparsamt', insats: '~198' },
  { namn: 'Bas', insats: '~209' },
  { namn: 'Högt', insats: '~272' },
];

const paverkansfaktorer = [
  {
    faktor: 'Underhåll & VA',
    spann: '0,2–2,0 Mkr',
    beskrivning: 'Beroende på markens infrastruktur och behov av dränering, vattenförsörjning eller avlopp.',
  },
  {
    faktor: 'Antal hushåll',
    spann: '8 ↔ 12 hh',
    beskrivning: 'Fler hushåll sprider kostnaden. Vid 12 hushåll sjunker insatsen ca 15–20 %.',
  },
  {
    faktor: 'Låneandel',
    spann: '0–70 %',
    beskrivning: 'Högre belåning sänker kontantbehov men ökar löpande räntekostnader.',
  },
];

const intaktsmojligheter = [
  { namn: 'Bete & arrende', ar: '1', risk: 'låg' },
  { namn: 'Kurser i naturbyggande', ar: '1', risk: 'medel' },
  { namn: 'CSA-andelar', ar: '1–2', risk: 'låg' },
  { namn: 'Ved & skogsbruk', ar: '1', risk: 'låg' },
];

const sparsamtPath = {
  va: {
    namn: 'Kretsloppslösning',
    beskrivning: 'Regnvattenuppsamling, komposttoalett, gråvattenrening i våtmark.',
    kostnad: '50–150 tkr',
  },
  byggande: {
    namn: 'Stegvis naturbygge',
    beskrivning: 'Lokala material (timmer, lera, halm), gemensam arbetsinsats, etappindelat.',
    kostnad: 'Varierar kraftigt',
  },
  energi: {
    namn: 'Enkel off-grid',
    beskrivning: 'Vedeldning, passiv sol, solceller i senare etapp.',
    kostnad: '20–80 tkr',
  },
};

const lanekostnader = {
  rantesats: 5.0,
  amorteringstid: 30,
  scenarion: [
    { namn: 'Sparsamt', insatsBehov: 198, lanAndel: 100 },
    { namn: 'Bas', insatsBehov: 209, lanAndel: 150 },
    { namn: 'Högt', insatsBehov: 272, lanAndel: 200 },
  ],
};

const timbank = {
  schablonTimlonLag: 200,
  schablonTimlonHog: 350,
  exempelTimmar: 200,
};
---

<BaseLayout
  title="Ekonomi & kalkyler – Styrelsens arbetsyta"
  description="Finansieringsunderlag och kapitalkalkyler för ekobyprojektet."
>
  <article class="arbetsyta-doc container">
    <header class="doc-header">
      <p class="breadcrumb">
        <a href="/arbetsyta/">Arbetsyta</a> / Ekonomi
      </p>
      <div class="doc-meta">
        <span class="doc-status doc-status--utkast">Utkast</span>
        <span class="doc-date">14 sep 2026</span>
      </div>
      <h1>{metadata.titel}</h1>
      <p class="doc-lead">
        Kapitalkalkyler för föreningens ekobyprojekt. Siffrorna är preliminära 
        och ska verifieras mot bank, revisor och mäklare innan beslut.
      </p>
    </header>

    <!-- Planeringskort -->
    <section class="planning-card" aria-labelledby="planering">
      <h2 id="planering" class="visually-hidden">Planeringsöversikt</h2>
      <div class="planning-header">
        <span class="planning-label">Ekoby – kapitalscenario</span>
        <div class="planning-pills">
          <span class="pill pill--draft">Utkast 14 sep</span>
        </div>
      </div>
      
      <div class="planning-summary">
        <div class="summary-item">
          <span class="summary-value">3 Mkr</span>
          <span class="summary-label">Köpeskilling</span>
        </div>
        <div class="summary-item">
          <span class="summary-value">10 hh</span>
          <span class="summary-label">Hushåll</span>
        </div>
        <div class="summary-item">
          <span class="summary-value">60 %</span>
          <span class="summary-label">Belåning</span>
        </div>
        <div class="summary-item summary-item--result">
          <span class="summary-value">~209 tkr</span>
          <span class="summary-label">Kontant/hushåll</span>
        </div>
      </div>

      <p class="planning-note">
        Lagfart (4,25 %, ~128 tkr) och pantbrev inräknat i totalbeloppet.
      </p>

      <div class="scenario-chips">
        {scenarios.map((s) => (
          <span class={`chip ${s.namn === 'Bas' ? 'chip--active' : ''}`}>
            {s.namn} {s.insats} tkr
          </span>
        ))}
      </div>

      <a href="/arbetsyta/ekonomi/kapital-2026-09/" class="btn btn-outline btn-sm">
        Visa full kalkyl →
      </a>
    </section>

    <!-- Interaktiv slider -->
    <section class="doc-section slider-section" aria-labelledby="slider-heading">
      <h2 id="slider-heading">Utforska olika köpeskillingar</h2>
      <p>
        Dra i reglaget för att se hur nyckeltal förändras vid olika köpeskillingar.
        Beräkningen utgår från 10 hushåll, 60 % belåning och 4,25 % lagfart.
      </p>
      
      <div class="slider-calculator" id="kapital-kalkylator">
        <div class="slider-input-group">
          <label for="kopes-slider" class="slider-label">
            Köpeskilling: <output id="kopes-output" class="slider-output">3 000 tkr</output>
          </label>
          <input 
            type="range" 
            id="kopes-slider" 
            min="2000" 
            max="5000" 
            step="100" 
            value="3000"
            aria-describedby="slider-help"
          />
          <div class="slider-range-labels">
            <span>2 Mkr</span>
            <span>5 Mkr</span>
          </div>
          <p id="slider-help" class="slider-help">
            Intervall 2–5 Mkr, steg om 100 tkr
          </p>
        </div>

        <div class="slider-results" aria-live="polite" aria-atomic="true">
          <div class="result-card">
            <span class="result-label">Total medlemskapital</span>
            <span class="result-value" id="result-total">~2 090 tkr</span>
          </div>
          <div class="result-card">
            <span class="result-label">Per hushåll (10 hh)</span>
            <span class="result-value" id="result-per-hh">~209 tkr</span>
          </div>
          <div class="result-card result-card--highlight">
            <span class="result-label">Lånekostnad/mån (lånar hela)</span>
            <span class="result-value" id="result-monthly">~1 120 kr</span>
          </div>
        </div>
        
        <p class="slider-disclaimer">
          Antaganden: 60 % belåning, lagfart 4,25 %, 5 % ränta, 30 års amortering.
          Lånekostnad avser ett hushåll som lånar hela sin insats privat.
        </p>
      </div>
    </section>

    <!-- Sparsamt regenerativt -->
    <section class="doc-section" aria-labelledby="sparsamt">
      <h2 id="sparsamt">Sparsamt regenerativt – lågkostnadsväg</h2>
      <p>
        För hushåll som vill hålla nere kostnaden och bygga stegvis med naturliga
        material finns en alternativ väg. Detta kräver mer arbete men minskar 
        kontantbehovet kraftigt.
      </p>
      
      <div class="regen-cards">
        <article class="regen-card">
          <h3>🚿 {sparsamtPath.va.namn}</h3>
          <p>{sparsamtPath.va.beskrivning}</p>
          <span class="regen-cost">{sparsamtPath.va.kostnad}</span>
        </article>
        <article class="regen-card">
          <h3>🏠 {sparsamtPath.byggande.namn}</h3>
          <p>{sparsamtPath.byggande.beskrivning}</p>
          <span class="regen-cost">{sparsamtPath.byggande.kostnad}</span>
        </article>
        <article class="regen-card">
          <h3>⚡ {sparsamtPath.energi.namn}</h3>
          <p>{sparsamtPath.energi.beskrivning}</p>
          <span class="regen-cost">{sparsamtPath.energi.kostnad}</span>
        </article>
      </div>

      <aside class="regen-note">
        <strong>Obs:</strong> Siffrorna är uppskattningar baserade på liknande projekt.
        Faktiska kostnader beror på markens förutsättningar, tillgång till material
        och arbetsinsats. Kretsloppslösningar kräver ofta dispens från kommunen.
      </aside>
    </section>

    <!-- Månadskostnad vid lån -->
    <section class="doc-section" aria-labelledby="manadskostnad">
      <h2 id="manadskostnad">Månadskostnad om du lånar</h2>
      <p>
        För hushåll med lite kontanter kan insatsen finansieras genom privatlån.
        Nedan visas ungefärlig månadskostnad (ränta + amortering) vid olika
        lånebelopp.
      </p>

      <div class="loan-assumptions">
        <span><strong>Räntesats:</strong> {lanekostnader.rantesats} %</span>
        <span><strong>Amorteringstid:</strong> {lanekostnader.amorteringstid} år</span>
      </div>

      <div class="table-wrapper">
        <table class="loan-table">
          <thead>
            <tr>
              <th scope="col">Scenario</th>
              <th scope="col">Lånebelopp</th>
              <th scope="col">Månadskostnad</th>
            </tr>
          </thead>
          <tbody>
            {lanekostnader.scenarion.map((s) => {
              const lan = s.lanAndel * 1000;
              const r = lanekostnader.rantesats / 100 / 12;
              const n = lanekostnader.amorteringstid * 12;
              const manadsbelopp = Math.round((lan * r * Math.pow(1 + r, n)) / (Math.pow(1 + r, n) - 1));
              return (
                <tr class={s.namn === 'Bas' ? 'highlight-row' : ''}>
                  <td>{s.namn}</td>
                  <td>{s.lanAndel} tkr</td>
                  <td>~{manadsbelopp.toLocaleString('sv-SE')} kr</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>

      <p class="loan-note">
        Annuitetslån med fast ränta. Verklig ränta kan variera 3–8 % beroende på
        kreditvärdighet och säkerhet. Räkna med marginal.
      </p>
    </section>

    <!-- Arbetstid som insats -->
    <section class="doc-section" aria-labelledby="timbank">
      <h2 id="timbank">Arbetstid som insats – timbanken</h2>
      <p>
        Hushåll som vill bidra med arbete istället för kontanter kan delta i
        föreningens <strong>timbank</strong>. Dokumenterade arbetstimmar räknas 
        av mot kontantinsatsen enligt en schablonsats.
      </p>

      <div class="timbank-example">
        <h3>Räkneexempel</h3>
        <div class="timbank-calc">
          <div class="timbank-row">
            <span class="timbank-label">Arbetstimmar</span>
            <span class="timbank-value">{timbank.exempelTimmar} tim</span>
          </div>
          <div class="timbank-row">
            <span class="timbank-label">Schablonsats (låg)</span>
            <span class="timbank-value">{timbank.schablonTimlonLag} kr/tim</span>
          </div>
          <div class="timbank-row timbank-row--result">
            <span class="timbank-label">Avdrag mot kontantinsats</span>
            <span class="timbank-value">{(timbank.exempelTimmar * timbank.schablonTimlonLag / 1000).toFixed(0)} tkr</span>
          </div>
        </div>
        <p class="timbank-detail">
          Vid hög schablonsats ({timbank.schablonTimlonHog} kr/tim): {(timbank.exempelTimmar * timbank.schablonTimlonHog / 1000).toFixed(0)} tkr avdrag.
        </p>
      </div>

      <div class="timbank-rates">
        <h4>Schablonsatser (förslag, styrelsebeslut krävs)</h4>
        <dl class="rate-list">
          <div class="rate-item">
            <dt>Enklare arbete</dt>
            <dd>{timbank.schablonTimlonLag} kr/tim</dd>
            <dd class="rate-desc">Röjning, städning, enklare snickeri</dd>
          </div>
          <div class="rate-item">
            <dt>Kvalificerat arbete</dt>
            <dd>{timbank.schablonTimlonHog} kr/tim</dd>
            <dd class="rate-desc">El, VVS, projektledning, juridik</dd>
          </div>
        </dl>
      </div>

      <aside class="timbank-disclaimer">
        <strong>Viktigt:</strong> Schablonsatserna är preliminära förslag.
        Slutgiltiga nivåer och vilka arbetstyper som godkänns fastställs genom
        styrelsebeslut innan systemet tas i bruk.
      </aside>
    </section>

    <!-- Påverkansfaktorer -->
    <section class="doc-section" aria-labelledby="paverkan">
      <h2 id="paverkan">Vad påverkar mest?</h2>
      <p>
        Tre faktorer har störst inverkan på hur mycket varje hushåll behöver 
        bidra med i kontantinsats.
      </p>
      <div class="factor-cards">
        {paverkansfaktorer.map((p) => (
          <article class="factor-card">
            <h3>{p.faktor}</h3>
            <span class="factor-range">{p.spann}</span>
            <p>{p.beskrivning}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- Fördelningsmodell -->
    <section class="doc-section" aria-labelledby="fordelning">
      <h2 id="fordelning">Fördelningsmodell</h2>
      <p>
        Vi utreder två modeller för hur kontantinsatsen fördelas mellan hushållen:
      </p>
      <div class="model-cards">
        <article class="model-card">
          <h3>Lika insats</h3>
          <p>
            Alla hushåll betalar samma kontantbelopp. Enklast att administrera, 
            men kräver att alla har tillgång till kapital.
          </p>
        </article>
        <article class="model-card">
          <h3>Låginsatsmodell (30–50 %)</h3>
          <p>
            Vissa hushåll går in med lägre kontant och kompenserar genom hyra-först 
            eller arbetstid. Gap ca 0,5–0,9 Mkr fördelas på gruppen.
          </p>
        </article>
      </div>
    </section>

    <!-- Lokal intjäning -->
    <section class="doc-section" aria-labelledby="intjaning">
      <h2 id="intjaning">Lokal intjäning</h2>
      <p>
        Marken ska bära sig själv på sikt. Redan år 1 kan enklare verksamheter 
        skapa intäkter som minskar de löpande kostnaderna.
      </p>
      <table class="income-table">
        <thead>
          <tr>
            <th>Verksamhet</th>
            <th>År</th>
            <th>Risk</th>
          </tr>
        </thead>
        <tbody>
          {intaktsmojligheter.map((i) => (
            <tr>
              <td>{i.namn}</td>
              <td>{i.ar}</td>
              <td><span class={`risk risk--${i.risk}`}>{i.risk}</span></td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="income-note">
        År 2–3 uppskattas basen till ca 450–750 tkr/år. 
        <a href="/arbetsyta/ideer/">Se alla idéer i idébanken →</a>
      </p>
    </section>

    <!-- Disclaimer -->
    <aside class="disclaimer" aria-labelledby="disclaimer-heading">
      <h2 id="disclaimer-heading">Obs – internt planeringsunderlag</h2>
      <p>
        Detta är intern planering och inte juridisk eller ekonomisk rådgivning. 
        Siffrorna är uppskattningar för planering – bekräfta lagfart, pantbrev 
        och lånevillkor med bank och revisor innan föreningen lägger bud.
      </p>
    </aside>

    <nav class="doc-nav" aria-label="Navigering arbetsyta">
      <a href="/arbetsyta/" class="btn btn-outline">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M19 12H5M12 19l-7-7 7-7"/>
        </svg>
        Tillbaka till arbetsytan
      </a>
    </nav>
  </article>

  <script>
    const slider = document.getElementById('kopes-slider') as HTMLInputElement;
    const kopesOutput = document.getElementById('kopes-output');
    const resultTotal = document.getElementById('result-total');
    const resultPerHh = document.getElementById('result-per-hh');
    const resultMonthly = document.getElementById('result-monthly');

    const BELANING = 0.60;
    const LAGFART = 0.0425;
    const RANTA = 0.05;
    const AMORTERING_AR = 30;
    const ANTAL_HH = 10;

    function formatTkr(value: number): string {
      return Math.round(value).toLocaleString('sv-SE') + ' tkr';
    }

    function formatKr(value: number): string {
      return '~' + Math.round(value).toLocaleString('sv-SE') + ' kr';
    }

    function berakna(kopeskillingTkr: number) {
      const kopeskillingSek = kopeskillingTkr * 1000;
      const lagfartSek = kopeskillingSek * LAGFART;
      const egetKapitalSek = kopeskillingSek * (1 - BELANING);
      const totalMedlemskapitalSek = egetKapitalSek + lagfartSek;
      const perHhSek = totalMedlemskapitalSek / ANTAL_HH;

      const r = RANTA / 12;
      const n = AMORTERING_AR * 12;
      const manadskostnadSek = (perHhSek * r * Math.pow(1 + r, n)) / (Math.pow(1 + r, n) - 1);

      return {
        totalTkr: totalMedlemskapitalSek / 1000,
        perHhTkr: perHhSek / 1000,
        manadskostnadKr: manadskostnadSek,
      };
    }

    function uppdatera() {
      const kopeskillingTkr = parseInt(slider.value, 10);
      const { totalTkr, perHhTkr, manadskostnadKr } = berakna(kopeskillingTkr);

      if (kopesOutput) kopesOutput.textContent = formatTkr(kopeskillingTkr);
      if (resultTotal) resultTotal.textContent = '~' + formatTkr(totalTkr);
      if (resultPerHh) resultPerHh.textContent = '~' + formatTkr(perHhTkr);
      if (resultMonthly) resultMonthly.textContent = formatKr(manadskostnadKr);
    }

    if (slider) {
      slider.addEventListener('input', uppdatera);
      uppdatera();
    }
  </script>
</BaseLayout>

<style>
  .arbetsyta-doc {
    padding-block: var(--space-xl) var(--space-2xl);
    max-width: var(--max-width-prose);
  }

  .doc-header {
    margin-bottom: var(--space-xl);
    padding-bottom: var(--space-lg);
    border-bottom: 2px solid var(--border);
  }

  .breadcrumb {
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin-bottom: var(--space-sm);
  }

  .breadcrumb a {
    color: var(--text-muted);
  }

  .doc-meta {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-sm);
  }

  .doc-status {
    display: inline-block;
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    text-transform: uppercase;
  }

  .doc-status--aktiv {
    background: var(--accent-light);
    color: var(--deep-forest);
    border: 1px solid var(--accent-mid);
  }

  .doc-status--utkast {
    background: var(--coral-light);
    color: #7a3d20;
    border: 1px solid var(--coral);
  }

  .doc-date {
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  h1 {
    font-size: var(--text-4xl);
    margin-bottom: var(--space-sm);
  }

  .doc-lead {
    font-size: var(--text-lg);
    color: var(--text-muted);
    line-height: 1.6;
  }

  /* Planning Card */
  .planning-card {
    background: linear-gradient(135deg, var(--linen-cream) 0%, var(--surface-low) 100%);
    border: 2px solid var(--accent-mid);
    border-radius: var(--radius-xl);
    padding: var(--space-lg);
    margin-bottom: var(--space-xl);
  }

  .planning-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-bottom: var(--space-md);
  }

  .planning-label {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--deep-forest);
  }

  .planning-pills {
    display: flex;
    gap: var(--space-xs);
  }

  .pill {
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    text-transform: uppercase;
  }

  .pill--draft {
    background: var(--coral-light);
    color: #7a3d20;
    border: 1px solid var(--coral);
  }

  .planning-summary {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(100px, 1fr));
    gap: var(--space-md);
    margin-bottom: var(--space-md);
  }

  .summary-item {
    text-align: center;
  }

  .summary-item--result {
    background: var(--deep-forest);
    color: var(--text-on-dark);
    border-radius: var(--radius-md);
    padding: var(--space-sm);
  }

  .summary-value {
    display: block;
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 700;
  }

  .summary-item--result .summary-value {
    color: var(--text-on-dark);
  }

  .summary-label {
    display: block;
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin-top: var(--space-xs);
  }

  .summary-item--result .summary-label {
    color: var(--accent-mid);
  }

  .planning-note {
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin-bottom: var(--space-md);
    font-style: italic;
  }

  .scenario-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-bottom: var(--space-md);
  }

  .chip {
    font-size: var(--text-sm);
    padding: 0.4rem 0.8rem;
    border-radius: var(--radius-md);
    background: var(--bg-white);
    border: 1px solid var(--border);
    color: var(--text-muted);
  }

  .chip--active {
    background: var(--accent-light);
    border-color: var(--accent-mid);
    color: var(--deep-forest);
    font-weight: 600;
  }

  .btn-sm {
    padding: 0.6rem 1.2rem;
    font-size: var(--text-sm);
  }

  /* Slider Calculator */
  .slider-section {
    background: var(--linen-cream);
    border-radius: var(--radius-xl);
    padding: var(--space-lg);
    margin-bottom: var(--space-xl);
  }


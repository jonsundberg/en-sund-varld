---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { KAPITAL_DETALJ_SENAST_ANDRAD, formatDatumSvenska } from '../../../../data/arbetsyta-metadata';

const metadata = {
  titel: 'Kapitalkalkyl – detaljer',
  datum: KAPITAL_DETALJ_SENAST_ANDRAD,
  status: 'komplement',
};

const kalkyler = [
  { hh: 8, insats: 246 },
  { hh: 10, insats: 197 },
  { hh: 12, insats: 164 },
];

const antaganden = {
  kopeskilling: '3,0 Mkr',
  lagfart: '4,25 %',
  ltv: '60 %',
  ranteBas: '3,2 %',
  amortering: '2,0 %',
};
---

<BaseLayout
  title="Kapitalkalkyl – detalj"
  description="Detaljerade kalkyler för markinsats vid olika hushållsantal."
>
  <article class="arbetsyta-doc container">
    <header class="doc-header">
      <p class="breadcrumb">
        <a href="/arbetsyta/">Arbetsyta</a> / 
        <a href="/arbetsyta/ekonomi/">Ekonomi</a> / Kapitaldetalj
      </p>
      <div class="doc-meta">
        <span class="doc-status">Komplement</span>
        <span class="doc-date">Uppdaterad {formatDatumSvenska(metadata.datum)}</span>
      </div>
      <h1>{metadata.titel}</h1>
      <p class="doc-lead">
        Kompletterande siffror för markinsats vid olika antal hushåll. 
        Se <a href="/arbetsyta/ekonomi/">huvudsidan</a> för hela finansieringsmodellen.
      </p>
    </header>

    <section class="doc-section" aria-labelledby="matris">
      <h2 id="matris">Markinsats vid olika antal hushåll</h2>
      <p>
        Kontantinsats per hushåll för markköpet (eget kapital + lagfart). 
        Baserat på köpeskilling {antaganden.kopeskilling} och {antaganden.ltv} belåning.
      </p>
      
      <div class="table-wrapper">
        <table class="simple-table">
          <thead>
            <tr>
              <th scope="col">Antal hushåll</th>
              <th scope="col">Markinsats per hh</th>
            </tr>
          </thead>
          <tbody>
            {kalkyler.map((k) => (
              <tr class={k.hh === 10 ? 'highlight-row' : ''}>
                <td>{k.hh} hh</td>
                <td>~{k.insats} tkr</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <p class="table-note">
        Vid 10 hushåll och 3 Mkr köpeskilling blir markinsatsen ~197 tkr per hushåll. 
        Bygg/VA tillkommer enligt off-grid-modellen (~140 tkr).
      </p>
    </section>

    <section class="doc-section" aria-labelledby="antaganden">
      <h2 id="antaganden">Antaganden</h2>
      <dl class="assumptions-list">
        <div class="assumption-item">
          <dt>Köpeskilling</dt>
          <dd>{antaganden.kopeskilling}</dd>
        </div>
        <div class="assumption-item">
          <dt>Lagfart</dt>
          <dd>{antaganden.lagfart}</dd>
        </div>
        <div class="assumption-item">
          <dt>Belåningsgrad</dt>
          <dd>{antaganden.ltv}</dd>
        </div>
        <div class="assumption-item">
          <dt>Ränta + amortering</dt>
          <dd>{antaganden.ranteBas} + {antaganden.amortering}</dd>
        </div>
      </dl>
    </section>

    <aside class="back-link-box">
      <p>
        Detta är ett komplement. <strong>Hela finansieringsmodellen</strong> finns på 
        <a href="/arbetsyta/ekonomi/">ekonomisidan</a>.
      </p>
    </aside>

    <nav class="doc-nav" aria-label="Navigering arbetsyta">
      <a href="/arbetsyta/ekonomi/" class="btn btn-outline">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M19 12H5M12 19l-7-7 7-7"/>
        </svg>
        Tillbaka till ekonomi
      </a>
    </nav>
  </article>
</BaseLayout>

<style>
  .arbetsyta-doc {
    padding-block: var(--space-xl) var(--space-2xl);
    max-width: var(--max-width-prose);
  }

  .doc-header {
    margin-bottom: var(--space-xl);
    padding-bottom: var(--space-lg);
    border-bottom: 2px solid var(--border);
  }

  .breadcrumb {
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin-bottom: var(--space-sm);
  }

  .breadcrumb a {
    color: var(--text-muted);
  }

  .doc-meta {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-sm);
  }

  .doc-status {
    display: inline-block;
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    text-transform: uppercase;
    background: var(--bg-secondary);
    color: var(--text-muted);
    border: 1px solid var(--border);
  }

  .doc-date {
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  h1 {
    font-size: var(--text-3xl);
    margin-bottom: var(--space-sm);
  }

  .doc-lead {
    font-size: var(--text-base);
    color: var(--text-muted);
    line-height: 1.6;
  }

  .doc-section {
    margin-bottom: var(--space-xl);
  }

  .doc-section h2 {
    font-size: var(--text-xl);
    color: var(--accent);
    margin-bottom: var(--space-sm);
  }

  .doc-section p {
    color: var(--text);
    margin-bottom: var(--space-sm);
  }

  .table-wrapper {
    overflow-x: auto;
    margin-bottom: var(--space-md);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
  }

  .simple-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  .simple-table th,
  .simple-table td {
    padding: var(--space-sm) var(--space-md);
    text-align: left;
    border-bottom: 1px solid var(--border);
  }

  .simple-table thead th {
    background: var(--bg-secondary);
    font-weight: 600;
    color: var(--text-muted);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .simple-table .highlight-row {
    background: var(--accent-light);
  }

  .simple-table .highlight-row td {
    font-weight: 600;
    color: var(--deep-forest);
  }

  .table-note {
    font-size: var(--text-sm);
    color: var(--text-muted);
    font-style: italic;
  }

  .assumptions-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-sm);
    margin: 0;
  }

  .assumption-item {
    padding: var(--space-sm);
    background: var(--linen-cream);
    border-radius: var(--radius-md);
  }

  .assumption-item dt {
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin-bottom: 0.25rem;
  }

  .assumption-item dd {
    margin: 0;
    font-weight: 600;
    color: var(--deep-forest);
  }

  .back-link-box {
    background: var(--accent-light);
    border-left: 4px solid var(--accent-mid);
    border-radius: var(--radius-md);
    padding: var(--space-md);
    margin-bottom: var(--space-xl);
  }

  .back-link-box p {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--text);
  }

  .doc-nav {
    margin-top: var(--space-xl);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--border);
  }

  .doc-nav .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  @media (max-width: 600px) {
    h1 {
      font-size: var(--text-2xl);
    }

    .assumptions-list {
      grid-template-columns: 1fr;
    }
  }
</style>

    hushall: null,
    mark: null,
    url: 'https://hastekasen.se/om-oss/',
    modell: false,
  },
];

const underUppbyggnad = [
  {
    namn: 'Grönbo',
    ort: 'Göteborg',
    status: 'under uppbyggnad',
  },
  {
    namn: 'Sävstaås',
    ort: 'Bollnäs',
    status: 'under uppbyggnad',
  },
  {
    namn: 'Bysjöstrand',
    ort: 'Ludvika',
    status: 'nedlagt 2024',
  },
];

const utbildning = [
  {
    namn: 'Ridgedale Permaculture',
    beskrivning: 'Kurser i regenerativt jordbruk, market garden och agroforestry.',
    url: 'https://www.ridgedalepermaculture.com/',
  },
  {
    namn: 'Stjärnsund',
    beskrivning: 'Folkhögskola med kurser i ekologiskt byggande och permakultur.',
    url: 'https://www.stjarnsufolkhogskola.se/',
  },
  {
    namn: 'Holma Folkhögskola',
    beskrivning: 'Kursverksamhet med fokus på hållbart liv och permakultur.',
    url: 'https://www.holma.nu/',
  },
  {
    namn: 'Ecotopia Österlen',
    beskrivning: 'Permakulturdesignkurser (PDC) och praktisk hållbarhet.',
    url: 'https://ecotopia.se/',
  },
  {
    namn: 'Skillebyholm',
    beskrivning: 'Biodynamisk och ekologisk utbildning i Järna.',
    url: 'https://www.skillebyholm.com/',
  },

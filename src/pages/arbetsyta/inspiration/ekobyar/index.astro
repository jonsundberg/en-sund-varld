---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { EKOBYAR_SENAST_ANDRAD, formatDatumSvenska } from '../../../../data/arbetsyta-metadata';

const metadata = {
  titel: 'Svenska ekobyar',
  datum: EKOBYAR_SENAST_ANDRAD,

    url: 'https://www.utsikten-ekoby.se/',
    modell: true,
  },
  {
    namn: 'Ekoby Växhuset',
    ort: 'Söderhamn',
    hushall: '4 hushåll',
    mark: null,
    url: 'https://växhuset.se/',
    modell: true,
  },
  {
    namn: 'Toarps Ekoby',
    ort: 'Malmö',
    hushall: '37 hushåll',
    mark: null,
    url: 'https://toarpsekoby.se/om-ekobyn/',
    modell: false,
  },
  {
    namn: 'Tuggelite',
    ort: 'Karlstad',

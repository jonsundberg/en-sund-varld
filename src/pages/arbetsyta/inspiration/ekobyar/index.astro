    modell: false,
  },
  {
    namn: 'Solbyn',
    ort: 'Dalby',
    hushall: '50 lägenheter',
    mark: null,
    url: 'https://solbyn.org/about',
    modell: false,
  },
  {
    namn: 'BRF Hållén',
    ort: 'Uppsala',
    hushall: '22 bostadsrätter',
    mark: null,
    url: 'https://www.brf-hallen.se/',
    modell: false,
  },
  {
    namn: 'Suderbyn',
    ort: 'Gotland',
    hushall: null,
    mark: null,

---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {
  getPrimaryProspects,
  getNaraPrimarProspects,
  getSecondaryProspects,
  getGrobundProspects,
  isValidExternalUrl,
  listPris,
  listAreal,
  listKortStatus,
  type Prospekt,
} from '../../../data/prospects';
import { MARK_SENAST_ANDRAD, formatDatumSvenska } from '../../../data/arbetsyta-metadata';

const metadata = {
  titel: 'Markspaning',
  datum: MARK_SENAST_ANDRAD,
};

const grupper: { id: string; titel: string; modifier: string; items: Prospekt[] }[] = [
  { id: 'primara', titel: 'Primära', modifier: '', items: getPrimaryProspects() },
  { id: 'nara-primar', titel: 'Nära-primär', modifier: 'mark-card--nara-primar', items: getNaraPrimarProspects() },
  { id: 'sekundara', titel: 'Sekundära', modifier: 'mark-card--secondary', items: getSecondaryProspects() },
  { id: 'grobund', titel: 'Grobund', modifier: 'mark-card--grobund', items: getGrobundProspects() },
].filter((grupp) => grupp.items.length > 0);
---

<BaseLayout
  title="Markspaning – Styrelsens arbetsyta"
  description="Prospekt på mark som kan passa föreningens gemensamma ekoby."
>
  <article class="arbetsyta-doc container">
    <header class="doc-header">
      <p class="breadcrumb">
        <a href="/arbetsyta/">Arbetsyta</a> / Markspaning
      </p>
      <h1>{metadata.titel}</h1>
      <p class="doc-date">Senast uppdaterad {formatDatumSvenska(metadata.datum)}</p>
    </header>

    {grupper.map((grupp) => (
      <section class="objekt-grupp" aria-labelledby={grupp.id}>
        <h2 id={grupp.id} class="kategori-heading">{grupp.titel}</h2>
        <div class="shortlist-grid">
          {grupp.items.map((p) => {
            const kortStatus = listKortStatus(p);
            return (
              <article class:list={['mark-card', grupp.modifier || undefined]}>
                <div class="mark-card-body">
                  <div class="mark-card-header">
                    <h3 class="mark-card-heading">
                      <a href={`/arbetsyta/mark/${p.slug}/`} class="mark-card-title">
                        {p.namn}
                      </a>
                    </h3>
                    <div class="mark-card-badges">
                      {p.status === 'ny' && (
                        <span class="status-badge status-badge--ny">Ny</span>
                      )}
                      {kortStatus && (
                        <span class="status-badge status-badge--status">{kortStatus}</span>
                      )}
                    </div>
                  </div>
                  <dl class="mark-details">
                    <div class="mark-detail">
                      <dt>Kommun</dt>
                      <dd>{p.kommun}</dd>
                    </div>
                    <div class="mark-detail">
                      <dt>Areal</dt>
                      <dd>{listAreal(p.ha)} ha</dd>
                    </div>
                    <div class="mark-detail">
                      <dt>Pris</dt>
                      <dd>{listPris(p.pris)}</dd>
                    </div>
                  </dl>
                  {isValidExternalUrl(p.url) && (
                    <a
                      href={p.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="mark-link"
                      aria-label={`Öppna annons för ${p.namn}`}
                    >
                      Öppna annons
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                        <polyline points="15 3 21 3 21 9"/>
                        <line x1="10" y1="14" x2="21" y2="3"/>
                      </svg>
                    </a>
                  )}
                </div>
              </article>
            );
          })}
        </div>
      </section>
    ))}

    <nav class="doc-nav" aria-label="Navigering arbetsyta">
      <a href="/arbetsyta/" class="btn btn-outline">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M19 12H5M12 19l-7-7 7-7"/>
        </svg>
        Tillbaka till arbetsytan
      </a>
    </nav>
  </article>
</BaseLayout>

<style>
  .arbetsyta-doc {
    padding-block: var(--space-xl) var(--space-2xl);
    max-width: var(--max-width-prose);
  }

  .doc-header {
    margin-bottom: var(--space-lg);
    padding-bottom: var(--space-md);
    border-bottom: 2px solid var(--border);
  }

  .breadcrumb {
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin-bottom: var(--space-sm);
  }

  .breadcrumb a {
    color: var(--text-muted);
  }

  .breadcrumb a:hover,
  .breadcrumb a:focus-visible {
    color: var(--accent);
  }

  .breadcrumb a:focus-visible {
    outline: 3px solid var(--deep-forest);
    outline-offset: 3px;
  }

  h1 {
    font-size: var(--text-4xl);
    margin-bottom: var(--space-xs);
  }

  .doc-date {
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin: 0;
  }

  .objekt-grupp {
    margin-bottom: var(--space-lg);
  }

  .kategori-heading {
    font-size: var(--text-xl);
    color: var(--deep-forest);
    margin: 0 0 var(--space-md);
  }

  .shortlist-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--space-md);
  }

  .mark-card {
    background: var(--bg-white);
    border: 2px solid var(--accent-mid);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: border-color var(--transition), box-shadow var(--transition), transform var(--transition);
  }

  .mark-card:hover,
  .mark-card:focus-within {
    border-color: var(--accent);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .mark-card--secondary {
    border-color: var(--border);
  }

  .mark-card--secondary:hover,
  .mark-card--secondary:focus-within {
    border-color: var(--accent-mid);
  }

  .mark-card--nara-primar {
    border-color: #c1a88a;
    background: linear-gradient(135deg, var(--bg-white) 0%, #faf8f5 100%);
  }

  .mark-card--nara-primar:hover,
  .mark-card--nara-primar:focus-within {
    border-color: #9a8570;
  }

  .mark-card--grobund {
    border-color: #8b7355;
    background: linear-gradient(135deg, var(--bg-white) 0%, #f5f0e8 100%);
  }

  .mark-card--grobund:hover,
  .mark-card--grobund:focus-within {
    border-color: #6b5a45;
  }

  .mark-card-body {
    padding: var(--space-md);
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .mark-card-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-sm);
    margin-bottom: var(--space-sm);
  }

  .mark-card-heading {
    font-size: var(--text-lg);
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--deep-forest);
    margin: 0;
    line-height: 1.3;
  }

  .mark-card-title {
    color: inherit;
    text-decoration: none;
  }

  .mark-card-title:hover {
    color: var(--coral);
    text-decoration: underline;
  }

  .mark-card-title:focus-visible,
  .mark-link:focus-visible {
    outline: 3px solid var(--deep-forest);
    outline-offset: 3px;
    border-radius: var(--radius-sm);
  }

  .mark-card-badges {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.3rem;
    flex-shrink: 0;
  }

  .status-badge {
    display: inline-block;
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    text-transform: uppercase;
  }

  .status-badge--ny {
    background: var(--accent-light);
    color: var(--deep-forest);
    border: 1px solid var(--accent-mid);
  }

  .status-badge--status {
    background: var(--bg-secondary);
    color: var(--text);
    border: 1px solid var(--border);
  }

  .mark-details {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-xs) var(--space-sm);
    margin: 0 0 var(--space-sm);
  }

  .mark-detail {
    display: flex;
    flex-direction: column;
  }

  .mark-detail:last-child {
    grid-column: 1 / -1;
  }

  .mark-detail dt {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .mark-detail dd {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--text);
    font-weight: 500;
  }

  .mark-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: auto;
    padding-top: var(--space-sm);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--coral);
    text-decoration: none;
    align-self: flex-start;
  }

  .mark-link:hover {
    color: var(--coral-hover);
    text-decoration: underline;
  }

  .mark-link svg {
    flex-shrink: 0;
  }

  .doc-nav {
    margin-top: var(--space-xl);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--border);
  }

  .doc-nav .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  @media (max-width: 600px) {
    h1 {
      font-size: var(--text-3xl);
    }
  }
</style>

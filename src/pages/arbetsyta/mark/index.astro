---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const prospekt = [
  {
    namn: 'Exempelgård Småland',
    status: 'utkast',
    beskrivning: 'Placeholder – lägg till egna prospekt via pull request.',
  },
];

const metadata = {
  titel: 'Markspaning',
  datum: '2026-09-10',
  status: 'aktiv',
};
---

<BaseLayout
  title="Markspaning – Styrelsens arbetsyta"
  description="Prospekt och utvärderingar av markområden för ekoby och gemensamma projekt."
>
  <article class="arbetsyta-doc container">
    <header class="doc-header">
      <p class="breadcrumb">
        <a href="/arbetsyta/">Arbetsyta</a> / Markspaning
      </p>
      <div class="doc-meta">
        <span class="doc-status doc-status--aktiv">Aktiv</span>
        <span class="doc-date">Uppdaterad {metadata.datum}</span>
      </div>
      <h1>{metadata.titel}</h1>
      <p class="doc-lead">
        Här samlar vi prospekt på mark och gårdar som kan vara aktuella för
        föreningens initiativ. Varje objekt utvärderas utifrån kriterier som
        läge, pris, kvalitet och utvecklingspotential.
      </p>
    </header>

    <section class="doc-section" aria-labelledby="kriterier">
      <h2 id="kriterier">Urvalskriterier</h2>
      <p>
        Vid markspaning tittar vi på följande:
      </p>
      <ul>
        <li><strong>Storlek:</strong> Minst 5 hektar, helst 20+ för ekoby.</li>
        <li><strong>Läge:</strong> Rimligt avstånd till samhälle, fungerande infrastruktur.</li>
        <li><strong>Mark- och vattenkvalitet:</strong> Odlingsbar jord, vattentillgång.</li>
        <li><strong>Pris:</strong> Förenligt med våra finansieringskalkyler.</li>
        <li><strong>Potential:</strong> Möjlighet till stegvis utveckling.</li>
      </ul>
    </section>

    <section class="doc-section" aria-labelledby="prospekt">
      <h2 id="prospekt">Aktuella prospekt</h2>
      <p>
        Listan nedan är för internt bruk. Lägg till nya objekt genom en pull
        request på GitHub.
      </p>

      <div class="prospekt-list">
        {prospekt.map((p) => (
          <article class="prospekt-card">
            <div class="prospekt-header">
              <h3>{p.namn}</h3>
              <span class={`doc-status doc-status--${p.status}`}>
                {p.status === 'utkast' ? 'Utkast' : p.status === 'aktiv' ? 'Aktiv' : 'Arkiv'}
              </span>
            </div>
            <p>{p.beskrivning}</p>
          </article>
        ))}
      </div>

      <div class="add-prospekt">
        <h3>Lägg till nytt prospekt</h3>
        <p>
          Skapa en ny fil under <code>src/pages/arbetsyta/mark/</code> eller
          lägg till objektet i listan ovan. Inkludera:
        </p>
        <ul>
          <li>Namn och plats</li>
          <li>Storlek och pris</li>
          <li>Länk till annons/mäklare</li>
          <li>Initial bedömning</li>
        </ul>
      </div>
    </section>

    <nav class="doc-nav" aria-label="Navigering arbetsyta">
      <a href="/arbetsyta/" class="btn btn-outline">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M19 12H5M12 19l-7-7 7-7"/>
        </svg>
        Tillbaka till arbetsytan
      </a>
    </nav>
  </article>
</BaseLayout>

<style>
  .arbetsyta-doc {
    padding-block: var(--space-xl) var(--space-2xl);
    max-width: var(--max-width-prose);
  }

  .doc-header {
    margin-bottom: var(--space-xl);
    padding-bottom: var(--space-lg);
    border-bottom: 2px solid var(--border);
  }

  .breadcrumb {
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin-bottom: var(--space-sm);
  }

  .breadcrumb a {
    color: var(--text-muted);
  }

  .doc-meta {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-sm);
  }

  .doc-status {
    display: inline-block;
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    text-transform: uppercase;
  }

  .doc-status--aktiv {
    background: var(--accent-light);
    color: var(--deep-forest);
    border: 1px solid var(--accent-mid);
  }

  .doc-status--utkast {
    background: var(--coral-light);
    color: #7a3d20;
    border: 1px solid var(--coral);
  }

  .doc-status--arkiv {
    background: var(--bg-secondary);
    color: var(--text-muted);
    border: 1px solid var(--border);
  }

  .doc-date {
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  h1 {
    font-size: var(--text-4xl);
    margin-bottom: var(--space-sm);
  }

  .doc-lead {
    font-size: var(--text-lg);
    color: var(--text-muted);
    line-height: 1.6;
  }

  .doc-section {
    margin-bottom: var(--space-xl);
  }

  .doc-section h2 {
    font-size: var(--text-2xl);
    color: var(--accent);
    margin-bottom: var(--space-sm);
  }

  .doc-section p {
    color: var(--text);
    margin-bottom: var(--space-sm);
  }

  .doc-section ul {
    padding-left: 1.5rem;
    color: var(--text);
    margin-bottom: var(--space-md);
  }

  .doc-section li {
    margin-bottom: 0.5rem;
  }

  .prospekt-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
  }

  .prospekt-card {
    background: var(--linen-cream);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-md);
  }

  .prospekt-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    margin-bottom: var(--space-xs);
    flex-wrap: wrap;
  }

  .prospekt-card h3 {
    font-size: var(--text-lg);
    margin: 0;
  }

  .prospekt-card p {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .add-prospekt {
    background: var(--bg-secondary);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
  }

  .add-prospekt h3 {
    font-size: var(--text-lg);
    margin-bottom: var(--space-sm);
  }

  .add-prospekt code {
    background: var(--linen-cream);
    padding: 0.15rem 0.4rem;
    border-radius: var(--radius-sm);
    font-size: 0.9em;
  }

  .doc-nav {
    margin-top: var(--space-xl);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--border);
  }

  .doc-nav .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  @media (max-width: 600px) {
    h1 {
      font-size: var(--text-3xl);
    }
  }
</style>

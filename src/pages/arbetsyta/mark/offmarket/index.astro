    notering: 'Aktiv egendomsförvaltning, öppen för dialog',
  },
  {
    namn: 'Strängnäs stift',
    typ: 'Stift',
    geografi: 'Södermanland/Mälardalen',
    varfor: 'Betydande markägare, nära Stockholm, hållbarhetsmål',

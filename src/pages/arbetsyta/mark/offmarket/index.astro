    kontakt: 'Via webbplats',
    url: 'https://boogods.se',
    prio: 2,
    notering: 'Sekundärt – kräver rätt timing',
  },
  {
    namn: 'Nynäs Gods',
    typ: 'Gods',
    geografi: 'Södermanland',
    varfor: 'Stort gods, variation i markslag',
    kontakt: 'Via webbplats',
    url: 'https://nynasgods.se',
    prio: 2,
    notering: 'Kräver introduktion via nätverk',
  },
  {
    namn: 'Tidö Gods',
    typ: 'Gods',
    geografi: 'Västmanland',
    varfor: 'Historiskt gods, aktivt jordbruk',
    kontakt: 'Via webbplats',
    url: 'https://tidoslott.se',
    prio: 2,

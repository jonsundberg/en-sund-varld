---
import BaseLayout from '../../../../layouts/BaseLayout.astro';

const metadata = {
  titel: 'Off-market – Gods & stiftelser',
  datum: '2026-09-14',
  status: 'utkast',
};

interface Kontakt {
  namn: string;
  typ: string;
  geografi: string;
  varfor: string;

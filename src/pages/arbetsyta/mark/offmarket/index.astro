    prio: 2,
    notering: 'Längre från Stockholmsregionen',
  },
  {
    namn: 'Karlstads stift',
    typ: 'Stift',
    geografi: 'Värmland',
    varfor: 'Intressant vid Värmlandsfokus',
    kontakt: 'Via stiftets webbplats',
    url: 'https://svenskakyrkan.se/karlstadsstift',
    prio: 2,
    notering: 'Relevant om Värmland prioriteras',
  },
  {
    namn: 'Naturskyddsföreningen',
    typ: 'Ideell',

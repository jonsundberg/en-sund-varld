    geografi: 'Södermanland',
    varfor: 'Traditionellt jordbruk, stort skogsinnehav, tidigare arrenden',
    kontakt: 'Via webbplats',
    url: 'https://ericsberg.se',
    prio: 1,
    notering: 'Aktiv förvaltning, historiskt intresse för långsiktig markbruk',
  },
  {
    namn: 'Fullerö Säteri',
    typ: 'Gods',
    geografi: 'Uppsala',
    varfor: 'Hållbarhetsfokus, ekologisk drift, öppet för samarbeten',
    kontakt: 'info@fullerosateri.se',
    url: 'https://fullerosateri.se',
    prio: 1,
    notering: 'Redan ekologisk profil, nära Uppsala',
  },
  {
    namn: 'Hargs Bruk',
    typ: 'Gods',
    geografi: 'Uppsala/Östhammar',
    varfor: 'Stort markinnehav, historiska arrenden, skogs- och jordbruk',
    kontakt: 'Via webbplats',
    url: 'https://hargsbruk.se',
    prio: 1,
    notering: 'Etablerat bruk med tradition av markupplåtelse',
  },
  {
    namn: 'Uppsala stift',
    typ: 'Stift',
    geografi: 'Uppsala/Uppland',
    varfor: 'Stor markägare, generationstänk, etisk förvaltning',
    kontakt: 'uppsalastift.egendom@svenskakyrkan.se',

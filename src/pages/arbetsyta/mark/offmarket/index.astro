    kontakt: 'Via registraturen',
    url: 'https://lansstyrelsen.se/uppsala',
    prio: 3,
    notering: 'Informationskälla snarare än direkt markägare',
  },
  {
    namn: 'Länsstyrelsen Sörmland',
    typ: 'Myndighet',
    geografi: 'Södermanlands län',
    varfor: 'Lokalkännedom, kan peka på möjligheter',
    kontakt: 'Via registraturen',
    url: 'https://lansstyrelsen.se/sodermanland',
    prio: 3,
    notering: 'Informationskälla, ej direktägare',
  },
  {
    namn: 'Wanås Gods',
    typ: 'Gods',
    geografi: 'Skåne',
    varfor: 'Konst och hållbarhet, innovativ förvaltning',
    kontakt: 'Via webbplats',
    url: 'https://wanas.se',
    prio: 3,
    notering: 'Referens endast – Skåne ligger utanför fokusområde',
  },
  {
    namn: 'Huseby Bruk',
    typ: 'Gods',
    geografi: 'Småland',
    varfor: 'Historiskt bruk, hållbarhetsinriktning',
    kontakt: 'Via webbplats',
    url: 'https://husebybruk.se',
    prio: 3,
    notering: 'Referens – vid eventuell Smålandsexpansion',
  },
];

const prioEtt = kontakter.filter((k) => k.prio === 1);
const prioTva = kontakter.filter((k) => k.prio === 2);
const prioTre = kontakter.filter((k) => k.prio === 3);

const nastaSteg = [
  'Granskning av pitch – styrelsen läser igenom och ger synpunkter',
  'Prioritera mottagare – bekräfta första vågens lista (prio 1)',
  'Personalisera utskick – anpassa pitch för varje mottagartyp (gods/stift/stiftelse)',
  'Skicka första vågen – efter styrelsens godkännande',
  'Uppföljning – boka in uppföljningssamtal 2 veckor efter utskick',
];
---

<BaseLayout
  title="Off-market outreach – Styrelsens arbetsyta"
  description="Pitchutkast och kontaktlista för off-market markägarkontakt – gods, stift och stiftelser."
>
  <article class="arbetsyta-doc container">
    <header class="doc-header">
      <p class="breadcrumb">
        <a href="/arbetsyta/">Arbetsyta</a> / <a href="/arbetsyta/mark/">Markspaning</a> / Off-market
      </p>
      <div class="doc-meta">
        <span class="doc-status doc-status--utkast">Utkast</span>
        <span class="doc-date">Uppdaterad {metadata.datum}</span>
      </div>
      <h1>{metadata.titel}</h1>
      <p class="doc-lead">
        Strategi för att nå markägare som inte annonserar på öppna marknaden – 
        gods, kyrkan, stiftelser och andra långsiktiga förvaltare.
      </p>
    </header>

    <!-- Status banner -->
    <aside class="status-banner" aria-label="Status">
      <div class="status-icon" aria-hidden="true">⏸️</div>
      <div class="status-content">
        <strong>Status: Utkast – utskick väntar styrelsens OK</strong>
        <p>
          Pitchen och kontaktlistan är förberedda men inga utskick har gjorts. 
          Styrelsen behöver granska och godkänna innan första kontakten tas.
        </p>
      </div>
    </aside>

    <!-- Intro section -->
    <section class="doc-section" aria-labelledby="intro">
      <h2 id="intro">Vår approach</h2>
      <p>
        Vi söker <strong>dialog med markägare som redan tänker i generationer</strong> – 
        gods, kyrkan, stiftelser och andra som förvaltar mark med långsiktigt perspektiv.
      </p>
      <ul class="approach-list">
        <li>
          <strong>Vård och arrende först</strong> – vi är intresserade av nyttjanderätt 
          och arrende, inte snabba köp eller bulvanlösningar
        </li>
        <li>
          <strong>Ingen spekulation</strong> – föreningen är en ekonomisk förening 
          med syfte att vårda mark, inte sälja vidare
        </li>
        <li>
          <strong>Human-in-the-loop</strong> – vi vill lära känna markägaren och 
          förstå platsens historia innan vi pratar avtal
        </li>
        <li>
          <strong>10+ hushåll</strong> – vi söker mark för en gemensam ekoby med 
          utrymme för odling, djurhållning och gemenskap
        </li>
      </ul>
    </section>

    <!-- Pitch section -->
    <section class="doc-section pitch-section" aria-labelledby="pitch">
      <h2 id="pitch">Pitchutkast – redo att kopiera</h2>
      <p>
        Nedan finns det fullständiga pitchutkastet. Kopiera och anpassa efter 
        mottagartyp – se anpassningsfraser längre ned.
      </p>
      
      <div class="pitch-card">
        <div class="pitch-header">
          <span class="pitch-label">Huvudpitch</span>
          <button type="button" class="copy-btn" id="copy-pitch" aria-label="Kopiera pitch till urklipp">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
            </svg>
            Kopiera
          </button>
        </div>
        <div class="pitch-content" id="pitch-text">
          <p><strong>Ämne:</strong> Förfrågan om mark för gemensam ekoby – arrende/nyttjanderätt</p>
          <hr />
          <p>Hej,</p>
          <p>
            Vi skriver från <strong>En sund värld Ekonomisk Förening</strong>, en 
            paraplyorganisation för människor som vill bo och bruka mark tillsammans 
            med långsiktig vård i fokus — permakultur, ekoby-tänk och gemensam 
            förvaltning, utan spekulation.
          </p>
          <p>
            Vi söker dialog med markägare som redan tänker i generationer. Vår 
            ambition är att hitta en plats där 10+ hushåll kan etablera sig, odla, 
            hålla djur och bygga ett resilient samhälle i miniatyr.
          </p>
          <p>
            Vi är primärt intresserade av <strong>nyttjanderätt eller arrende</strong> – 
            inte bulvanlösningar eller snabba köp. Vi vill lära känna platsen och 
            markägaren innan vi pratar avtal.
          </p>
          <p>
            Finns det intresse av ett inledande samtal? Vi berättar gärna mer om 
            föreningen, våra värderingar och vad vi söker i en plats.
          </p>
          <p>
            Med vänliga hälsningar,<br />
            [Namn]<br />
            En sund värld Ekonomisk Förening<br />
            [telefon]<br />
            [e-post]
          </p>
        </div>
      </div>
    </section>

    <!-- Adaptation phrases -->
    <section class="doc-section" aria-labelledby="anpassning">
      <h2 id="anpassning">Anpassningsfraser per mottagartyp</h2>
      <p>
        Lägg till eller ersätt stycken i huvudpitchen beroende på vem du skriver till.
      </p>

      <div class="adaptation-cards">
        <article class="adaptation-card">
          <h3>🏰 Gods</h3>
          <p class="adaptation-context">För privata gods med jordbrukstradition</p>
          <blockquote>
            Vi har noterat ert gods långa historia av markförvaltning och 
            jordbruk. Vi söker samarbete med markägare som delar vårt 
            generationsperspektiv – att vårda marken snarare än att exploatera den.
          </blockquote>
        </article>

        <article class="adaptation-card">
          <h3>⛪ Stift / Kyrkan</h3>
          <p class="adaptation-context">För Svenska kyrkans stift och pastorat</p>
          <blockquote>
            Vi uppskattar kyrkans tradition av långsiktig markförvaltning och 
            etisk grund. Vår förening delar värderingarna om vård av skapelsen 
            och gemenskapsbyggande – vi tror att det finns en naturlig 
            värdegemenskap i hur vi ser på mark och ansvar.
          </blockquote>
        </article>

        <article class="adaptation-card">
          <h3>🌲 Stiftelse / Organisation</h3>
          <p class="adaptation-context">För Skogssällskapet, naturvårdsorganisationer m.fl.</p>
          <blockquote>
            Vi ser er som en organisation med liknande värderingar kring 
            hållbar mark- och skogsförvaltning. Vår förening fokuserar på 
            permakultur och regenerativt jordbruk – vi tror att ett samarbete 
            kan bidra till era mål om biologisk mångfald och levande landsbygd.
          </blockquote>
        </article>
      </div>
    </section>

    <!-- Contact table -->
    <section class="doc-section" aria-labelledby="kontakter">
      <h2 id="kontakter">Kontaktlista</h2>
      <p>
        Nedan finns en komplett lista över potentiella markägare att kontakta. 
        Prioritet 1 utgör första vågen – de vi kontaktar först.
      </p>

      <h3 class="prio-heading prio-heading--1">
        <span class="prio-badge prio-badge--1">Prio 1</span>
        Första vågen – {prioEtt.length} kontakter
      </h3>
      <div class="table-wrapper">
        <table class="contact-table">
          <thead>
            <tr>
              <th scope="col">Namn</th>
              <th scope="col">Typ</th>
              <th scope="col">Geografi</th>
              <th scope="col">Varför</th>
              <th scope="col">Kontakt</th>
              <th scope="col">Notering</th>
            </tr>
          </thead>
          <tbody>
            {prioEtt.map((k) => (
              <tr>
                <td>
                  {k.url ? (
                    <a href={k.url} target="_blank" rel="noopener noreferrer">
                      {k.namn}
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="external-icon" aria-hidden="true">
                        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                        <polyline points="15 3 21 3 21 9"/>
                        <line x1="10" y1="14" x2="21" y2="3"/>
                      </svg>
                    </a>
                  ) : (
                    k.namn
                  )}
                </td>
                <td><span class={`typ-badge typ-badge--${k.typ.toLowerCase()}`}>{k.typ}</span></td>
                <td>{k.geografi}</td>
                <td>{k.varfor}</td>
                <td class="kontakt-cell">{k.kontakt}</td>
                <td class="notering-cell">{k.notering}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <h3 class="prio-heading prio-heading--2">
        <span class="prio-badge prio-badge--2">Prio 2</span>
        Andra vågen – {prioTva.length} kontakter
      </h3>
      <div class="table-wrapper">
        <table class="contact-table contact-table--secondary">
          <thead>
            <tr>
              <th scope="col">Namn</th>
              <th scope="col">Typ</th>
              <th scope="col">Geografi</th>
              <th scope="col">Varför</th>
              <th scope="col">Kontakt</th>
              <th scope="col">Notering</th>
            </tr>
          </thead>
          <tbody>
            {prioTva.map((k) => (
              <tr>
                <td>
                  {k.url ? (
                    <a href={k.url} target="_blank" rel="noopener noreferrer">
                      {k.namn}
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="external-icon" aria-hidden="true">
                        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                        <polyline points="15 3 21 3 21 9"/>
                        <line x1="10" y1="14" x2="21" y2="3"/>
                      </svg>
                    </a>
                  ) : (
                    k.namn
                  )}
                </td>
                <td><span class={`typ-badge typ-badge--${k.typ.toLowerCase()}`}>{k.typ}</span></td>
                <td>{k.geografi}</td>
                <td>{k.varfor}</td>
                <td class="kontakt-cell">{k.kontakt}</td>
                <td class="notering-cell">{k.notering}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <h3 class="prio-heading prio-heading--3">
        <span class="prio-badge prio-badge--3">Prio 3</span>
        Referens / framtid – {prioTre.length} kontakter
      </h3>
      <div class="table-wrapper">
        <table class="contact-table contact-table--tertiary">
          <thead>
            <tr>
              <th scope="col">Namn</th>
              <th scope="col">Typ</th>
              <th scope="col">Geografi</th>
              <th scope="col">Varför</th>
              <th scope="col">Kontakt</th>
              <th scope="col">Notering</th>
            </tr>
          </thead>
          <tbody>
            {prioTre.map((k) => (
              <tr>
                <td>
                  {k.url ? (
                    <a href={k.url} target="_blank" rel="noopener noreferrer">
                      {k.namn}
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="external-icon" aria-hidden="true">
                        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                        <polyline points="15 3 21 3 21 9"/>
                        <line x1="10" y1="14" x2="21" y2="3"/>
                      </svg>
                    </a>
                  ) : (
                    k.namn
                  )}
                </td>
                <td><span class={`typ-badge typ-badge--${k.typ.toLowerCase()}`}>{k.typ}</span></td>
                <td>{k.geografi}</td>
                <td>{k.varfor}</td>
                <td class="kontakt-cell">{k.kontakt}</td>
                <td class="notering-cell">{k.notering}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- First wave summary -->
    <section class="doc-section" aria-labelledby="forsta-vagen">
      <h2 id="forsta-vagen">Första vågens mottagare</h2>
      <p>
        Dessa {prioEtt.length} kontakter kontaktas först. Listan är baserad på 
        geografisk relevans (Mälardalen/Stockholmsregionen) och sannolikhet för 
        positiv respons.
      </p>
      <ul class="first-wave-list">
        {prioEtt.map((k) => (
          <li>
            <strong>{k.namn}</strong> ({k.typ}) – {k.geografi}
            {k.url && (
              <a href={k.url} target="_blank" rel="noopener noreferrer" class="first-wave-link">
                Webbplats
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                  <polyline points="15 3 21 3 21 9"/>
                  <line x1="10" y1="14" x2="21" y2="3"/>
                </svg>
              </a>
            )}
          </li>
        ))}
      </ul>
      <a href="/arbetsyta/mark/offmarket/utskick/" class="btn btn-outline btn-sm">
        Se förberedda utskick →
      </a>
    </section>

    <!-- Next steps -->
    <section class="doc-section" aria-labelledby="nasta-steg">
      <h2 id="nasta-steg">Nästa steg för styrelsen</h2>
      <ol class="next-steps-list">
        {nastaSteg.map((steg, i) => (
          <li>
            <span class="step-number">{i + 1}</span>
            <span class="step-text">{steg}</span>
          </li>
        ))}
      </ol>
    </section>

    <!-- Disclaimer -->
    <aside class="disclaimer" aria-labelledby="disclaimer-heading">
      <h2 id="disclaimer-heading">Obs – intern planering</h2>
      <p>
        Detta är internt planeringsmaterial för styrelsens arbete med 
        off-market markspaning. Kontaktlistan och pitchen är arbetsutkast 
        och ska granskas innan något utskick görs.
      </p>
      <p>
        <strong>Inga utskick har gjorts.</strong> Allt material är förberett 
        men väntar på styrelsens godkännande.
      </p>
    </aside>

    <nav class="doc-nav" aria-label="Navigering arbetsyta">
      <a href="/arbetsyta/mark/" class="btn btn-outline">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M19 12H5M12 19l-7-7 7-7"/>
        </svg>
        Tillbaka till markspaning
      </a>
    </nav>
  </article>

  <script>
    const copyBtn = document.getElementById('copy-pitch');
    const pitchText = document.getElementById('pitch-text');

    copyBtn?.addEventListener('click', async () => {
      if (!pitchText) return;
      
      const text = pitchText.innerText;
      
      try {
        await navigator.clipboard.writeText(text);
        const originalHTML = copyBtn.innerHTML;
        copyBtn.innerHTML = `
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          Kopierad!
        `;
        copyBtn.classList.add('copy-btn--success');
        
        setTimeout(() => {
          copyBtn.innerHTML = originalHTML;
          copyBtn.classList.remove('copy-btn--success');
        }, 2000);
      } catch (err) {
        console.error('Failed to copy:', err);
      }
    });

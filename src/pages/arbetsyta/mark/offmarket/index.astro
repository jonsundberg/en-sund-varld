  },
  {
    namn: 'Skogssällskapet',
    typ: 'Stiftelse',
    geografi: 'Hela Sverige',
    varfor: 'Hållbart skogsbruk, öppen för innovativa upplåtelser',
    kontakt: '0771-22 00 44',
    url: 'https://skogssallskapet.se',
    prio: 1,
    notering: 'Nationell aktör, professionell kontakt',
  },
  {
    namn: 'Sveaskog',
    typ: 'Statligt',
    geografi: 'Hela Sverige',
    varfor: 'Sveriges största markägare, arrendeverksamhet',
    kontakt: 'arrende@sveaskog.se',
    url: 'https://sveaskog.se',
    prio: 1,
    notering: 'Stor organisation, formell process för arrenden',
  },
  {
    namn: 'Boo Gods',
    typ: 'Gods',
    geografi: 'Uppland',

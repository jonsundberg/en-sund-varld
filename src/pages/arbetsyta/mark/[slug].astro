---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {
  getAllProspects,
  getProspektBySlug,
  statusLabels,
  EKONOMI_KONSTANTER,
  VA_KOSTNADER,
  type Prospekt,
  type VANiva,
} from '../../../data/prospects';

export function getStaticPaths() {
  const prospects = getAllProspects();
  return prospects.map((p) => ({
    params: { slug: p.slug },
  }));
}

const { slug } = Astro.params;
const prospekt = getProspektBySlug(slug as string);

if (!prospekt) {
  return Astro.redirect('/arbetsyta/mark/');
}

const vaNivaLabels: Record<VANiva, string> = {
  sparsamt: 'Sparsamt regenerativt',
  bas: 'Bas markbädd',
  övre: 'Övre (sjönära MRV+P)',
};

const flaggaClass = {
  info: 'flagga--info',
  varning: 'flagga--varning',
  positiv: 'flagga--positiv',
};

function formatKr(value: number): string {
  return value.toLocaleString('sv-SE') + ' kr';
}

function formatTkr(value: number): string {
  return '~' + value + ' tkr';
}
---

<BaseLayout
  title={`${prospekt.namn} – Markspaning`}
  description={`Detaljerad information om ${prospekt.namn} i ${prospekt.kommun}. Areal: ${prospekt.ha} ha, Pris: ${prospekt.pris}.`}
>
  <article class="arbetsyta-doc container">
    <header class="doc-header">
      <p class="breadcrumb">
        <a href="/arbetsyta/">Arbetsyta</a> /
        <a href="/arbetsyta/mark/">Markspaning</a> /
        {prospekt.namn}
      </p>
      <div class="doc-meta">
        <span class={`status-badge status-badge--${prospekt.status}`}>
          {statusLabels[prospekt.status]}
        </span>
        <span class={`kategori-badge kategori-badge--${prospekt.kategori}`}>
          {prospekt.kategori === 'primär' ? 'Primär' : 'Sekundär'}
        </span>
      </div>
      <h1>{prospekt.namn}</h1>
      <p class="doc-subtitle">
        {prospekt.kommun}, {prospekt.lan}
      </p>
    </header>

    <!-- Fakta-kort -->
    <section class="fakta-card" aria-labelledby="fakta-heading">
      <h2 id="fakta-heading" class="section-heading">Fakta</h2>
      <dl class="fakta-grid">
        <div class="fakta-item">
          <dt>Kommun</dt>
          <dd>{prospekt.kommun}</dd>
        </div>
        <div class="fakta-item">
          <dt>Län</dt>
          <dd>{prospekt.lan}</dd>
        </div>
        <div class="fakta-item">
          <dt>Areal</dt>
          <dd>{prospekt.ha} ha</dd>
        </div>
        <div class="fakta-item fakta-item--highlight">
          <dt>Pris</dt>
          <dd>{prospekt.pris}</dd>
        </div>
        <div class="fakta-item">
          <dt>Byggnader</dt>
          <dd>{prospekt.byggnader}</dd>
        </div>
        {prospekt.buddatum && (
          <div class="fakta-item fakta-item--warning">
            <dt>Buddatum</dt>
            <dd>{prospekt.buddatum}</dd>
          </div>
        )}
        {prospekt.saljartyp && (
          <div class="fakta-item">
            <dt>Säljare</dt>
            <dd>{prospekt.saljartyp}</dd>
          </div>
        )}
      </dl>
      <a href={prospekt.url} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
        Öppna annons
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
          <polyline points="15 3 21 3 21 9"/>
          <line x1="10" y1="14" x2="21" y2="3"/>
        </svg>
      </a>
    </section>

    <!-- Flaggor -->
    <section class="doc-section" aria-labelledby="flaggor-heading">
      <h2 id="flaggor-heading" class="section-heading">Flaggor & noteringar</h2>
      {prospekt.flaggor.length > 0 ? (
        <ul class="flaggor-list">
          {prospekt.flaggor.map((f) => (
            <li class={`flagga ${flaggaClass[f.typ]}`}>
              <span class="flagga-icon" aria-hidden="true">
                {f.typ === 'varning' ? '⚠️' : f.typ === 'positiv' ? '✓' : 'ℹ️'}
              </span>
              <span class="flagga-text">{f.text}</span>
            </li>
          ))}
        </ul>
      ) : (
        <p class="muted-text">Inga flaggor registrerade ännu.</p>
      )}
    </section>

    <!-- Kalkyl -->
    <section class="kalkyl-section" aria-labelledby="kalkyl-heading">
      <h2 id="kalkyl-heading" class="section-heading">Objektspecifik kalkyl</h2>
      
      <div class="kalkyl-note">
        <p>
          Beräknat med <strong>{EKONOMI_KONSTANTER.antalHh} hushåll</strong>, 
          <strong>{EKONOMI_KONSTANTER.ltv * 100} % belåning (LTV)</strong> och 
          <strong>{EKONOMI_KONSTANTER.lagfart * 100} % lagfart</strong>. 
          Generella formler finns på <a href="/arbetsyta/ekonomi/">ekonomisidan</a>.
        </p>
      </div>

      <div class="kalkyl-cards">
        <div class="kalkyl-card kalkyl-card--primary">
          <h3>Köpfas – kontantinsats per hushåll</h3>
          <span class="kalkyl-value">{formatTkr(prospekt.kalkyl.kopfasPerHh)}</span>
          <span class="kalkyl-label">exkl. VA-infrastruktur</span>
        </div>
        
        <div class="kalkyl-card">
          <h3>Månadskostnad (bas)</h3>
          <span class="kalkyl-value">{formatKr(prospekt.kalkyl.manadskostnadBas)}/hh</span>
          <span class="kalkyl-label">{EKONOMI_KONSTANTER.basRanta * 100} % ränta + {EKONOMI_KONSTANTER.basAmortering * 100} % am</span>
        </div>
        
        <div class="kalkyl-card kalkyl-card--stress">
          <h3>Månadskostnad (stress)</h3>
          <span class="kalkyl-value">{formatKr(prospekt.kalkyl.manadskostnadStress)}/hh</span>
          <span class="kalkyl-label">{EKONOMI_KONSTANTER.stressRanta * 100} % ränta, {EKONOMI_KONSTANTER.stressLtv * 100} % LTV</span>
        </div>
      </div>

      <div class="va-kalkyl">
        <h3>VA-kostnader per hushåll</h3>
        <p class="va-rekommendation">
          <strong>Rekommenderad nivå för detta objekt:</strong> 
          <span class={`va-badge va-badge--${prospekt.kalkyl.rekommenderadVA}`}>
            {vaNivaLabels[prospekt.kalkyl.rekommenderadVA]}
          </span>
        </p>
        
        <div class="va-nivaer">
          <div class={`va-niva ${prospekt.kalkyl.rekommenderadVA === 'sparsamt' ? 'va-niva--active' : ''}`}>
            <span class="va-niva-namn">Sparsamt</span>
            <span class="va-niva-kostnad">{formatTkr(prospekt.kalkyl.vaKostnadPerHh.sparsamt)}</span>
            <span class="va-niva-desc">Komposttoalett + BDT</span>
          </div>
          <div class={`va-niva ${prospekt.kalkyl.rekommenderadVA === 'bas' ? 'va-niva--active' : ''}`}>
            <span class="va-niva-namn">Bas</span>
            <span class="va-niva-kostnad">{formatTkr(prospekt.kalkyl.vaKostnadPerHh.bas)}</span>
            <span class="va-niva-desc">Markbädd/sandfilter</span>
          </div>
          <div class={`va-niva ${prospekt.kalkyl.rekommenderadVA === 'övre' ? 'va-niva--active' : ''}`}>
            <span class="va-niva-namn">Övre (sjönära)</span>
            <span class="va-niva-kostnad">{formatTkr(prospekt.kalkyl.vaKostnadPerHh.ovre)}</span>
            <span class="va-niva-desc">MRV + fosforfälla</span>
          </div>
        </div>

        {prospekt.kalkyl.noter && (
          <aside class="va-noter">
            <strong>VA-notering:</strong> {prospekt.kalkyl.noter}
          </aside>
        )}
      </div>

      <div class="totalt-kalkyl">
        <h3>Total uppskattad köpfas + VA</h3>
        <div class="totalt-row">
          <span>Kontantinsats (köpfas)</span>
          <span>{formatTkr(prospekt.kalkyl.kopfasPerHh)}</span>
        </div>
        <div class="totalt-row">
          <span>VA ({vaNivaLabels[prospekt.kalkyl.rekommenderadVA]})</span>
          <span>{formatTkr(prospekt.kalkyl.vaKostnadPerHh[prospekt.kalkyl.rekommenderadVA === 'övre' ? 'ovre' : prospekt.kalkyl.rekommenderadVA])}</span>
        </div>
        <div class="totalt-row totalt-row--sum">
          <span>Totalt per hushåll</span>
          <span>
            ~{prospekt.kalkyl.kopfasPerHh + prospekt.kalkyl.vaKostnadPerHh[prospekt.kalkyl.rekommenderadVA === 'övre' ? 'ovre' : prospekt.kalkyl.rekommenderadVA]} tkr
          </span>
        </div>
      </div>
    </section>

    <!-- Djupdyk -->
    <section class="doc-section" aria-labelledby="djupdyk-heading">
      <h2 id="djupdyk-heading" class="section-heading">Djupdyk</h2>
      {prospekt.djupdyk ? (
        <div class="djupdyk-content" set:html={prospekt.djupdyk.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>').replace(/\n/g, '<br/>')} />
      ) : (
        <div class="djupdyk-empty">
          <p>Ej djupdykt ännu.</p>
          <p class="muted-text">
            Lägg till djupdyksinformation genom att redigera 
            <code>src/data/prospects.ts</code> och uppdatera fältet <code>djupdyk</code> 
            för detta objekt.
          </p>
        </div>
      )}
    </section>

    <!-- Nästa steg -->
    <section class="doc-section" aria-labelledby="nasta-steg-heading">
      <h2 id="nasta-steg-heading" class="section-heading">Nästa steg</h2>
      {prospekt.nastaSteg.length > 0 ? (
        <ul class="nasta-steg-list">
          {prospekt.nastaSteg.map((steg) => (
            <li class={`nasta-steg ${steg.done ? 'nasta-steg--done' : ''}`}>
              <span class="steg-checkbox" aria-hidden="true">
                {steg.done ? '☑' : '☐'}
              </span>
              <span class="steg-text">{steg.text}</span>
            </li>
          ))}
        </ul>
      ) : (
        <p class="muted-text">Inga nästa steg definierade ännu.</p>
      )}
      <p class="steg-note">
        Uppdatera status genom att redigera <code>src/data/prospects.ts</code>.
      </p>
    </section>

    <!-- Disclaimer -->
    <aside class="disclaimer" aria-labelledby="disclaimer-heading">
      <h2 id="disclaimer-heading">Obs – internt planeringsunderlag</h2>
      <p>
        Detta är intern planering och inte juridisk eller ekonomisk rådgivning. 
        Siffrorna är uppskattningar för planering – bekräfta lagfart, pantbrev 
        och lånevillkor med bank och revisor innan föreningen lägger bud.
      </p>
    </aside>

    <nav class="doc-nav" aria-label="Navigering">
      <a href="/arbetsyta/mark/" class="btn btn-outline">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M19 12H5M12 19l-7-7 7-7"/>
        </svg>
        Tillbaka till shortlist
      </a>
      <a href="/arbetsyta/ekonomi/" class="btn btn-outline">
        Generella kalkyler →
      </a>
    </nav>
  </article>
</BaseLayout>

<style>
  .arbetsyta-doc {
    padding-block: var(--space-xl) var(--space-2xl);
    max-width: var(--max-width-prose);
  }

  .doc-header {
    margin-bottom: var(--space-xl);
    padding-bottom: var(--space-lg);
    border-bottom: 2px solid var(--border);
  }

  .breadcrumb {
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin-bottom: var(--space-sm);
  }

  .breadcrumb a {
    color: var(--text-muted);
  }

  .breadcrumb a:hover {
    color: var(--accent);
  }

  .doc-meta {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-sm);
    flex-wrap: wrap;
  }

  .status-badge,
  .kategori-badge {
    display: inline-block;
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    text-transform: uppercase;
  }

  .status-badge--ny {
    background: var(--accent-light);
    color: var(--deep-forest);
    border: 1px solid var(--accent-mid);
  }

  .status-badge--djupdyk {
    background: var(--coral-light);
    color: #7a3d20;
    border: 1px solid var(--coral);
  }

  .status-badge--andrahand,
  .status-badge--parkerad {
    background: var(--bg-secondary);
    color: var(--text-muted);
    border: 1px solid var(--border);
  }

  .kategori-badge--primär {
    background: var(--deep-forest);
    color: var(--text-on-dark);
  }

  .kategori-badge--sekundär {
    background: var(--bg-secondary);
    color: var(--text-muted);
    border: 1px solid var(--border);
  }

  h1 {
    font-size: var(--text-4xl);
    margin-bottom: var(--space-xs);
  }

  .doc-subtitle {
    font-size: var(--text-lg);
    color: var(--text-muted);
    margin: 0;
  }

  .section-heading {
    font-size: var(--text-2xl);
    color: var(--accent);
    margin-bottom: var(--space-md);
  }

  /* Fakta */
  .fakta-card {
    background: linear-gradient(135deg, var(--linen-cream) 0%, var(--surface-low) 100%);
    border: 2px solid var(--accent-mid);
    border-radius: var(--radius-xl);
    padding: var(--space-lg);
    margin-bottom: var(--space-xl);
  }

  .fakta-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: var(--space-md);
    margin: 0 0 var(--space-md);
  }

  .fakta-item {
    background: var(--bg-white);
    border-radius: var(--radius-md);
    padding: var(--space-sm);
  }

  .fakta-item--highlight {
    background: var(--deep-forest);
    color: var(--text-on-dark);
  }

  .fakta-item--warning {
    background: var(--coral-light);
    border: 1px solid var(--coral);
  }

  .fakta-item dt {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: var(--space-xs);
  }

  .fakta-item--highlight dt {
    color: var(--accent-mid);
  }

  .fakta-item dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--deep-forest);
  }

  .fakta-item--highlight dd {
    color: var(--text-on-dark);
  }

  .fakta-card .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  /* Flaggor */
  .flaggor-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .flagga {
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
    padding: var(--space-sm) var(--space-md);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
  }

  .flagga--info {
    background: var(--bg-secondary);
    border: 1px solid var(--border);
  }

  .flagga--varning {
    background: var(--coral-light);
    border: 1px solid var(--coral);
    color: #7a3d20;
  }

  .flagga--positiv {
    background: var(--accent-light);
    border: 1px solid var(--accent-mid);
    color: var(--deep-forest);
  }

  .flagga-icon {
    flex-shrink: 0;
    font-size: var(--text-base);
  }

  .flagga-text {
    flex: 1;
  }

  /* Kalkyl */
  .kalkyl-section {
    background: var(--surface-low);
    border-radius: var(--radius-xl);
    padding: var(--space-lg);
    margin-bottom: var(--space-xl);
  }

  .kalkyl-note {
    background: var(--bg-white);
    border-left: 4px solid var(--accent-mid);
    padding: var(--space-sm) var(--space-md);
    margin-bottom: var(--space-md);
    border-radius: var(--radius-md);
  }

  .kalkyl-note p {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .kalkyl-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
  }

  .kalkyl-card {
    background: var(--bg-white);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-md);
    text-align: center;
  }

  .kalkyl-card--primary {
    background: var(--deep-forest);
    border-color: var(--deep-forest);
    color: var(--text-on-dark);
  }

  .kalkyl-card--stress {
    background: var(--coral-light);
    border-color: var(--coral);
  }

  .kalkyl-card h3 {
    font-size: var(--text-sm);
    font-weight: 600;
    margin: 0 0 var(--space-xs);
    color: var(--text-muted);
  }

  .kalkyl-card--primary h3 {
    color: var(--accent-mid);
  }

  .kalkyl-card--stress h3 {
    color: #7a3d20;
  }

  .kalkyl-value {
    display: block;
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--deep-forest);
  }

  .kalkyl-card--primary .kalkyl-value {
    color: var(--text-on-dark);
  }

  .kalkyl-card--stress .kalkyl-value {
    color: var(--coral);
  }

  .kalkyl-label {
    display: block;
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin-top: var(--space-xs);
  }

  .kalkyl-card--primary .kalkyl-label {
    color: var(--accent-mid);
  }

  /* VA-kalkyl */
  .va-kalkyl {
    background: var(--bg-white);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-md);
    margin-bottom: var(--space-lg);
  }

  .va-kalkyl h3 {
    font-size: var(--text-lg);
    margin: 0 0 var(--space-sm);
    color: var(--deep-forest);
  }

  .va-rekommendation {
    font-size: var(--text-sm);
    margin-bottom: var(--space-md);
  }

  .va-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
  }

  .va-badge--sparsamt {
    background: var(--coral-light);
    color: #7a3d20;
  }

  .va-badge--bas {
    background: var(--accent-light);
    color: var(--deep-forest);
    border: 1px solid var(--accent-mid);
  }

  .va-badge--övre {
    background: #f5efe5;
    color: #5a4a3a;
    border: 1px solid #c1a88a;
  }

  .va-nivaer {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: var(--space-sm);
    margin-bottom: var(--space-md);
  }

  .va-niva {
    background: var(--surface-low);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: var(--space-sm);
    text-align: center;
    transition: border-color var(--transition), background var(--transition);
  }

  .va-niva--active {
    border-color: var(--accent-mid);
    border-width: 2px;
    background: var(--accent-light);
  }

  .va-niva-namn {
    display: block;
    font-weight: 600;
    color: var(--deep-forest);
    margin-bottom: var(--space-xs);
  }

  .va-niva-kostnad {
    display: block;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--coral);
  }

  .va-niva-desc {
    display: block;
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin-top: var(--space-xs);
  }

  .va-noter {
    background: var(--coral-light);
    border-left: 4px solid var(--coral);
    padding: var(--space-sm) var(--space-md);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    color: #7a3d20;
  }

  /* Totalt */
  .totalt-kalkyl {
    background: var(--linen-cream);
    border-radius: var(--radius-lg);
    padding: var(--space-md);
  }

  .totalt-kalkyl h3 {
    font-size: var(--text-base);
    margin: 0 0 var(--space-sm);
    color: var(--deep-forest);
  }

  .totalt-row {
    display: flex;
    justify-content: space-between;
    padding: var(--space-xs) var(--space-sm);
    font-size: var(--text-sm);
  }

  .totalt-row--sum {
    background: var(--deep-forest);
    color: var(--text-on-dark);
    border-radius: var(--radius-md);
    font-weight: 700;
    margin-top: var(--space-xs);
  }

  /* Doc sections */
  .doc-section {
    margin-bottom: var(--space-xl);
  }

  .muted-text {
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  /* Djupdyk */
  .djupdyk-content {
    background: var(--bg-white);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-md);
    font-size: var(--text-sm);
    line-height: 1.7;
    color: var(--text);
  }

  .djupdyk-empty {

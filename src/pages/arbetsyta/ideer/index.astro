---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { IDEER_SENAST_ANDRAD, formatDatumSvenska } from '../../../data/arbetsyta-metadata';

const metadata = {
  titel: 'Idébank',
  datum: IDEER_SENAST_ANDRAD,
  status: 'aktiv',
};

const ideer = [
  {
    titel: 'Ägarmodeller – tre alternativ',
    kategori: 'Organisation',
    ar: '0',
    risk: 'låg',
    beskrivning: 'Vi utforskar olika sätt att organisera ägande: klassisk EF, delat medlemskap (Grobund-inspiration), eller stiftelse. Se ekonomisidan för jämförelse.',
  },
  {
    titel: 'Bete & arrende',
    kategori: 'Intäkt',
    ar: '1',
    risk: 'låg',
    beskrivning: 'Arrendera betesmark till lokala djurhållare. Stabil inkomst med minimal insats.',
  },
  {
    titel: 'Workshops i naturbyggande',
    kategori: 'Intäkt & utbildning',
    ar: '0–1',
    risk: 'medel',
    beskrivning: 'Helgkurser i samma block som intern lärling: lera, timmer, VA/jordhus, odling, design. Illustrativt bas ~70 tkr omsättning år 0 (3 helger) / ~145 tkr år 1 (6 helger). Börja sparsamt, skala när boende och försäkring sitter. Flaskhals: handledartid, sedan gästboende/VA. Inte YH/CSN — föreningsintyg + portfolio.',
  },
  {
    titel: 'CSA-andelar (andelsodling)',
    kategori: 'Intäkt',
    ar: '1–2',
    risk: 'låg',
    beskrivning: 'Sälj säsongsandelar till grannar – förskottsbetalning minskar risk och skapar gemenskap.',
  },
  {
    titel: 'Ved & skogsbruk',
    kategori: 'Intäkt',
    ar: '1',
    risk: 'låg',
    beskrivning: 'Försäljning av ved, gallringsvirke och eventuell röjning på uppdrag.',
  },
  {
    titel: 'Gårdsbutik med lokala produkter',
    kategori: 'Intäkt',
    ar: '2',
    risk: 'medel',
    beskrivning: 'Honung, sylt, ägg och produkter från gården och grannar. Kräver tillstånd.',
  },
  {
    titel: 'Retreat & kontemplation',
    kategori: 'Intäkt & besökare',
    ar: '2–3',
    risk: 'medel',
    beskrivning: 'Enkel övernattning för den som vill ha tid i naturen. Låg investering i befintliga byggnader.',
  },
  {
    titel: 'Odlingslotter för närboende',
    kategori: 'Intäkt & gemenskap',
    ar: '1',
    risk: 'låg',
    beskrivning: 'Erbjud odlingslotter till grannar mot årsavgift. Skapar inkomst och lokal förankring.',
  },
];

interface Ide {
  titel: string;
  kategori: string;
  ar: string;
  risk: string;
  beskrivning: string;
}

function riskClass(risk: string) {
  const classes: Record<string, string> = {
    låg: 'risk--lag',
    medel: 'risk--medel',
    hög: 'risk--hog',
  };
  return classes[risk] || '';
}
---

<BaseLayout
  title="Idébank – Styrelsens arbetsyta"
  description="Intäktsidéer och verksamhetsplaner för föreningens gemensamma ekoby."
>
  <article class="arbetsyta-doc container">
    <header class="doc-header">
      <p class="breadcrumb">
        <a href="/arbetsyta/">Arbetsyta</a> / Idébank
      </p>
      <div class="doc-meta">
        <span class="doc-status doc-status--aktiv">Aktiv</span>
        <span class="doc-date">Uppdaterad {formatDatumSvenska(metadata.datum)}</span>
      </div>
      <h1>{metadata.titel}</h1>
      <p class="doc-lead">
        Idéer för hur ekobymarken kan bära sig själv genom verksamhet, 
        intäktskällor och lokal resiliens. Alla idéer är öppna för diskussion 
        och vidareutveckling.
      </p>
    </header>

    <section class="doc-section" aria-labelledby="principer">
      <h2 id="principer">Vägledande principer</h2>
      <ul>
        <li><strong>Småskalighet först:</strong> Börja enkelt, väx organiskt.</li>
        <li><strong>Platsbundenhet:</strong> Vad passar just denna mark, detta klimat?</li>
        <li><strong>Gemenskap:</strong> Aktiviteter som bjuder in grannar och besökare.</li>
        <li><strong>Resiliens:</strong> Flera ben att stå på minskar sårbarheten.</li>
      </ul>
    </section>

    <section class="doc-section" aria-labelledby="utbildning">
      <h2 id="utbildning">Utbildning & workshops</h2>
      <p>
        Föreningen planerar ett utbildningsspår med två delar: <strong>intern lärling</strong> 
        (längre praktik för medlemmar) och <strong>öppna workshops</strong> (helgkurser för 
        allmänheten). Båda följer samma block: lera, timmer, VA/jordhus, odling och design.
      </p>
      <ul>
        <li><strong>Illustrativa siffror:</strong> Bas ~70 tkr omsättning år 0 (3 helger), ~145 tkr år 1 (6 helger). Bidragsmarginal typiskt 65–75 % före handledarlön.</li>
        <li><strong>Flaskhalsar:</strong> Handledartid är begränsande — sedan gästboende, mat/kök och VA.</li>
        <li><strong>Partnerskap:</strong> Längre fram kan samarbete med folkhögskola eller PDC bli aktuellt, men inte i första steget.</li>
        <li><strong>Biljettförsäljning:</strong> Styrelsen beslutar om moms, försäkring och tillstånd innan kurser erbjuds externt.</li>
      </ul>
      <p>
        Utbildning är inte YH- eller CSN-godkänd — deltagare får istället föreningsintyg och 
        bygger på egen portfolio. Se <a href="/arbetsyta/ekonomi/">Ekonomi-sidan</a> för 
        detaljerade kalkyler.
      </p>
    </section>

    <section class="doc-section" aria-labelledby="ide-lista">
      <h2 id="ide-lista">Intäktsidéer för ekobymarken</h2>
      <p>
        Översikt över möjliga intäktskällor, sorterat efter tidslinje. 
        År 2–3 uppskattas bas till ca 450–750 tkr/år.
      </p>
      
      <div class="ide-table-wrapper">
        <table class="ide-table">
          <thead>
            <tr>
              <th scope="col">Verksamhet</th>
              <th scope="col">År</th>
              <th scope="col">Risk</th>
            </tr>
          </thead>
          <tbody>
            {ideer.map((ide: Ide) => (
              <tr>
                <td>
                  <strong>{ide.titel}</strong>
                  <span class="ide-desc">{ide.beskrivning}</span>
                </td>
                <td>{ide.ar}</td>
                <td><span class={`risk ${riskClass(ide.risk)}`}>{ide.risk}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="doc-section" aria-labelledby="fasning">
      <h2 id="fasning">Fasning</h2>
      <div class="phase-cards">
        <article class="phase-card">
          <span class="phase-label">År 0–1</span>
          <h3>Etablering</h3>
          <p>
            Fokus på lågriskaktiviteter: bete, ved, odlingslotter. 
            Workshops i naturbyggande kan starta sparsamt redan år 0 
            om handledare och försäkring finns på plats.
          </p>
        </article>
        <article class="phase-card">
          <span class="phase-label">År 2–3</span>
          <h3>Expansion</h3>
          <p>
            Fler kurser, gårdsbutik och eventuellt retreat när gruppen 
            hittat sin form och marken är känd.
          </p>
        </article>
      </div>
    </section>

    <section class="doc-section add-section" aria-labelledby="lagg-till">
      <h2 id="lagg-till">Har du en idé?</h2>
      <p>
        Idébanken utvecklas kontinuerligt efter styrelsemöten. Har du en idé 
        som passar ekobyn — kanske något du själv vill bidra med kunskap om? 
        <a href="/#anmalan">Skicka en intresseanmälan</a> och berätta vad 
        du tänker på.
      </p>
    </section>

    <nav class="doc-nav" aria-label="Navigering arbetsyta">
      <a href="/arbetsyta/" class="btn btn-outline">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M19 12H5M12 19l-7-7 7-7"/>
        </svg>
        Tillbaka till arbetsytan
      </a>
    </nav>
  </article>
</BaseLayout>

<style>
  .arbetsyta-doc {
    padding-block: var(--space-xl) var(--space-2xl);
    max-width: var(--max-width-prose);
  }

  .doc-header {
    margin-bottom: var(--space-xl);
    padding-bottom: var(--space-lg);
    border-bottom: 2px solid var(--border);
  }

  .breadcrumb {
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin-bottom: var(--space-sm);
  }

  .breadcrumb a {
    color: var(--text-muted);
  }

  .doc-meta {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-sm);
  }

  .doc-status {
    display: inline-block;
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    text-transform: uppercase;
  }

  .doc-status--aktiv {
    background: var(--accent-light);
    color: var(--deep-forest);
    border: 1px solid var(--accent-mid);
  }

  .doc-status--utkast {
    background: var(--coral-light);
    color: #7a3d20;
    border: 1px solid var(--coral);
  }

  .doc-date {
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  h1 {
    font-size: var(--text-4xl);
    margin-bottom: var(--space-sm);
  }

  .doc-lead {
    font-size: var(--text-lg);
    color: var(--text-muted);
    line-height: 1.6;
  }

  .doc-section {
    margin-bottom: var(--space-xl);
  }

  .doc-section h2 {
    font-size: var(--text-2xl);
    color: var(--accent);
    margin-bottom: var(--space-sm);
  }

  .doc-section p {
    color: var(--text);
    margin-bottom: var(--space-sm);
  }

  .doc-section > ul {
    padding-left: 1.5rem;
    color: var(--text);
    margin-bottom: var(--space-md);
  }

  .doc-section > ul li {
    margin-bottom: 0.5rem;
  }

  .doc-section code {
    background: var(--bg-secondary);
    padding: 0.15rem 0.4rem;
    border-radius: var(--radius-sm);
    font-size: 0.9em;
  }

  /* Idé table */
  .ide-table-wrapper {
    overflow-x: auto;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    margin-bottom: var(--space-md);
  }

  .ide-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  .ide-table th,
  .ide-table td {
    padding: var(--space-sm) var(--space-md);
    text-align: left;
    border-bottom: 1px solid var(--border);
    vertical-align: top;
  }

  .ide-table thead th {
    background: var(--bg-secondary);
    font-weight: 600;
    color: var(--text-muted);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .ide-table tbody tr:hover {
    background: var(--surface-low);
  }

  .ide-table td:first-child {
    min-width: 200px;
  }

  .ide-table td strong {
    display: block;
    color: var(--deep-forest);
    margin-bottom: 0.25rem;
  }

  .ide-desc {
    display: block;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .risk {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-sm);
    text-transform: capitalize;
    white-space: nowrap;
  }

  .risk--lag {
    background: var(--accent-light);
    color: var(--deep-forest);
  }

  .risk--medel {
    background: var(--coral-light);
    color: #7a3d20;
  }

  .risk--hog {
    background: #fecaca;
    color: #7f1d1d;
  }

  /* Phase cards */
  .phase-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-md);
  }

  .phase-card {
    background: var(--linen-cream);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-md);
  }

  .phase-label {
    display: inline-block;
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    background: var(--accent-light);
    color: var(--deep-forest);
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-xs);
  }

  .phase-card h3 {
    font-size: var(--text-lg);
    margin: 0 0 var(--space-xs);
  }

  .phase-card p {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .add-section {
    background: var(--bg-secondary);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
  }

  .add-section h2 {
    font-size: var(--text-xl);
  }

  .doc-nav {
    margin-top: var(--space-xl);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--border);
  }

  .doc-nav .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  @media (max-width: 600px) {
    h1 {
      font-size: var(--text-3xl);
    }

    .phase-cards {
      grid-template-columns: 1fr;
    }
  }
</style>

---
interface Props {
  heading?: string;
  intro?: string;
  defaultInterests?: string[];
}

const {
  heading = 'Anmäl ditt intresse',
  intro = 'Oavsett om du vill bli medlem, bo i en ekoby, stötta Olofs gård eller tipsa om mark – fyll i formuläret så hör vi av oss.',
  defaultInterests = [],
} = Astro.props;

const interestOptions = [
  {
    value: 'ekoby-boendegemenskap',
    title: 'Ekoby & Boendegemenskap',
    description: 'Jag vill bo eller investera i en ekoby',
  },
  {
    value: 'olof-larsson-gard',
    title: 'Olof Larssons Gård',
    description: 'Stödja eller arbeta i kulturarvsprojektet',
  },
  {
    value: 'allmant-medlemskap',
    title: 'Allmänt medlemskap / Stödmedlem',
    description: 'Medlemskap i En sund värld',
  },
  {
    value: 'tips-om-mark',
    title: 'Tips om mark',
    description: 'Fastighet till salu eller arrende',
  },
];
---

<section class="form-section" id="anmalan" aria-labelledby="form-heading">
  <div class="container">
    <div class="form-wrapper">
      <div class="form-intro">
        <h2 id="form-heading">{heading}</h2>
        <p>{intro}</p>
      </div>

      <div data-fs-success class="form-success" role="alert">
        <p><strong>Tack för din anmälan!</strong> Vi återkommer till dig så snart vi kan.</p>
      </div>
      <div data-fs-error class="form-error" role="alert"></div>

      <div class="form-card glass-card">
        <form id="interest-form" class="interest-form" novalidate>

          <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />

          <div class="form-row">
            <div class="field">
              <label for="name">Namn <span aria-hidden="true">*</span></label>
              <input
                type="text"
                id="name"
                name="name"
                required
                autocomplete="name"
                placeholder="Ditt för- och efternamn"
                data-fs-field
              />
              <span class="field-error" data-fs-error="name"></span>
            </div>

            <div class="field">
              <label for="email">E-post <span aria-hidden="true">*</span></label>
              <input
                type="email"
                id="email"
                name="email"
                required
                autocomplete="email"
                placeholder="din@epost.se"
                data-fs-field
              />
              <span class="field-error" data-fs-error="email"></span>
            </div>
          </div>

          <div class="field">
            <label for="phone">
              Telefon
              <span class="label-optional">(valfritt)</span>
            </label>
            <input
              type="tel"
              id="phone"
              name="phone"
              autocomplete="tel"
              placeholder="07x-xxx xx xx"
            />
          </div>

          <fieldset class="field interest-fieldset" id="interest-fieldset">
            <legend>
              Vad är du intresserad av? <span aria-hidden="true">*</span>
              <span class="fieldset-hint">Välj ett eller flera alternativ.</span>
            </legend>
            <div class="checkbox-group" role="group" aria-describedby="interest-error">
              {interestOptions.map((option) => (
                <label class="checkbox-label">
                  <input
                    type="checkbox"
                    name="interest"
                    value={option.value}
                    checked={defaultInterests.includes(option.value)}
                  />
                  <span>
                    <span class="checkbox-title">{option.title}</span>
                    <span class="checkbox-desc">{option.description}</span>
                  </span>
                </label>
              ))}
            </div>
            <span class="field-error" id="interest-error" role="alert"></span>
          </fieldset>

          <div class="field">
            <label for="message">
              Berätta lite om dig själv
              <span class="label-optional">(valfritt)</span>
            </label>
            <textarea
              id="message"
              name="message"
              rows="4"
              placeholder="Vad lockar dig? Har du mark, kompetens, erfarenhet eller hantverk att bidra med?"
              data-fs-field
            ></textarea>
            <span class="field-error" data-fs-error="message"></span>
          </div>

          <p class="form-consent">
            Dina uppgifter används enbart för att kontakta dig om föreningens
            projekt och raderas på begäran.
          </p>
          <button type="submit" class="btn btn-primary btn-block btn-large" data-fs-submit-btn>
            Skicka intresseanmälan
          </button>

        </form>
      </div>
    </div>
  </div>
</section>

<script>
  window.formspree = window.formspree || function () {
    (window.formspree.q = window.formspree.q || []).push(arguments);
  };
  window.formspree('initForm', {
    formElement: '#interest-form',
    formId: 'xbgjrqlz',
  });

  const form = document.getElementById('interest-form') as HTMLFormElement | null;
  const interestError = document.getElementById('interest-error');
  const fieldset = document.getElementById('interest-fieldset');

  function hasInterest(): boolean {
    if (!form) return false;
    return form.querySelectorAll('input[name="interest"]:checked').length > 0;
  }

  function showInterestError(show: boolean) {
    if (!interestError || !fieldset) return;
    interestError.textContent = show ? 'Välj minst ett område du är intresserad av.' : '';
    fieldset.toggleAttribute('data-invalid', show);
  }

  form?.addEventListener('change', (event) => {
    const target = event.target as HTMLElement;
    if (target instanceof HTMLInputElement && target.name === 'interest') {
      showInterestError(!hasInterest());
    }
  });

  form?.addEventListener('submit', (event) => {
    if (!hasInterest()) {
      event.preventDefault();
      event.stopImmediatePropagation();
      showInterestError(true);
      const first = form.querySelector<HTMLInputElement>('input[name="interest"]');
      first?.focus();
    }
  }, true);
</script>
<script src="https://unpkg.com/@formspree/ajax@1" defer></script>

<style>
  .form-section {
    background: var(--surface-low);
    padding-block: var(--space-section-mobile);
  }
  .form-wrapper {
    max-width: 800px;
    margin-inline: auto;
  }
  .form-intro {
    text-align: center;
    margin-bottom: var(--space-lg);
  }
  .form-intro h2 {
    font-size: var(--text-3xl);
    margin-bottom: var(--space-sm);
  }
  .form-intro p {
    color: var(--text-muted);
    font-size: var(--text-base);
    max-width: 36rem;
    margin-inline: auto;
    line-height: 1.6;
  }

  .form-success,
  .form-error {
    border-radius: var(--radius-md);
    padding: var(--space-md) var(--space-lg);
    margin-bottom: var(--space-md);
    text-align: center;
  }
  .form-success:empty,
  .form-error:empty { display: none; }
  .form-success { background: var(--accent-light); border: 1.5px solid var(--accent-mid); color: var(--deep-forest); }
  .form-success p { margin: 0; }
  .form-error { background: #fdf0f0; border: 1.5px solid #c0392b; color: #8b2020; }

  .form-card {
    border-radius: var(--radius-lg);
    padding: var(--space-md);
  }
  @media (min-width: 768px) {
    .form-section { padding-block: var(--space-section-desktop); }
    .form-card { padding: var(--space-xl); }
  }

  .interest-form { display: flex; flex-direction: column; gap: var(--space-md); }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-md); }

  .field { display: flex; flex-direction: column; gap: 0.4rem; }

  label, legend {
    font-weight: 600;
    font-size: var(--text-sm);
    color: var(--deep-forest);
  }
  .label-optional { font-weight: 400; color: var(--text-muted); }

  .interest-fieldset {
    border: none;
    border-bottom: 1px solid rgba(193, 200, 198, 0.3);
    padding: 0 0 var(--space-sm);
    margin: 0;
  }
  .interest-fieldset[data-invalid] legend { color: #8b2020; }
  legend {
    display: block;
    width: 100%;
    padding-bottom: var(--space-xs);
    margin-bottom: var(--space-sm);
  }
  .fieldset-hint {
    display: block;
    font-size: var(--text-sm);
    font-weight: 400;
    color: var(--text-muted);
    margin-top: 0.25rem;
  }

  .checkbox-group { display: flex; flex-direction: column; gap: 0.85rem; }
  .checkbox-label {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-weight: 400;
    cursor: pointer;
  }
  .checkbox-label input {
    width: 1.25rem;
    height: 1.25rem;
    margin-top: 0.15rem;
    accent-color: var(--coral);
    flex-shrink: 0;
    border-radius: var(--radius-sm);
  }
  .checkbox-label input:focus-visible {
    outline: 2px solid var(--coral);
    outline-offset: 2px;
  }
  .checkbox-title {
    display: block;
    font-weight: 600;
    font-size: var(--text-sm);
    color: var(--deep-forest);
    line-height: 1.35;
    transition: color var(--transition);
  }
  .checkbox-label:hover .checkbox-title { color: var(--coral); }
  .checkbox-desc {
    display: block;
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  input[type="text"],
  input[type="email"],
  input[type="tel"],
  textarea {
    width: 100%;
    padding: 0.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    font-family: var(--font-base);
    font-size: var(--text-base);
    color: var(--text);
    background: var(--linen-cream);
    transition: border-color var(--transition);
  }
  input:focus, textarea:focus {
    outline: none;
    border-color: var(--deep-forest);
  }
  input[aria-invalid="true"],
  textarea[aria-invalid="true"] {
    border-color: #c0392b;
  }
  textarea { resize: vertical; }

  .field-error { font-size: var(--text-sm); color: #8b2020; min-height: 1.2em; }

  .form-consent {
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin: 0;
    text-align: center;
  }

  .btn-large { padding: 1rem 2rem; font-size: var(--text-sm); }
  .btn-large:disabled { opacity: 0.6; cursor: not-allowed; }

  @media (max-width: 600px) {
    .form-row { grid-template-columns: 1fr; }
  }
</style>

---
interface Props {
  heading?: string;
  intro?: string;
  defaultInterests?: string[];
}

const {
  heading = 'Anmäl ditt intresse',
  intro = 'Oavsett om du vill bli medlem, bo i en ekoby, stötta Olofs gård eller tipsa om mark – fyll i formuläret så hör vi av oss.',
  defaultInterests = [],
} = Astro.props;

const interestOptions = [
  {
    value: 'ekoby-boendegemenskap',
    title: 'Ekoby & Boendegemenskap',
    description: 'Jag vill bo eller investera i en ekoby',
  },
  {
    value: 'olof-larsson-gard',
    title: 'Olof Larssons Gård',
    description: 'Stödja eller arbeta i kulturarvsprojektet',
  },
  {
    value: 'allmant-medlemskap',
    title: 'Allmänt medlemskap / Stödmedlem',
    description: 'Medlemskap i En sund värld',
  },
  {
    value: 'tips-om-mark',
    title: 'Tips om mark',
    description: 'Fastighet till salu eller arrende',
  },
];
---

<section class="form-section" id="anmalan" aria-labelledby="form-heading">
  <div class="container">
    <div class="form-wrapper">
      <div class="form-intro">
        <h2 id="form-heading">{heading}</h2>
        <p>{intro}</p>
      </div>

      <div data-fs-success class="form-success" role="alert">
        <p><strong>Tack för din anmälan!</strong> Vi återkommer till dig så snart vi kan.</p>
      </div>
      <div data-fs-error class="form-error" role="alert"></div>

      <form id="interest-form" class="interest-form" novalidate>

        <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />

        <div class="form-row">
          <div class="field">
            <label for="name">Namn <span aria-hidden="true">*</span></label>
            <input
              type="text"
              id="name"
              name="name"
              required
              autocomplete="name"
              placeholder="Ditt för- och efternamn"
              data-fs-field
            />
            <span class="field-error" data-fs-error="name"></span>
          </div>

          <div class="field">
            <label for="email">E-post <span aria-hidden="true">*</span></label>
            <input
              type="email"
              id="email"
              name="email"
              required
              autocomplete="email"
              placeholder="din@epost.se"
              data-fs-field
            />
            <span class="field-error" data-fs-error="email"></span>
          </div>
        </div>

        <div class="field">
          <label for="phone">
            Telefon
            <span class="label-optional">(valfritt)</span>
          </label>
          <input
            type="tel"
            id="phone"
            name="phone"
            autocomplete="tel"
            placeholder="07x-xxx xx xx"
          />
        </div>

        <fieldset class="field" id="interest-fieldset">
          <legend>Vad är du intresserad av? <span aria-hidden="true">*</span></legend>
          <p class="fieldset-hint" id="interest-hint">Välj ett eller flera alternativ.</p>
          <div class="checkbox-group" role="group" aria-describedby="interest-hint interest-error">
            {interestOptions.map((option) => (
              <label class="checkbox-label">
                <input
                  type="checkbox"
                  name="interest"
                  value={option.value}
                  checked={defaultInterests.includes(option.value)}
                />
                <span>
                  <span class="checkbox-title">{option.title}</span>
                  <span class="checkbox-desc">{option.description}</span>
                </span>
              </label>
            ))}
          </div>
          <span class="field-error" id="interest-error" role="alert"></span>
        </fieldset>

        <div class="field">
          <label for="message">
            Berätta lite om dig själv
            <span class="label-optional">(valfritt)</span>
          </label>
          <textarea
            id="message"
            name="message"
            rows="5"
            placeholder="Vad lockar dig? Har du mark, kompetens, erfarenhet eller hantverk att bidra med?"
            data-fs-field
          ></textarea>
          <span class="field-error" data-fs-error="message"></span>
        </div>

        <div class="form-footer">
          <p class="form-consent">
            Dina uppgifter används enbart för att kontakta dig om föreningens
            projekt och raderas på begäran.
          </p>
          <button type="submit" class="btn btn-primary btn-large" data-fs-submit-btn>
            Skicka intresseanmälan
          </button>
        </div>

      </form>
    </div>
  </div>
</section>

<script>
  window.formspree = window.formspree || function () {
    (window.formspree.q = window.formspree.q || []).push(arguments);
  };
  window.formspree('initForm', {
    formElement: '#interest-form',
    formId: 'xbgjrqlz',
  });

  const form = document.getElementById('interest-form') as HTMLFormElement | null;
  const interestError = document.getElementById('interest-error');
  const fieldset = document.getElementById('interest-fieldset');

  function hasInterest(): boolean {
    if (!form) return false;
    return form.querySelectorAll('input[name="interest"]:checked').length > 0;
  }

  function showInterestError(show: boolean) {
    if (!interestError || !fieldset) return;
    interestError.textContent = show ? 'Välj minst ett område du är intresserad av.' : '';
    fieldset.toggleAttribute('data-invalid', show);
  }

  form?.addEventListener('change', (event) => {
    const target = event.target as HTMLElement;
    if (target instanceof HTMLInputElement && target.name === 'interest') {
      showInterestError(!hasInterest());
    }
  });

  form?.addEventListener('submit', (event) => {
    if (!hasInterest()) {
      event.preventDefault();
      event.stopImmediatePropagation();
      showInterestError(true);
      const first = form.querySelector<HTMLInputElement>('input[name="interest"]');
      first?.focus();
    }
  }, true);
</script>
<script src="https://unpkg.com/@formspree/ajax@1" defer></script>

<style>
  .form-section {
    background: var(--earth-light);
    padding-block: var(--space-2xl);
  }
  .form-wrapper {
    max-width: 760px;
    margin-inline: auto;
  }
  .form-intro {
    text-align: center;
    margin-bottom: var(--space-xl);
  }
  .form-intro h2 { font-size: var(--text-4xl); margin-bottom: var(--space-sm); }
  .form-intro p { color: var(--text-muted); font-size: var(--text-lg); max-width: 560px; margin-inline: auto; }

  .form-success,
  .form-error {
    border-radius: var(--radius-md);
    padding: var(--space-md) var(--space-lg);
    margin-bottom: var(--space-md);
    text-align: center;
  }
  .form-success:empty,
  .form-error:empty { display: none; }
  .form-success { background: var(--accent-light); border: 1.5px solid var(--accent); color: var(--accent-hover); }
  .form-success p { margin: 0; }
  .form-error { background: #fdf0f0; border: 1.5px solid #c0392b; color: #8b2020; }

  .interest-form {
    background: #fff;
    padding: var(--space-xl);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
  }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-md); }

  .field { display: flex; flex-direction: column; gap: 0.4rem; margin-bottom: var(--space-md); }

  label { font-weight: 600; font-size: var(--text-sm); color: var(--text); }
  .label-optional { font-weight: 400; color: var(--text-muted); }

  fieldset {
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: var(--space-sm) var(--space-md);
    margin: 0 0 var(--space-md);
  }
  fieldset[data-invalid] {
    border-color: #c0392b;
    box-shadow: 0 0 0 3px rgba(192, 57, 43, 0.12);
  }
  legend { font-weight: 600; font-size: var(--text-sm); padding-inline: 0.25rem; color: var(--text); }
  .fieldset-hint {
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin: 0 0 var(--space-xs);
    font-weight: 400;
  }

  .checkbox-group { display: flex; flex-direction: column; gap: 0.85rem; margin-top: var(--space-xs); }
  .checkbox-label {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    font-weight: 400;
    font-size: var(--text-base);
    cursor: pointer;
  }
  .checkbox-label input {
    width: 1.1rem;
    height: 1.1rem;
    margin-top: 0.2rem;
    accent-color: var(--accent);
    flex-shrink: 0;
  }
  .checkbox-label input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .checkbox-title { display: block; font-weight: 600; color: var(--text); line-height: 1.35; }
  .checkbox-desc { display: block; font-size: var(--text-sm); color: var(--text-muted); }

  input[type="text"],
  input[type="email"],
  input[type="tel"],
  textarea {
    width: 100%;
    padding: 0.65rem 0.9rem;
    border: 1.5px solid var(--border);
    border-radius: var(--radius-md);
    font-family: var(--font-base);
    font-size: var(--text-base);
    color: var(--text);
    background: var(--bg);
    transition: border-color var(--transition), box-shadow var(--transition);
  }
  input:focus, textarea:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(26, 122, 114, 0.15);
  }
  input[aria-invalid="true"],
  textarea[aria-invalid="true"] {
    border-color: #c0392b;
    box-shadow: 0 0 0 3px rgba(192, 57, 43, 0.12);
  }
  textarea { resize: vertical; }

  .field-error { font-size: var(--text-sm); color: #8b2020; min-height: 1.2em; }

  .form-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    flex-wrap: wrap;
    margin-top: var(--space-sm);
  }
  .form-consent { font-size: var(--text-sm); color: var(--text-muted); margin: 0; flex: 1; }

  .btn-large { padding: 0.85rem 2.25rem; font-size: var(--text-lg); white-space: nowrap; }
  .btn-large:disabled { opacity: 0.6; cursor: not-allowed; }

  @media (max-width: 600px) {
    .form-row { grid-template-columns: 1fr; }
    .interest-form { padding: var(--space-md); }
    .form-footer { flex-direction: column; align-items: stretch; }
    .btn-large { text-align: center; }
  }
</style>

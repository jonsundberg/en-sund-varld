---
interface Props {
  name:
    | 'leaf'
    | 'people'
    | 'house'
    | 'bird'
    | 'barn'
    | 'wheat'
    | 'sprout'
    | 'scroll'
    | 'ballot'
    | 'hammer'
    | 'columns'
    | 'saw'
    | 'heart'
    | 'megaphone'
    | 'tent'
    | 'log'
    | 'tractor'
    | 'tools'
    | 'ladder';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}

const { name, size = 'sm', class: className } = Astro.props;
const sizes = { sm: 22, md: 26, lg: 32 };
const dim = sizes[size];
---

<span class:list={['line-icon', className]} aria-hidden="true">
  <svg
    width={dim}
    height={dim}
    viewBox="0 0 24 24"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    {name === 'leaf' && (
      <>
        <path d="M11 21c-1.2-3.2.8-7.5 5.5-9.5C15 6 11.5 4 7 5.5 4.5 10 6 16 11 21Z" />
        <path d="M11 21c0-5 3-8 8.5-10" />
      </>
    )}
    {name === 'people' && (
      <>
        <circle cx="8.5" cy="7" r="2.2" />
        <circle cx="15.5" cy="7" r="2.2" />
        <path d="M3.6 18.5c.4-3.4 2.4-5.4 4.9-5.4 1.6 0 2.9.8 3.7 2" />
        <path d="M20.4 18.5c-.4-3.4-2.4-5.4-4.9-5.4-1.6 0-2.9.8-3.7 2" />
      </>
    )}
    {name === 'house' && (
      <>
        <path d="M3 10.5 12 3l9 7.5" />
        <path d="M5.5 9.8V21h13V9.8" />
        <path d="M10 21v-6h4v6" />
      </>
    )}
    {name === 'bird' && (
      <>
        <path d="M4 13.5c4.5 0 7.2-2.8 8.2-7.5 1.2 3 4 5.5 9.3 6.5-3.8 1.5-5.8 4.2-5.8 7.5" />
        <path d="M12.2 6c-1.2 2.8-3.8 4.6-7.4 5.4" />
      </>
    )}
    {name === 'barn' && (
      <>
        <path d="M3 11 12 3.5 21 11" />
        <path d="M5 10.8V21h14V10.8" />
        <path d="M9.5 21v-7h5v7" />
        <path d="M9.5 14 12 17l2.5-3" />
      </>
    )}
    {name === 'wheat' && (
      <>
        <path d="M12 22V4" />
        <path d="M12 7C9.4 5.6 7.2 6.2 6.4 8.4 8.6 8.8 10.5 8.2 12 7Z" />
        <path d="M12 7c2.6-1.4 4.8-.8 5.6 1.4-2.2.4-4.1-.2-5.6-1.4Z" />
        <path d="M12 12c-2.6-1.4-4.8-.8-5.6 1.4 2.2.4 4.1-.2 5.6-1.4Z" />
        <path d="M12 12c2.6-1.4 4.8-.8 5.6 1.4-2.2.4-4.1-.2-5.6-1.4Z" />
        <path d="M12 17c-2.2-1.2-4-.6-4.7 1.2 1.8.4 3.4-.2 4.7-1.2Z" />
        <path d="M12 17c2.2-1.2 4-.6 4.7 1.2-1.8.4-3.4-.2-4.7-1.2Z" />
      </>
    )}
    {name === 'sprout' && (
      <>
        <path d="M12 21V11" />
        <path d="M12 11C9 10 6.5 6.8 6.5 3.8 10.5 3.8 12 7.2 12 11Z" />
        <path d="M12 12c3-1 5.5-4.2 5.5-7.2C13.5 4.8 12 8.2 12 12Z" />
        <path d="M5 21h14" />
      </>
    )}
    {name === 'scroll' && (
      <>
        <path d="M6 5.2c0-1.2.9-2.2 2.1-2.2H20v13.2a2 2 0 0 1-2 2H8" />
        <path d="M6 5.2v11.8A2.2 2.2 0 0 1 3.8 19.2 2.2 2.2 0 0 1 1.6 17 2.2 2.2 0 0 1 3.8 14.8H18" />
        <path d="M9 8h6.5M9 11h5.5M9 14h4" />
      </>
    )}
    {name === 'ballot' && (
      <>
        <path d="M4 10h16v10H4V10Z" />
        <path d="M4 10 12 4.5 20 10" />
        <path d="M9 15.5h6" />
        <path d="M12 2.5v9" />
        <path d="M10 5 12 2.5 14 5" />
      </>
    )}
    {name === 'hammer' && (
      <>
        <path d="M14.5 11.5 21 5" />
        <path d="M11.5 14.5 4 22" />
        <path d="M14 3.5 20.5 10l-4 4-6.5-6.5 4-4Z" />
      </>
    )}
    {name === 'columns' && (
      <>
        <path d="M4 21h16" />
        <path d="M5 8h14" />
        <path d="M8 8v13" />
        <path d="M16 8v13" />
        <path d="M6.5 8 12 3.5 17.5 8" />
      </>
    )}
    {name === 'saw' && (
      <>
        <path d="M3 20.5 13.5 6.5l4.5 4.5L7.5 21H3v-.5Z" />
        <path d="M13.5 6.5 16 4l4.5 4.5-2.5 2.5" />
        <path d="M6.2 17.2l1.3 1.3M8.4 14.6l1.3 1.3M10.6 12l1.3 1.3" />
      </>
    )}
    {name === 'heart' && (
      <path d="M12 20s-7-4.4-7-9.2C5 8 7 6 9.2 6c1.3 0 2.4.6 2.8 1.6C12.4 6.6 13.5 6 14.8 6 17 6 19 8 19 10.8 19 15.6 12 20 12 20Z" />
    )}
    {name === 'megaphone' && (
      <>
        <path d="M4 10.5v3c0 .8.7 1.5 1.5 1.5H8l7 4.2V5.8L8 10H5.5C4.7 10 4 10.7 4 11.5Z" />
        <path d="M16.8 8.2a3.6 3.6 0 0 1 0 7.6" />
        <path d="M8 15.2 7 20h3l1.2-4.2" />
      </>
    )}
    {name === 'tent' && (
      <>
        <path d="M3 20 12 4l9 16" />
        <path d="M12 4v16" />
        <path d="M7.5 20 12 12l4.5 8" />
      </>
    )}
    {name === 'log' && (
      <>
        <ellipse cx="6.5" cy="12" rx="3.2" ry="5" />
        <path d="M6.5 7h10.2c1.8 0 3.3 2.2 3.3 5s-1.5 5-3.3 5H6.5" />
        <path d="M6.5 12h13.5" />
      </>
    )}
    {name === 'tractor' && (
      <>
        <circle cx="7" cy="17" r="3" />
        <circle cx="18" cy="18" r="2.2" />
        <path d="M4 17H3v-5.5h8.5L14 7h4.5v8" />
        <path d="M11.5 11.5V17" />
      </>
    )}
    {name === 'tools' && (
      <>
        <path d="M14.7 6.3a3.4 3.4 0 0 0-4.8 4.8l-6.4 6.4a1.7 1.7 0 0 0 2.4 2.4l6.4-6.4a3.4 3.4 0 0 0 4.8-4.8l-2.2 2.2-2.4-2.4 2.2-2.2Z" />
        <path d="M14.5 14.5 20 20" />
      </>
    )}
    {name === 'ladder' && (
      <>
        <path d="M8 3v18" />
        <path d="M16 3v18" />
        <path d="M8 7h8M8 11h8M8 15h8M8 19h8" />
      </>
    )}
  </svg>
</span>

<style>
  .line-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--earth);
    flex-shrink: 0;
    line-height: 0;
  }

  .line-icon svg {
    display: block;
  }
</style>

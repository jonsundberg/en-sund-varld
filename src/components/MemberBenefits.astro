---
import LineIcon from './LineIcon.astro';

const benefits = [
  {
    title: 'Medäganderätt',
    body: 'Som insatsbetalande medlem är du delägare i föreningens tillgångar och mark.',
    icon: 'scroll',
  },
  {
    title: 'Demokratiskt inflytande',
    body: 'En röst per medlem på stämman. Du är med och fattar besluten.',
    icon: 'ballot',
  },
  {
    title: 'Nyttjanderätt till mark',
    body: 'Tillgång att bruka och bo på föreningens mark på gemensamma villkor.',
    icon: 'sprout',
  },
  {
    title: 'Gemenskap',
    body: 'Bli del av ett nätverk av likasinnade som delar kunskap, arbete och resurser.',
    icon: 'people',
  },
] as const;
---

<section class="why-section" aria-labelledby="why-heading">
  <div class="container">
    <header class="section-header section-header--centered">
      <p class="section-label">Varför gå med?</p>
      <h2 id="why-heading">Vad du får som medlem</h2>
    </header>
    <ul class="why-grid" role="list">
      {benefits.map((item) => (
        <li class="why-item">
          <span class="why-icon"><LineIcon name={item.icon} size="lg" /></span>
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .section-label {
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: var(--space-xs);
  }
  .section-header { margin-bottom: var(--space-lg); }
  .section-header h2 {
    font-size: var(--text-3xl);
    margin-bottom: var(--space-xs);
    letter-spacing: -0.01em;
  }
  .section-header--centered { text-align: center; }

  .why-section {
    padding-block: var(--space-section-mobile);
    background: var(--bg);
  }
  @media (min-width: 768px) {
    .why-section { padding-block: var(--space-section-desktop); }
  }

  .why-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-md);
  }

  .why-item {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: var(--space-md);
    border-radius: var(--radius-lg);
    background: var(--linen-cream);
    border: 1px solid transparent;
    box-shadow: var(--shadow-sm);
    transition: border-color var(--transition);
  }
  .why-item:hover { border-color: var(--accent); }

  .why-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border-radius: 999px;
    background: var(--bg-secondary);
    margin-bottom: var(--space-sm);
  }

  .why-item h3 {
    font-family: var(--font-base);
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--deep-forest);
    margin-bottom: var(--space-xs);
  }

  .why-item p {
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin: 0;
    line-height: 1.6;
  }

  @media (max-width: 900px) {
    .why-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 600px) {
    .why-grid { grid-template-columns: 1fr; }
  }
</style>

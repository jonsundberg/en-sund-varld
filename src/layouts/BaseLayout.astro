---
import '../styles/tokens.css';
import LogoMark from '../components/LogoMark.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'En sund värld – vi vårdar jorden och bygger hållbara livsmiljöer',
  description = 'Ekonomisk förening för permakultur, ekobyar och gemensam markförvaltning. Gå med och bygg något långsiktigt.',
} = Astro.props;

const currentPath = Astro.url.pathname;

const siteUrl = Astro.site?.origin ?? 'https://en-sund-varld.se';
const canonicalUrl = new URL(currentPath, siteUrl).href;
const ogImage = new URL('/og-image.jpeg', siteUrl).href;

const navLinks = [
  { href: '/',                      label: 'Hem',                      icon: 'home' },
  { href: '/projekt/olof-larsson',  label: 'Olof Larssons Gård',      icon: 'barn' },
  { href: '/projekt/ekoby',         label: 'Ekoby & Boendegemenskap', icon: 'people' },
  { href: '/stadgar',               label: 'Stadgar',                  icon: 'scroll' },
  { href: '/#anmalan',              label: 'Anmäl intresse',           icon: 'heart' },
];

function isNavActive(href: string): boolean {
  if (href === '/') return currentPath === '/';
  if (href.startsWith('/#')) return false;
  return currentPath === href || currentPath.startsWith(`${href}/`);
}
---

<!DOCTYPE html>
<html lang="sv">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="theme-color" content="#1d3a37" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} – En sund värld`} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Solstrålar genom skog och ormbunkar – En sund värld Ekonomisk Förening" />
    <meta property="og:locale" content="sv_SE" />
    <meta property="og:site_name" content="En sund värld" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} – En sund värld`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Playfair+Display:wght@600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <a href="#main" class="skip-link">Hoppa till innehåll</a>

    <header class="site-header">
      <div class="header-inner">
        <a href="/" class="site-logo" aria-label="En sund värld – startsida">
          <LogoMark />
          <span class="logo-text">En sund värld</span>
        </a>

        <nav id="main-nav" class="header-nav" aria-label="Huvudmeny">
          <ul>
            {navLinks.map(({ href, label }) => {
              const active = isNavActive(href);
              return (
                <li>
                  <a
                    href={href}
                    aria-current={active ? 'page' : undefined}
                  >
                    {label}
                  </a>
                </li>
              );
            })}
          </ul>
        </nav>

        <button
          class="nav-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="nav-drawer"
          aria-label="Öppna meny"
        >
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16" />
          </svg>
        </button>
      </div>
    </header>

    <div class="drawer-overlay" id="drawer-overlay" hidden aria-hidden="true"></div>

    <nav
      id="nav-drawer"
      class="nav-drawer"
      aria-label="Huvudmeny"
      aria-hidden="true"
    >
      <div class="drawer-header">
        <h2 class="drawer-title">Meny</h2>
        <button type="button" class="drawer-close" aria-label="Stäng meny">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M6 6l12 12M18 6L6 18" />
          </svg>
        </button>
      </div>

      <ul class="drawer-links">
        {navLinks.map(({ href, label, icon }) => {
          const active = isNavActive(href);
          return (
            <li>
              <a
                href={href}
                class:list={['drawer-link', { 'drawer-link--active': active }]}
                aria-current={active ? 'page' : undefined}
              >
                <span class="drawer-link-icon" aria-hidden="true">
                  {icon === 'home' && (
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10.5 12 3l9 7.5"/><path d="M5.5 9.8V21h13V9.8"/><path d="M10 21v-6h4v6"/></svg>
                  )}
                  {icon === 'barn' && (
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11 12 3.5 21 11"/><path d="M5 10.8V21h14V10.8"/><path d="M9.5 21v-7h5v7"/></svg>
                  )}
                  {icon === 'people' && (
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="8.5" cy="7" r="2.2"/><circle cx="15.5" cy="7" r="2.2"/><path d="M3.6 18.5c.4-3.4 2.4-5.4 4.9-5.4 1.6 0 2.9.8 3.7 2"/><path d="M20.4 18.5c-.4-3.4-2.4-5.4-4.9-5.4-1.6 0-2.9.8-3.7 2"/></svg>
                  )}
                  {icon === 'scroll' && (
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 5.2c0-1.2.9-2.2 2.1-2.2H20v13.2a2 2 0 0 1-2 2H8"/><path d="M6 5.2v11.8A2.2 2.2 0 0 1 3.8 19.2 2.2 2.2 0 0 1 1.6 17 2.2 2.2 0 0 1 3.8 14.8H18"/></svg>
                  )}
                  {icon === 'heart' && (
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20s-7-4.4-7-9.2C5 8 7 6 9.2 6c1.3 0 2.4.6 2.8 1.6C12.4 6.6 13.5 6 14.8 6 17 6 19 8 19 10.8 19 15.6 12 20 12 20Z"/></svg>
                  )}
                </span>
                <span>{label}</span>
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-brand">
        <a href="/" class="footer-logo" aria-label="En sund värld – startsida">
          <LogoMark />
          <span>
            <span class="footer-name">En sund värld</span>
            <span class="footer-tagline">Ekonomisk Förening</span>
          </span>
        </a>
      </div>

      <nav aria-label="Sidfotslänkar" class="footer-nav">
        <ul>
          <li><a href="/" aria-current={currentPath === '/' ? 'page' : undefined}>Hem</a></li>
          <li><a href="/projekt/olof-larsson">Olof Larssons Gård</a></li>
          <li><a href="/projekt/ekoby">Ekoby &amp; Boendegemenskap</a></li>
          <li><a href="/stadgar">Stadgar</a></li>
          <li><a href="/#anmalan">Anmäl intresse</a></li>
        </ul>
      </nav>

      <div class="footer-contact">
        <p>
          Frågor eller funderingar? Kontakta oss via
          <a href="/#anmalan">intresseanmälan</a>.
        </p>
        <p class="footer-copy">&copy; {new Date().getFullYear()} En sund värld Ekonomisk Förening</p>
      </div>
    </footer>

    <script>
      const toggle = document.querySelector('.nav-toggle') as HTMLButtonElement | null;
      const closeBtn = document.querySelector('.drawer-close') as HTMLButtonElement | null;
      const drawer = document.getElementById('nav-drawer');
      const overlay = document.getElementById('drawer-overlay');

      function setDrawerOpen(open: boolean) {
        toggle?.setAttribute('aria-expanded', String(open));
        drawer?.setAttribute('aria-hidden', String(!open));
        drawer?.classList.toggle('open', open);
        overlay?.classList.toggle('open', open);
        if (overlay) overlay.hidden = !open;
        document.body.classList.toggle('drawer-open', open);
      }

      toggle?.addEventListener('click', () => {
        const isOpen = toggle.getAttribute('aria-expanded') === 'true';
        setDrawerOpen(!isOpen);
      });
      closeBtn?.addEventListener('click', () => setDrawerOpen(false));
      overlay?.addEventListener('click', () => setDrawerOpen(false));
      drawer?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => setDrawerOpen(false));
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') setDrawerOpen(false);
      });

      window.matchMedia('(min-width: 900px)').addEventListener('change', (e) => {
        if (e.matches) setDrawerOpen(false);
      });
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: -48px;
    left: var(--space-sm);
    background: var(--deep-forest);
    color: #fff;
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius-sm);
    text-decoration: none;
    font-weight: 600;
    z-index: 9999;
    transition: top var(--transition);
  }
  .skip-link:focus { top: var(--space-sm); }

  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: rgba(254, 249, 237, 0.9);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(193, 200, 198, 0.3);
    box-shadow: var(--shadow-sm);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding: 0.75rem var(--space-md);
    max-width: var(--max-width);
    margin-inline: auto;
  }

  .site-logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--deep-forest);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    flex-shrink: 0;
    border-radius: var(--radius-sm);
  }
  .site-logo :global(.logo-mark) {
    width: 2.5rem;
    height: 2.5rem;
  }
  .site-logo:hover { color: var(--deep-forest); }
  .site-logo:focus-visible {
    outline: 2px solid var(--deep-forest);
    outline-offset: 3px;
  }

  .header-nav { display: none; }
  .header-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
  }
  .header-nav a {
    text-decoration: none;
    color: var(--text-muted);
    font-weight: 600;
    font-size: var(--text-sm);
    padding: 0.25rem 0;
    border-bottom: 2px solid transparent;
    transition: color var(--transition), border-color var(--transition);
    white-space: nowrap;
  }
  .header-nav a:hover {
    color: var(--deep-forest);
    border-bottom-color: var(--coral);
  }
  .header-nav a[aria-current="page"] {
    color: var(--deep-forest);
    border-bottom-color: var(--coral);
  }

  .nav-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    border-radius: 999px;
    color: var(--deep-forest);
    transition: background var(--transition);
  }
  .nav-toggle:hover { background: var(--linen-cream); }
  .nav-toggle:focus-visible {
    outline: 2px solid var(--deep-forest);
    outline-offset: 2px;
  }

  .drawer-overlay {
    position: fixed;
    inset: 0;
    z-index: 110;
    background: rgba(0, 0, 0, 0.5);
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }
  .drawer-overlay.open {
    opacity: 1;
    pointer-events: auto;
  }

  .nav-drawer {
    position: fixed;
    top: 0;
    right: 0;
    z-index: 120;
    width: min(20rem, 85vw);
    height: 100%;
    background: var(--bg);
    box-shadow: var(--shadow-md);
    transform: translateX(100%);
    transition: transform 0.3s ease;
    display: flex;
    flex-direction: column;
    padding: var(--space-md);
    gap: var(--space-sm);
  }
  .nav-drawer.open { transform: translateX(0); }

  .drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-sm);
  }
  .drawer-title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--deep-forest);
    margin: 0;
  }
  .drawer-close {
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    border-radius: 999px;
    color: var(--deep-forest);
    transition: background var(--transition);
  }
  .drawer-close:hover { background: var(--bg-secondary); }
  .drawer-close:focus-visible {
    outline: 2px solid var(--deep-forest);
    outline-offset: 2px;
  }

  .drawer-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .drawer-link {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: 0.85rem var(--space-sm);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: var(--text-muted);
    font-weight: 600;
    font-size: var(--text-sm);
    transition: background var(--transition), color var(--transition);
  }
  .drawer-link:hover {
    background: var(--bg-secondary);
    color: var(--deep-forest);
  }
  .drawer-link--active {
    background: var(--coral-hover);
    color: #752d00;
  }
  .drawer-link-icon {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  :global(body.drawer-open) { overflow: hidden; }

  #main {
    padding-top: var(--header-height);
  }

  /* Fullbredd-hero: dra upp så bilden möter headern utan glipa */
  #main > :first-child.hero,
  #main > :first-child.projekt-page:has(.projekt-hero-img) {
    margin-top: calc(-1 * var(--header-height));
  }

  .site-footer {
    background: var(--bg-dark);
    color: var(--text-on-dark);
    padding: var(--space-xl) var(--space-md);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-lg);
  }
  .footer-logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: inherit;
    border-radius: var(--radius-sm);
  }
  .footer-logo :global(.logo-mark) {
    width: 3rem;
    height: 3rem;
    color: var(--accent-mid);
  }
  .footer-logo > span {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    text-align: left;
  }
  .footer-logo:focus-visible {
    outline: 2px solid var(--accent-mid);
    outline-offset: 3px;
  }
  .footer-name {
    display: block;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--text-on-dark);
    line-height: 1.15;
  }
  .footer-tagline {
    display: block;
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.8);
    margin: 0;
  }
  .footer-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-sm) var(--space-md);
  }
  .footer-nav a {
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.05em;
    transition: color var(--transition);
  }
  .footer-nav a[aria-current="page"] {
    color: var(--coral);
    text-decoration: underline;
  }
  .footer-nav a:hover { color: var(--text-on-dark); }
  .footer-contact {
    font-size: var(--text-base);
    color: rgba(255, 255, 255, 0.8);
    max-width: 36rem;
  }
  .footer-contact p { margin: 0 0 0.5rem; }
  .footer-contact a {
    color: var(--coral);
    text-decoration: underline;
  }
  .footer-contact a:hover { color: var(--text-on-dark); }
  .footer-copy {
    font-size: var(--text-sm);
    opacity: 0.6;
    margin-top: var(--space-sm) !important;
  }

  @media (min-width: 900px) {
    .header-inner {
      gap: var(--space-lg);
    }
    .header-nav {
      display: block;
      flex: 1;
    }
    .nav-toggle,
    .nav-drawer,
    .drawer-overlay {
      display: none !important;
    }
  }

  @media print {
    .skip-link,
    .site-header,
    .site-footer,
    .nav-drawer,
    .drawer-overlay,
    .no-print {
      display: none !important;
    }
    body {
      background: #fff;
      color: #1d1c15;
      font-size: 11pt;
      line-height: 1.5;
    }
    #main { padding-top: 0; display: block; }
    a { color: inherit; text-decoration: none; }
  }
</style>
